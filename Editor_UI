-- ===== ESTADO DO EDITOR =====
local mode = nil -- "fechar" | "editar" | "fixar" | nil
local targetLevel = 1 -- 1 item, 2 grupo, 3 raiz
local LEVEL_NAMES = { "item", "grupo", "raiz" }
local selected, selW, selH = nil, 0, 0

local HINTS = {
	none = "Escolha uma ação: fechar, editar ou fixar.",
	fechar = "Toque num frame para excluir. Dá para desfazer ou restaurar depois.",
	editar = "Toque num frame e segure os botões para mudar o tamanho.",
	fixar = "Toque num frame para fixar a posição. Toque de novo para soltar.",
}

-- o objeto tem algo visível? (para não pegar frames invisíveis que só agrupam)
local function hasContent(o)
	if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
		return o.BackgroundTransparency < 1 or o.Text ~= ""
	end
	if o:IsA("ImageLabel") or o:IsA("ImageButton") then
		return o.BackgroundTransparency < 1 or (o.Image ~= "" and o.ImageTransparency < 1)
	end
	if o:IsA("Frame") or o:IsA("ScrollingFrame") then
		return o.BackgroundTransparency < 1
	end
	return true
end

-- qual frame está sob o dedo (respeitando o "alvo")
local function pickAt(pos)
	local list = playerGui:GetGuiObjectsAtPosition(pos.X, pos.Y)
	local first, best
	for _, o in ipairs(list) do
		if not o:IsDescendantOf(gui) and o.Visible then
			first = first or o
			if hasContent(o) then
				best = o
				break
			end
		end
	end
	local obj = best or first
	if not obj then return nil end
	if targetLevel == 2 then
		if obj.Parent and obj.Parent:IsA("GuiObject") then obj = obj.Parent end
	elseif targetLevel == 3 then
		while obj.Parent and obj.Parent:IsA("GuiObject") do obj = obj.Parent end
	end
	return obj
end

local function selectObj(o)
	selected = o
	if o then
		selW, selH = o.AbsoluteSize.X, o.AbsoluteSize.Y
		showBox(o, C.blue)
	else
		hideBox()
	end
end

local function resizeSelected(dw, dh)
	local o = selected
	if not o or not o.Parent then return end
	selW = math.max(MIN_SIZE, selW + dw)
	selH = math.max(MIN_SIZE, selH + dh)
	resizeTo(o, selW, selH)
end

-- botão que repete enquanto o dedo está nele (e para ao soltar em qualquer lugar)
local holdStops = {}
keep(UIS.InputEnded:Connect(function(input)
	if not isPress(input) then return end
	for _, stop in ipairs(holdStops) do stop() end
	persist()
end))

local function holdRepeat(btn, step)
	local token = 0
	table.insert(holdStops, function() token += 1 end)
	btn.face.InputBegan:Connect(function(input)
		if not isPress(input) then return end
		token += 1
		local my = token
		task.spawn(function()
			local t0 = os.clock()
			while token == my do
				step((os.clock() - t0) > 0.8 and 3 or 1)
				task.wait(0.03)
			end
		end)
	end)
end

-- pisca a caixa de destaque no objeto
local function flash(obj, color)
	showBox(obj, color)
	task.delay(0.28, function()
		if boxTarget == obj and selected ~= obj then hideBox() end
	end)
end

local function describe(obj)
	return obj.Name .. " (" .. obj.ClassName .. ")"
end

local function handleTap(pos)
	if not mode then return end
	local obj = pickAt(pos)
	if not obj then
		toast("Nada encontrado aí.")
		return
	end
	if mode == "fechar" then
		flash(obj, C.red)
		local key = deleteObj(obj)
		toast("Excluído: " .. describe(obj), "desfazer", function()
			restoreKey(key)
		end)
	elseif mode == "editar" then
		selectObj(obj)
		toast("Selecionado: " .. describe(obj))
	elseif mode == "fixar" then
		local locked = toggleLock(obj)
		flash(obj, locked and C.amber or C.green)
		toast((locked and "Fixado: " or "Solto: ") .. describe(obj))
	end
end

-- toques na camada de captura
local tapStart = nil
capture.InputBegan:Connect(function(input)
	if isPress(input) then
		tapStart = Vector2.new(input.Position.X, input.Position.Y)
	end
end)
capture.InputEnded:Connect(function(input)
	if not tapStart or not isPress(input) then return end
	local s = tapStart
	tapStart = nil
	local e = Vector2.new(input.Position.X, input.Position.Y)
	if (e - s).Magnitude <= 12 then
		handleTap(s) -- só toque parado conta (arrastar não faz nada)
	end
end)

