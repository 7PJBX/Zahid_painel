local function screenPos(obj)
	local abs = obj.AbsolutePosition
	if convA then return abs end
	local sg = obj:FindFirstAncestorWhichIsA("ScreenGui")
	if sg and sg.IgnoreGuiInset then return abs end
	return abs + inset
end

