-- texto de cada item da lista
local function entryInfo(key, rec)
	local segs = string.split(key, "|")
	local last = segs[#segs] or key
	local class, name = string.match(last, "^([^:]+):(.*)#%d+$")
	local label = (name or last) .. " (" .. (class or "?") .. ")"
	local flags = {}
	if rec.deleted then table.insert(flags, "excluído") end
	if rec.size then table.insert(flags, "tamanho") end
	if rec.locked then table.insert(flags, "fixado") end
	local text = table.concat(flags, ", ")
	if resolve(key) == nil then text = text .. " - fora da tela" end
	return label, text
end

local function rebuildRestoreList()
	for _, c in ipairs(restoreList:GetChildren()) do
		if c:IsA("Frame") or c:IsA("TextLabel") then c:Destroy() end
	end
	local keys = {}
	for key in pairs(saved) do table.insert(keys, key) end
	table.sort(keys)

	if #keys == 0 then
		local empty = Instance.new("TextLabel")
		empty.BackgroundTransparency = 1
		empty.Font = FONT
		empty.TextSize = 13
		empty.TextColor3 = C.textDim
		empty.Text = "Nada para restaurar."
		empty.Size = UDim2.new(1, 0, 0, 30)
		empty.Parent = restoreList
		return
	end

	for i, key in ipairs(keys) do
		local label, flags = entryInfo(key, saved[key])

		local row = Instance.new("Frame")
		row.BackgroundColor3 = C.row
		row.BorderSizePixel = 0
		row.Size = UDim2.new(1, 0, 0, 48)
		row.LayoutOrder = i
		row.Parent = restoreList
		Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

		local nameLabel = Instance.new("TextLabel")
		nameLabel.BackgroundTransparency = 1
		nameLabel.Font = FONT
		nameLabel.TextSize = 13
		nameLabel.TextColor3 = C.text
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
		nameLabel.Text = label
		nameLabel.Position = UDim2.fromOffset(8, 5)
		nameLabel.Size = UDim2.new(1, -108, 0, 20)
		nameLabel.Parent = row

		local flagLabel = Instance.new("TextLabel")
		flagLabel.BackgroundTransparency = 1
		flagLabel.Font = FONT
		flagLabel.TextSize = 11
		flagLabel.TextColor3 = C.textDim
		flagLabel.TextXAlignment = Enum.TextXAlignment.Left
		flagLabel.TextTruncate = Enum.TextTruncate.AtEnd
		flagLabel.Text = flags
		flagLabel.Position = UDim2.fromOffset(8, 26)
		flagLabel.Size = UDim2.new(1, -108, 0, 16)
		flagLabel.Parent = row

		local b = new3D(row, "restaurar", UDim2.fromOffset(88, 34), C.faceOff, C.baseOff)
		b.face.TextSize = 12
		b.holder.AnchorPoint = Vector2.new(1, 0.5)
		b.holder.Position = UDim2.new(1, -6, 0.5, 0)
		b.face.Activated:Connect(function()
			restoreKey(key)
			rebuildRestoreList()
			toast("Restaurado: " .. label)
		end)
	end
end

