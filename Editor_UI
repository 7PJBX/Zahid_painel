	local probeGui = Instance.new("ScreenGui")
	probeGui.Name = "EditorUI_probe"
	probeGui.IgnoreGuiInset = false
	probeGui.ResetOnSpawn = false
	probeGui.Parent = playerGui
	local probe = Instance.new("Frame")
	probe.Size = UDim2.fromOffset(1, 1)
	probe.BackgroundTransparency = 1
	probe.Parent = probeGui
	RunService.RenderStepped:Wait()
	RunService.RenderStepped:Wait()
	convA = inset.Y > 0 and math.abs(probe.AbsolutePosition.Y - inset.Y) < 1
	probeGui:Destroy()
