-- ===== DADOS (edições salvas) =====
local function udimToTable(u)
	return { xs = u.X.Scale, xo = u.X.Offset, ys = u.Y.Scale, yo = u.Y.Offset }
end

local function tableToUdim(t)
	return UDim2.new(t.xs, t.xo, t.ys, t.yo)
end

-- saved[chave] = { orig = { visible, size }, deleted, size, locked, pos }
local saved = {}
local persistQueued = false

local function persistNow()
	persistQueued = false
	if not canFile then return end
	pcall(function()
		writefile(FILE, HttpService:JSONEncode({ version = 1, items = saved }))
	end)
end

-- junta várias mudanças seguidas num único salvamento
local function persist()
	if persistQueued then return end
	persistQueued = true
	task.delay(0.4, persistNow)
end

if canFile then
	local ok, data = pcall(function()
		if not isfile(FILE) then return nil end
		return HttpService:JSONDecode(readfile(FILE))
	end)
	if ok and type(data) == "table" and type(data.items) == "table" then
		for key, rec in pairs(data.items) do
			if type(key) == "string" and type(rec) == "table" then
				saved[key] = rec
			end
		end
	end
end

-- chave estável de um objeto: caminho de "Classe:Nome#posição entre iguais" a partir do PlayerGui
local function keyOf(obj)
	local parts = {}
	local cur = obj
	while cur and cur ~= playerGui do
		local idx, n = 1, 0
		local parent = cur.Parent
		if parent then
			for _, sib in ipairs(parent:GetChildren()) do
				if sib.Name == cur.Name and sib.ClassName == cur.ClassName then
					n += 1
					if sib == cur then idx = n end
				end
			end
		end
		table.insert(parts, 1, cur.ClassName .. ":" .. cur.Name .. "#" .. idx)
		cur = parent
	end
	return table.concat(parts, "|")
end

-- acha de novo o objeto a partir da chave (nil se não estiver na tela)
local function resolve(key)
	local cur = playerGui
	for seg in string.gmatch(key, "[^|]+") do
		local class, name, idx = string.match(seg, "^([^:]+):(.*)#(%d+)$")
		if not class then return nil end
		idx = tonumber(idx)
		local n, found = 0, nil
		for _, child in ipairs(cur:GetChildren()) do
			if child.Name == name and child.ClassName == class then
				n += 1
				if n == idx then
					found = child
					break
				end
			end
		end
		if not found then return nil end
		cur = found
	end
	if cur == playerGui then return nil end
	return cur
end

-- objetos que estou vigiando: se o script dono mexer, eu desfaço
local tracked = {} -- [obj] = { key, conns, applying }

local function enforce(obj)
	local t = tracked[obj]
	local rec = t and saved[t.key]
	if not rec then return end
	t.applying = true
	if rec.deleted and obj.Visible then
		obj.Visible = false
	end
	if rec.size then
		local s = tableToUdim(rec.size)
		if obj.Size ~= s then obj.Size = s end
	end
	if rec.locked and rec.pos then
		local p = tableToUdim(rec.pos)
		if obj.Position ~= p then obj.Position = p end
	end
	t.applying = false
end

local function untrack(obj)
	local t = tracked[obj]
	if not t then return end
	for _, c in ipairs(t.conns) do c:Disconnect() end
	tracked[obj] = nil
end

local function track(obj, key)
	local t = tracked[obj]
	if t then
		t.key = key
	else
		t = { key = key, conns = {}, applying = false }
		tracked[obj] = t
		for _, prop in ipairs({ "Visible", "Size", "Position" }) do
			table.insert(t.conns, obj:GetPropertyChangedSignal(prop):Connect(function()
				if not t.applying then enforce(obj) end
			end))
		end
		table.insert(t.conns, obj.Destroying:Connect(function()
			untrack(obj)
		end))
	end
	enforce(obj)
end

-- cria (ou pega) o registro do objeto, guardando como ele era antes da primeira edição
local function ensureRec(obj)
	local key = keyOf(obj)
	local rec = saved[key]
	if not rec then
		rec = { orig = { visible = obj.Visible, size = udimToTable(obj.Size) } }
		saved[key] = rec
	end
	return key, rec
end

local function pruneIfEmpty(key, obj)
	local rec = saved[key]
	if rec and not rec.deleted and not rec.size and not rec.locked then
		saved[key] = nil
		if obj then untrack(obj) end
	end
end

local function deleteObj(obj)
	local key, rec = ensureRec(obj)
	rec.deleted = true
	track(obj, key)
	persist()
	return key
end

local function resizeTo(obj, w, h)
	local key, rec = ensureRec(obj)
	rec.size = udimToTable(UDim2.fromOffset(w, h))
	track(obj, key)
	persist()
end

-- fixa ou solta a posição; devolve true se ficou fixado
local function toggleLock(obj)
	local key, rec = ensureRec(obj)
	if rec.locked then
		rec.locked = nil
		rec.pos = nil
		pruneIfEmpty(key, obj)
		persist()
		return false
	end
	rec.locked = true
	rec.pos = udimToTable(obj.Position)
	track(obj, key)
	persist()
	return true
end

-- devolve o objeto ao original e apaga o registro
local function restoreKey(key)
	local rec = saved[key]
	if not rec then return end
	local obj = resolve(key)
	if obj then
		untrack(obj)
		if rec.orig then
			if rec.deleted then obj.Visible = rec.orig.visible ~= false end
			if rec.size and rec.orig.size then obj.Size = tableToUdim(rec.orig.size) end
		end
	end
	saved[key] = nil
	persist()
end

-- reaplica tudo que foi salvo nos objetos que estão na tela; devolve quantos achou
local function applySaved()
	local n = 0
	for key in pairs(saved) do
		local obj = resolve(key)
		if obj and obj:IsA("GuiObject") then
			track(obj, key)
			n += 1
		end
	end
	return n
end

-- ===== INTERFACE =====
local function tween(obj, time, props, style, dir)
	local t = TweenService:Create(
		obj,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

-- botão 3D: corpo escuro parado e face clara que desce ao apertar
local pressedFaces = {}
keep(UIS.InputEnded:Connect(function(input)
	if not isPress(input) then return end
	for face in pairs(pressedFaces) do
		pressedFaces[face] = nil
		if face.Parent then
			tween(face, 0.14, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
		end
	end
end))

local function new3D(parent, text, size, faceColor, baseColor)
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Size = size
	holder.Parent = parent

	local faceH = size.Y.Offset - DEPTH

	local base = Instance.new("Frame")
	base.Size = UDim2.new(1, 0, 0, faceH)
	base.Position = UDim2.fromOffset(0, DEPTH)
	base.BackgroundColor3 = baseColor
	base.BorderSizePixel = 0
	base.Parent = holder
	Instance.new("UICorner", base).CornerRadius = UDim.new(0, 8)

	local face = Instance.new("TextButton")
	face.Size = UDim2.new(1, 0, 0, faceH)
	face.BackgroundColor3 = faceColor
	face.BorderSizePixel = 0
	face.AutoButtonColor = false
	face.Font = FONT
	face.TextColor3 = C.text
	face.TextSize = 14
	face.TextTruncate = Enum.TextTruncate.AtEnd
	face.Text = text
	face.Parent = holder
	Instance.new("UICorner", face).CornerRadius = UDim.new(0, 8)

	face.InputBegan:Connect(function(input)
		if isPress(input) then
			pressedFaces[face] = true
			tween(face, 0.06, { Position = UDim2.fromOffset(0, DEPTH) })
		end
	end)

	local obj = { holder = holder, base = base, face = face }

	function obj.setOn(on)
		tween(face, 0.18, {
			BackgroundColor3 = on and C.faceOn or faceColor,
			TextColor3 = on and C.textOn or C.text,
		})
		tween(base, 0.18, { BackgroundColor3 = on and C.baseOn or baseColor })
	end

	return obj
end

