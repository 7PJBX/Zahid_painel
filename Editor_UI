-- limita uma posição aos limites da tela
local function boundsFor(x, y)
	local s = gui.AbsoluteSize
	local w, h = gear.AbsoluteSize.X, gear.AbsoluteSize.Y
	return math.clamp(x, 0, math.max(0, s.X - w)), math.clamp(y, 0, math.max(0, s.Y - h))
end

-- se estiver fora da borda, puxa de volta com efeito mola
local function springIntoBounds()
	local px, py = gear.Position.X.Offset, gear.Position.Y.Offset
	local cx, cy = boundsFor(px, py)
	if cx ~= px or cy ~= py then
		tween(gear, 0.6, { Position = UDim2.fromOffset(cx, cy) }, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
	end
end

local panelOpen = false

local function placePanel()
	local s = gui.AbsoluteSize
	local gp, gs = gear.AbsolutePosition, gear.AbsoluteSize
	local pw = PANEL_W
	local ph = panelList.AbsoluteContentSize.Y + 16
	local x = math.clamp(gp.X, 8, math.max(8, s.X - pw - 8))
	local y = gp.Y + gs.Y + 6
	if y + ph > s.Y - 8 then
		y = math.max(8, gp.Y - ph - 6)
	end
	panel.Position = UDim2.fromOffset(x, y)
end

-- o painel acompanha a engrenagem (inclusive durante a mola)
keep(RunService.RenderStepped:Connect(function()
	if panelOpen then placePanel() end
end))

local function openPanel()
	panelOpen = true
	panel.Visible = true
	placePanel()
	panelScale.Scale = 0.85
	tween(panelScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	-- toda vez que abre: reaplica as exclusões e edições salvas nos frames que estão na tela
	local n = applySaved()
	if n > 0 then toast("Edições aplicadas: " .. n) end
end

local function closePanel()
	panelOpen = false
	setMode(nil)
	popup.Visible = false
	local t = tween(panelScale, 0.15, { Scale = 0.85 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	t.Completed:Connect(function()
		if not panelOpen then panel.Visible = false end
	end)
end

closeBtn.face.Activated:Connect(closePanel)

local dragging, moved = false, false
local dragInput, dragStart, startPos = nil, nil, nil

gear.InputBegan:Connect(function(input)
	if isPress(input) then
		dragging, moved = true, false
		dragInput = input
		dragStart = Vector2.new(input.Position.X, input.Position.Y)
		startPos = Vector2.new(gear.Position.X.Offset, gear.Position.Y.Offset)
	end
end)

keep(UIS.InputChanged:Connect(function(input)
	if not dragging then return end
	if input.UserInputType ~= Enum.UserInputType.MouseMovement and input ~= dragInput then return end
	local d = Vector2.new(input.Position.X, input.Position.Y) - dragStart
	if d.Magnitude > 6 then moved = true end
	if not moved then return end
	local raw = startPos + d
	local cx, cy = boundsFor(raw.X, raw.Y)
	-- passou da borda: anda só uma parte (resistência de elástico)
	local ox = math.clamp((raw.X - cx) * 0.35, -60, 60)
	local oy = math.clamp((raw.Y - cy) * 0.35, -60, 60)
	gear.Position = UDim2.fromOffset(cx + ox, cy + oy)
end))

keep(UIS.InputEnded:Connect(function(input)
	if not dragging or not isPress(input) then return end
	dragging = false
	if moved then
		springIntoBounds() -- soltou fora da borda: volta com efeito mola
	else
		if panelOpen then closePanel() else openPanel() end
	end
end))

-- se o tamanho da tela mudar (ex.: girar o celular), a engrenagem volta para dentro
keep(gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(springIntoBounds))

