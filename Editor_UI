shared.__EditorUI_cleanup = function()
	for _, c in ipairs(conns) do
		pcall(function() c:Disconnect() end)
	end
	local list = {}
	for obj in pairs(tracked) do table.insert(list, obj) end
	for _, obj in ipairs(list) do untrack(obj) end
	gui:Destroy()
end

