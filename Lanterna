-- ===== FECHAR TUDO =====
local renderConn
local function closeAll()
	if closed then return end
	closed = true
	if renderConn then renderConn:Disconnect() end
	for _, c in ipairs(uiConns) do pcall(function() c:Disconnect() end) end
	src:Destroy() -- leva a luz e o feixe junto
	tip:Destroy()
	gui:Destroy()
	env.FakeLightOff = nil
end
env.FakeLightOff = closeAll

-- ===== GESTOS DO BOTÃO =====
local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local active = nil -- { input, t0, sp, bx, by, moved }

btn.InputBegan:Connect(function(input)
	if not isPress(input) or active then return end
	active = {
		input = input,
		t0 = os.clock(),
		sp = Vector2.new(input.Position.X, input.Position.Y),
		bx = cfg.bx,
		by = cfg.by,
		moved = false,
	}
end)

table.insert(uiConns, UIS.InputChanged:Connect(function(input)
	local a = active
	if not a or cfg.locked then return end -- fixo: não move
	local ok = input.UserInputType == Enum.UserInputType.MouseMovement
		or (input.UserInputType == Enum.UserInputType.Touch and input == a.input)
	if not ok then return end
	local d = Vector2.new(input.Position.X, input.Position.Y) - a.sp
	if not a.moved and d.Magnitude > 10 then
		a.moved = true
		hint.Visible = false
	end
	if a.moved then
		cfg.bx, cfg.by = a.bx + d.X, a.by + d.Y
		clampBtn()
	end
end))

table.insert(uiConns, UIS.InputEnded:Connect(function(input)
	local a = active
	if not a then return end
	local same = input == a.input
		or (input.UserInputType == Enum.UserInputType.MouseButton1 and a.input.UserInputType == Enum.UserInputType.MouseButton1)
	if not same then return end
	active = nil
	hint.Visible = false
	if a.moved then return end -- foi arrastar
	local e = os.clock() - a.t0
	if e < 1 then
		setLight(not on)
	elseif e < 3 then
		cfg.locked = not cfg.locked
		paintButton()
		play(cfg.locked and sndOn or sndOff)
		flashHint(cfg.locked and "Botão fixo" or "Botão solto: pode mover")
	elseif e < 7 then
		openMenu(not menu.Visible)
	end
end))

-- ===== ATUALIZA A LUZ E O QUE APARECE ENQUANTO SEGURA =====
renderConn = RunService.RenderStepped:Connect(function()
	local a = active
	if a and not a.moved then
		local e = os.clock() - a.t0
		if e >= 7 then
			active = nil
			closeAll()
			return
		elseif e >= 3 then
			hint.Text = "Solte: configurações  (7s: fechar)"
			hint.Visible = true
		elseif e >= 1 then
			hint.Text = cfg.locked and "Solte: destravar" or "Solte: fixar"
			hint.Visible = true
		end
	end

	if not on then return end
	local cam = workspace.CurrentCamera
	if not cam then return end
	local o = (cam.CFrame * CFrame.new(cfg.ox, cfg.oy, -1.5)).Position
	local look = cam.CFrame.LookVector
	local dist = math.min(cfg.range, 60)
	local filter = { src, tip }
	if lp.Character then filter[3] = lp.Character end
	rp.FilterDescendantsInstances = filter
	local hit = workspace:Raycast(o, look * dist, rp)
	src.CFrame = CFrame.lookAt(o, o + look)
	tip.Position = hit and hit.Position or (o + look * dist)
end)
