local function addSlider(label, min, max, key, decimals)
	order += 1
	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, 48)
	row.LayoutOrder = order
	row.Parent = list

	local lbl = Instance.new("TextLabel")
	lbl.BackgroundTransparency = 1
	lbl.Size = UDim2.new(1, 0, 0, 18)
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Font = Enum.Font.GothamMedium
	lbl.TextSize = 13
	lbl.TextColor3 = Color3.fromRGB(225, 225, 232)
	lbl.Parent = row

	local track = Instance.new("Frame")
	track.Position = UDim2.new(0, 8, 0, 32)
	track.Size = UDim2.new(1, -16, 0, 6)
	track.BackgroundColor3 = Color3.fromRGB(52, 52, 60)
	track.BorderSizePixel = 0
	track.Parent = row
	Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = Color3.fromRGB(255, 236, 170)
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromScale(0, 1)
	fill.Parent = track
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

	local knob = Instance.new("Frame")
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Size = UDim2.fromOffset(18, 18)
	knob.BackgroundColor3 = Color3.fromRGB(235, 235, 240)
	knob.BorderSizePixel = 0
	knob.Parent = track
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local hit = Instance.new("TextButton") -- área de toque maior
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.Position = UDim2.new(0, 0, 0, 18)
	hit.Size = UDim2.new(1, 0, 0, 30)
	hit.Parent = row

	local function fmt(v)
		if decimals > 0 then return string.format("%." .. decimals .. "f", v) end
		return tostring(math.floor(v + 0.5))
	end
	local function refresh()
		local a = math.clamp((cfg[key] - min) / (max - min), 0, 1)
		fill.Size = UDim2.fromScale(a, 1)
		knob.Position = UDim2.new(a, 0, 0.5, 0)
		lbl.Text = label .. ": " .. fmt(cfg[key])
	end
	table.insert(refreshers, refresh)

	local dragging = false
	local function setFromX(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
		local step = 10 ^ -decimals
		cfg[key] = math.floor((min + a * (max - min)) / step + 0.5) * step
		refresh()
		applyLight()
	end
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging, sliderDrag = true, true
			list.ScrollingEnabled = false -- arrastar o controle não rola o menu
			setFromX(input.Position.X)
		end
	end)
	table.insert(uiConns, UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end))
	table.insert(uiConns, UIS.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch) then
			dragging, sliderDrag = false, false
			list.ScrollingEnabled = true
		end
	end))
	refresh()
end

