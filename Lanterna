local lp = Players.LocalPlayer
local env = (getgenv and getgenv()) or _G

if env.FakeLightOff then pcall(env.FakeLightOff) end

-- ===== PRESET =====
local FILE = "FakeLight_preset.json"
local hasFS = type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
local DEFAULT = { range = 60, brightness = 6, angle = 55, ox = 1.2, oy = -1, bx = 12, by = 160, locked = false }
local cfg = {}
for k, v in pairs(DEFAULT) do cfg[k] = v end

do
	local data
	if hasFS then
		local ok, d = pcall(function()
			if isfile(FILE) then return HttpService:JSONDecode(readfile(FILE)) end
			return nil
		end)
		if ok and type(d) == "table" then data = d end
	end
	if not data and type(env.FakeLightPreset) == "table" then data = env.FakeLightPreset end
	if data then
		for k, v in pairs(DEFAULT) do
			if type(data[k]) == type(v) then cfg[k] = data[k] end
		end
	end
end

local function savePreset()
	local copy = {}
	for k in pairs(DEFAULT) do copy[k] = cfg[k] end
	env.FakeLightPreset = copy
	if hasFS then
		local ok = pcall(function() writefile(FILE, HttpService:JSONEncode(copy)) end)
		return ok and "Preset salvo!" or "Falhou ao salvar"
	end
	return "Salvo só até fechar o jogo (sem writefile)"
end

-- ===== LUZ =====
local function mkPart(name)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.Parent = workspace
	return p
end

local src, tip = mkPart("FakeLightSrc"), mkPart("FakeLightTip")

local spot = Instance.new("SpotLight")
spot.Face = Enum.NormalId.Front
spot.Shadows = false
spot.Color = Color3.fromRGB(255, 244, 214)
spot.Parent = src

local glow = Instance.new("PointLight")
glow.Shadows = false
glow.Color = spot.Color
glow.Parent = src

local a0 = Instance.new("Attachment", src)
local a1 = Instance.new("Attachment", tip)
local beam = Instance.new("Beam")
beam.Attachment0, beam.Attachment1 = a0, a1
beam.Width0 = 0.15
beam.Transparency = NumberSequence.new(0.88, 1)
beam.LightEmission = 1
beam.Color = ColorSequence.new(spot.Color)
beam.FaceCamera = true
beam.Parent = src

local function applyLight()
	spot.Range = cfg.range
	spot.Brightness = cfg.brightness
	spot.Angle = cfg.angle
	glow.Range = math.max(6, cfg.range * 0.25)
	glow.Brightness = math.max(0.4, cfg.brightness * 0.2)
	local len = math.min(cfg.range, 60)
	beam.Width1 = math.max(1, 2 * math.tan(math.rad(cfg.angle / 2)) * len * 0.6)
end
applyLight()

local rp = RaycastParams.new()
rp.FilterType = Enum.RaycastFilterType.Exclude

