local function paintButton()
	btn.BackgroundColor3 = on and COL_ON or COL_OFF
	btn.TextColor3 = on and TXT_ON or TXT_OFF
	stroke.Color = cfg.locked and Color3.fromRGB(255, 190, 70) or Color3.fromRGB(120, 120, 130)
end

local function setLight(v, silent)
	on = v
	spot.Enabled, glow.Enabled, beam.Enabled = v, v, v
	paintButton()
	if not silent then play(v and sndOn or sndOff) end
end

local hintToken = 0
local function flashHint(text)
	hintToken += 1
	local my = hintToken
	hint.Text = text
	hint.Visible = true
	task.delay(1.2, function()
		if hintToken == my then hint.Visible = false end
	end)
end

local function clampBtn()
	local s, b = gui.AbsoluteSize, btn.AbsoluteSize
	cfg.bx = math.clamp(cfg.bx, 0, math.max(0, s.X - b.X))
	cfg.by = math.clamp(cfg.by, 0, math.max(0, s.Y - b.Y))
	btn.Position = UDim2.fromOffset(cfg.bx, cfg.by)
end
btn.Position = UDim2.fromOffset(cfg.bx, cfg.by)
task.defer(function()
	task.wait()
	if not closed then clampBtn() end
end)
setLight(true, true)

