ll.SortOrder = Enum.SortOrder.LayoutOrder

-- navegação
local backBtn = button(win, "Voltar", UDim2.new(0.3, -6, 0, 30), UDim2.new(0, 10, 1, -38))
local nextBtn = button(win, "Próxima", UDim2.new(0.3, -6, 0, 30), UDim2.new(0.7, -4, 1, -38))
local pageLbl = label(win, "", UDim2.new(0.4, 0, 0, 30), UDim2.new(0.3, 0, 1, -38), 12, C.dim, Enum.TextXAlignment.Center)

-- ===== SERVIDORES =====
local all, busy = {}, false

local function clearList()
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("Frame") or c:IsA("TextLabel") then c:Destroy() end
	end
end

local function message(text)
	clearList()
	local l = label(list, text, UDim2.new(1, 0, 0, 40), nil, 13, C.dim, Enum.TextXAlignment.Center)
	l.LayoutOrder = 1
end

local function render()
	local minP, maxPing = MIN_OPTS[minIdx], PING_OPTS[pingIdx]
	local view = {}
	for _, s in ipairs(all) do
		if s.id ~= game.JobId and type(s.playing) == "number" and s.playing >= minP
			and (maxPing == 0 or (type(s.ping) == "number" and s.ping <= maxPing)) then
			table.insert(view, s)
		end
	end
	local total = math.max(1, math.ceil(#view / PER_PAGE))
	page = math.clamp(page, 1, total)
	pageLbl.Text = "Aba " .. page .. "/" .. total .. "  (" .. #view .. ")"

	if #view == 0 then
		message("Nenhum servidor com esses filtros.")
		return
	end
	clearList()
	for i = (page - 1) * PER_PAGE + 1, math.min(#view, page * PER_PAGE) do
		local s = view[i]
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, 46)
		row.BackgroundColor3 = C.row
		row.BorderSizePixel = 0
		row.LayoutOrder = i
		row.Parent = list
		corner(row, 8)
		label(row, "Jogadores: " .. s.playing .. "/" .. (s.maxPlayers or "?"), UDim2.new(1, -84, 0, 20), UDim2.fromOffset(10, 4), 13, C.text)
		label(row, "Ping: " .. (type(s.ping) == "number" and (s.ping .. " ms") or "?"), UDim2.new(1, -84, 0, 18), UDim2.fromOffset(10, 24), 12, C.dim)
		local join = button(row, "Entrar", UDim2.fromOffset(66, 30), UDim2.new(1, -74, 0.5, -15), C.join)
		join.Activated:Connect(function()
			join.Text = "..."
			local ok = pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, lp) end)
			if not ok then
				join.Text = "Falhou"
				task.delay(1.5, function() if join.Parent then join.Text = "Entrar" end end)
			end
		end)
	end
	list.CanvasPosition = Vector2.new(0, 0)
end

local function fetch()
	if busy then return end
	busy = true
	message("Buscando servidores...")
	task.spawn(function()
		local found, cursor, failed = {}, nil, false
		for _ = 1, 3 do -- até 300 servidores
			local url = "https://games.roblox.com/v1/games/" .. game.PlaceId
				.. "/servers/Public?sortOrder=Desc&excludeFullGames=true&limit=100"
			if cursor then url = url .. "&cursor=" .. cursor end
			local data = apiJson(url)
			if not data or type(data.data) ~= "table" then
				failed = true
				break
			end
			for _, s in ipairs(data.data) do table.insert(found, s) end
			if type(data.nextPageCursor) ~= "string" then break end
			cursor = data.nextPageCursor
			task.wait(0.4)
		end
		busy = false
		if not alive then return end
		if #found == 0 and failed then
			message("Não consegui buscar (sem http ou limite do Roblox). Toque em Atualizar.")
			return
		end
		all, page = found, 1
		render()
	end)
end

refreshBtn.Activated:Connect(fetch)
backBtn.Activated:Connect(function()
	if page > 1 then page -= 1 render() end
end)
nextBtn.Activated:Connect(function()
	page += 1
	render()
end)
pingBtn.Activated:Connect(function()
	pingIdx = pingIdx % #PING_OPTS + 1
	pingBtn.Text = pingIdx == 1 and "Ping: todos" or ("Ping: até " .. PING_OPTS[pingIdx])
	page = 1
	render()
end)
minBtn.Activated:Connect(function()
	minIdx = minIdx % #MIN_OPTS + 1
	minBtn.Text = minIdx == 1 and "Jogadores: todos" or ("Jogadores: " .. MIN_OPTS[minIdx] .. "+")
	page = 1
	render()
end)

-- ping do servidor atual, atualizado a cada segundo
task.spawn(function()
	while alive and gui.Parent do
		local ms = currentPing()
		info.Text = "Servidor atual: ping " .. ms .. " ms  •  " .. #Players:GetPlayers() .. "/" .. Players.MaxPlayers
			.. " jogadores\nLocalização: o Roblox não informa (estimativa: " .. regionGuess(ms) .. ")"
		task.wait(1)
	end
end)

fetch()
