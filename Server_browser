-- ===== SERVER BROWSER =====
-- Abre um pop up com o ping do servidor atual e a lista de servidores do jogo (6 por aba).
-- X fecha. Filtros por ping e por quantidade de jogadores. "Entrar" teleporta para o servidor.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local Stats = game:GetService("Stats")

local lp = Players.LocalPlayer
local pg = lp:WaitForChild("PlayerGui")

local oldGui = pg:FindFirstChild("ServerBrowser")
if oldGui then oldGui:Destroy() end

local alive = true
local PER_PAGE = 6

-- ===== REDE =====
local function httpGet(url)
	local req = request or http_request or (syn and syn.request)
	if req then
		local ok, res = pcall(req, { Url = url, Method = "GET" })
		if ok and type(res) == "table" and res.Body then return res.Body end
	end
	local ok, body = pcall(function() return game:HttpGet(url) end)
	if ok then return body end
	return nil
end

local function apiJson(url)
	local function try(u)
		local body = httpGet(u)
		if not body then return nil end
		local ok, d = pcall(function() return HttpService:JSONDecode(body) end)
		if ok and type(d) == "table" and not d.errors then return d end
		return nil
	end
	return try(url) or try((url:gsub("roblox%.com", "roproxy.com")))
end

local function currentPing()
	local ok, v = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
	if ok and type(v) == "number" and v > 0 then return math.floor(v + 0.5) end
	return math.floor(lp:GetNetworkPing() * 2000)
end

-- O Roblox não informa onde o servidor fica. Isto é só uma estimativa pela distância (ping).
local function regionGuess(ms)
	if ms < 60 then return "perto de você" end
	if ms < 130 then return "distância média" end
	return "longe de você"
end

-- ===== TELA =====
local gui = Instance.new("ScreenGui")
gui.Name = "ServerBrowser"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 800
gui.Parent = pg

local C = {
	bg = Color3.fromRGB(20, 20, 25),
	row = Color3.fromRGB(32, 32, 38),
	btn = Color3.fromRGB(52, 52, 60),
	text = Color3.fromRGB(230, 230, 236),
	dim = Color3.fromRGB(150, 150, 162),
	join = Color3.fromRGB(44, 100, 108),
}

local function corner(o, r)
	Instance.new("UICorner", o).CornerRadius = UDim.new(0, r or 8)
end

local function label(parent, text, size, pos, textSize, color, align)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = size
	l.Position = pos or UDim2.new()
	l.Font = Enum.Font.GothamMedium
	l.TextSize = textSize or 13
	l.TextColor3 = color or C.text
	l.TextXAlignment = align or Enum.TextXAlignment.Left
	l.TextWrapped = true
	l.Text = text
	l.Parent = parent
	return l
end

local function button(parent, text, size, pos, color)
	local b = Instance.new("TextButton")
	b.Size = size
	b.Position = pos or UDim2.new()
	b.BackgroundColor3 = color or C.btn
	b.TextColor3 = C.text
	b.Font = Enum.Font.GothamMedium
	b.TextSize = 13
	b.Text = text
	b.AutoButtonColor = true
	b.Parent = parent
	corner(b, 8)
	return b
end

