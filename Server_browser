corner(win, 14)
local winScale = Instance.new("UIScale", win)
winScale.Scale = 0.7
TweenService:Create(winScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()

label(win, "Server browser", UDim2.new(1, -60, 0, 28), UDim2.fromOffset(12, 4), 16, C.text)

local xBtn = button(win, "X", UDim2.fromOffset(32, 28), UDim2.new(1, -40, 0, 5))
xBtn.Activated:Connect(function()
	alive = false
	gui:Destroy()
end)

-- ping e localização do servidor atual
local info = label(win, "", UDim2.new(1, -24, 0, 34), UDim2.fromOffset(12, 36), 12, C.text)

-- filtros
local PING_OPTS = { 0, 100, 200, 300 } -- 0 = qualquer
local MIN_OPTS = { 0, 5, 10, 20 }
local pingIdx, minIdx, page = 1, 1, 1

local refreshBtn = button(win, "Atualizar", UDim2.new(0.3, -6, 0, 28), UDim2.new(0, 10, 0, 74), C.join)
local pingBtn = button(win, "Ping: todos", UDim2.new(0.35, -6, 0, 28), UDim2.new(0.3, 2, 0, 74))
local minBtn = button(win, "Jogadores: todos", UDim2.new(0.35, -6, 0, 28), UDim2.new(0.65, 2, 0, 74))
pingBtn.TextSize, minBtn.TextSize = 12, 12

-- lista (arrastável)
local list = Instance.new("ScrollingFrame")
list.BackgroundTransparency = 1
list.BorderSizePixel = 0
list.Position = UDim2.fromOffset(10, 108)
list.Size = UDim2.new(1, -20, 1, -108 - 44)
list.ScrollBarThickness = 4
list.AutomaticCanvasSize = Enum.AutomaticSize.Y
list.CanvasSize = UDim2.new()
list.Parent = win
local ll = Instance.new("UIListLayout", list)
