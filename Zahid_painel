-- ===== TP AJUDA (deitado) =====
-- trip (deitado) > "fly" que segura no ar > noclip > TP exatamente abaixo do jogador
-- (pés dele no meio do meu tronco) > sobe 10 studs aos poucos > noclip desliga
-- > fico deitado na plataforma do float até eu pular.
local RISE_STUDS = 10    -- quanto sobe no final
local RISE_SPEED = 4     -- studs por segundo (subida gradual)
local LIE_OFFSET = 3.5   -- do centro dele até o meu centro deitado (aumente se ele afundar, diminua se ficar alto)
local helpBusy = false

local function targetRoot()
	local ch = selectedPlayer and selectedPlayer.Character
	return ch and ch:FindFirstChild("HumanoidRootPart")
end

local function myRoot()
	return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end

local function runTpHelp()
	if helpBusy then return end
	if not targetRoot() then
		helpBtn.face.Text = "Selecione um jogador"
		task.delay(1.5, function()
			helpBtn.face.Text = "tp ajuda"
		end)
		return
	end

	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local mine = myRoot()
	if not hum or not mine then return end

	helpBusy = true
	helpBtn.face.Text = "Ajudando..."
	if conns.helpJump then conns.helpJump:Disconnect() conns.helpJump = nil end

	-- deitado de barriga para cima, mantendo para onde eu estava olhando
	local look = mine.CFrame.LookVector
	local yaw = math.atan2(-look.X, -look.Z)
	local lieRot = CFrame.Angles(0, yaw, 0) * CFrame.Angles(math.rad(90), 0, 0)

	local bv, bg
	pcall(function()
		-- 1) trip: fica deitado
		hum.PlatformStand = true

		-- 2) "fly": segura no ar e mantém deitado (o fly normal me levantaria, pois alinha com a câmera)
		bv = Instance.new("BodyVelocity")
		bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		bv.Velocity = Vector3.zero
		bv.Parent = mine
		bg = Instance.new("BodyGyro")
		bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
		bg.P = 9e4
		bg.CFrame = lieRot
		bg.Parent = mine
		task.wait(0.3) -- tempo de deitar

		-- 3) noclip
		noclip(true)

		-- 4) TP exatamente abaixo: pés dele no meio do meu tronco
		local theirs = targetRoot()
		local p = theirs.Position
		mine.CFrame = CFrame.new(p.X, p.Y - LIE_OFFSET, p.Z) * lieRot
		mine.AssemblyLinearVelocity = Vector3.zero
		mine.AssemblyAngularVelocity = Vector3.zero
		task.wait(0.05)

		-- plataforma do float sob as minhas costas (para eu ficar deitado no final)
		toggles.Float(true)
		floatY = mine.Position.Y - 1.0

		-- 5) sobe 10 studs aos poucos
		bv.Velocity = Vector3.new(0, RISE_SPEED, 0)
		local risen = 0
		while risen < RISE_STUDS and mine.Parent do
			local dt = RunService.Heartbeat:Wait()
			risen += RISE_SPEED * dt
			floatY = mine.Position.Y - 1.0
		end
		bv.Velocity = Vector3.zero
		floatY = mine.Position.Y - 1.0
		task.wait(0.1)
	end)

	-- 6) desliga o noclip (sempre, mesmo se algo falhou) e solta o "fly"
	noclip(false)
	task.wait(0.1)
	if bv then bv:Destroy() end
	if bg then bg:Destroy() end

	-- 7) continuo deitado até eu pular
	conns.helpJump = UIS.JumpRequest:Connect(function()
		local r = myRoot()
		local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if conns.helpJump then conns.helpJump:Disconnect() conns.helpJump = nil end
		if h ~= hum or not h.PlatformStand or not r then return end
		r.CFrame = CFrame.new(r.Position + Vector3.new(0, 2.5, 0)) * CFrame.Angles(0, yaw, 0)
		h.PlatformStand = false
		h:ChangeState(Enum.HumanoidStateType.GettingUp)
	end)

	helpBusy = false
	helpBtn.face.Text = "tp ajuda"
end

