-- ===== ABA CONFIGURAÇÕES (tema, sons e fechar) =====
local applyTheme
local closeBtn -- usado no final do script para desligar tudo e apagar o menu

do
	local page = pages.config

	section(page, "Tema")
	local themeRow = addRow(page, "Tema claro", "Troca entre o visual escuro e o claro.", "switch")

	function applyTheme(name)
		config.theme = name
		loadTheme(name)
		for _, fn in ipairs(themeFns) do fn() end
		for _, b in ipairs(buttons3D) do
			if b.holder.Parent then b.applyTheme() end
		end
		for _, fn in ipairs(themeRefreshers) do fn() end
		themeRow.setOn(name == "light")
		saveConfig()
	end
	themeRow.face.Activated:Connect(function()
		applyTheme(config.theme == "light" and "dark" or "light")
	end)

	section(page, "Sons dos botões")
	local soundRow = addRow(page, "Sons", "Liga ou desliga os sons ao tocar nos botões.", "switch")
	soundRow.face.Activated:Connect(function()
		config.sound = not config.sound
		soundRow.setOn(config.sound)
		saveConfig()
		if config.sound then playSfx() end
	end)

	-- escolha do som (só um fica ligado): pop, retro ou gota
	section(page, "Som escolhido")
	local choices = {
		{ name = "pop", desc = "Som de estourar uma bolinha." },
		{ name = "retro", desc = "O click retro clássico do Roblox." },
		{ name = "gota", desc = "Uma única gota caindo na água." },
	}
	local choiceRows = {}
	local function refreshChoice()
		for name, r in pairs(choiceRows) do r.setOn(config.soundName == name) end
	end
	for _, c in ipairs(choices) do
		local r = addRow(page, c.name, c.desc, "switch")
		choiceRows[c.name] = r
		r.face.Activated:Connect(function()
			config.soundName = c.name
			refreshChoice()
			saveConfig()
			playSfx(c.name) -- toca o som escolhido para você ouvir
		end)
	end

	local hint = mkLabel(page, "Os sons usam arquivos do próprio Roblox; se algum não carregar no seu aparelho, ele fica mudo.", 11, "textDim")
	hint.Size = UDim2.new(1, 0, 0, 0)
	hint.AutomaticSize = Enum.AutomaticSize.Y

	themeRow.setOn(config.theme == "light")
	soundRow.setOn(config.sound)
	refreshChoice()

	section(page, "Fechar")
	closeBtn = addRow(page, "fechar", "Fecha e desliga tudo. Fica aqui para evitar fechar sem querer.", "action", "fechar", "Danger")
end

-- ===== FECHAR (desliga tudo e apaga o menu) =====
-- Depois de fechar, o script pode ser executado de novo (a verificação do início não acha mais nenhum menu aberto).
closeBtn.face.Activated:Connect(function()
	-- primeiro o que mexe no personagem e na câmera (ajudar, espectar) e as janelas
	for _, key in ipairs({ "help", "spectate", "picker", "browser" }) do
		local c = conns[key]
		if c then
			pcall(function() c:Disconnect() end)
			conns[key] = nil
		end
	end
	-- desliga todos os botões liga/desliga e o auto farm
	for _, setState in pairs(toggles) do pcall(setState, false) end
	pcall(function() if farmOn then farmEnable(false) end end)
	-- solta as conexões que sobraram e apaga o menu
	for key, c in pairs(conns) do
		pcall(function() c:Disconnect() end)
		conns[key] = nil
	end
	gui:Destroy()
end)

-- ===== INÍCIO =====
showPage("comportamento")
tween(bubbleScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
