-- ===== ABA JOGADORES =====
local themeRefreshers = {}   -- listas que precisam ser refeitas quando o tema muda
local selectedPlayer = nil
local stopSpectate, startSpectate, spectating
local helpOn = false
local helpFrearHeld, helpFrearStart, helpFrearDone = false, 0, false

do
	local page = pages.jogadores
	local selectRow = addRow(page, "Selecionar jogador", "Escolha um jogador da lista.", "action", "abrir")

	-- ===== SELETOR (janela): amigos primeiro (outra cor), ordem alfabética e foto do avatar =====
	local PK_W = math.min(310, viewport.X - 16)
	local PK_H = math.min(310, viewport.Y - 16)
	local picker = mkWindowFrame(gui)
	picker.Name = "Seletor"
	picker.Size = UDim2.fromOffset(PK_W, PK_H)
	picker.AnchorPoint = Vector2.new(0.5, 0.5)
	picker.Position = UDim2.fromScale(0.5, 0.5)
	picker.Visible = false
	local pickScale = Instance.new("UIScale")
	pickScale.Parent = picker

	local pickTitle = mkLabel(picker, "Selecionar jogador", 15, "text")
	pickTitle.Font = FONT_BOLD
	pickTitle.Position = UDim2.fromOffset(12, 10)
	pickTitle.Size = UDim2.new(1, -96, 0, 20)
	local pickClose = new3DButton(picker, "fechar", UDim2.new(1, -78, 0, 6), UDim2.fromOffset(70, 28), "Danger")
	pickClose.face.TextSize = 12

	local pickList = mkScroll(picker)
	pickList.Position = UDim2.fromOffset(8, 40)
	pickList.Size = UDim2.new(1, -16, 1, -48)
	mkList(pickList, 5)
	mkPadding(pickList, 0, 0, 6, 4)

	local friendCache, friendPending = {}, {}
	local pickerOpen = false
	local refreshPicker

	local function refreshSoon()
		task.delay(0.4, function()
			if pickerOpen then refreshPicker() end
		end)
	end

	-- descobre, sem travar, se o jogador é meu amigo; quando a resposta chega, os amigos sobem para o topo
	local function queryFriend(p)
		if friendCache[p.UserId] ~= nil or friendPending[p.UserId] then return end
		friendPending[p.UserId] = true
		task.spawn(function()
			local ok, res = pcall(function() return player:IsFriendsWith(p.UserId) end)
			friendPending[p.UserId] = nil
			friendCache[p.UserId] = (ok and res == true)
			refreshSoon()
		end)
	end

	-- mensagem dentro da lista (lista vazia ou erro)
	local function messageRow(text, colorKey)
		local holder = Instance.new("Frame") -- é um Frame para a limpeza da lista apagar junto
		holder.BackgroundTransparency = 1
		holder.Size = UDim2.new(1, 0, 0, 44)
		holder.Parent = pickList
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Size = UDim2.fromScale(1, 1)
		l.Font = FONT
		l.TextSize = 13
		l.TextWrapped = true
		l.TextColor3 = T[colorKey]
		l.Text = text
		l.Parent = holder
	end

	function refreshPicker()
		for _, c in ipairs(pickList:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end

		local entries = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then
				queryFriend(p)
				table.insert(entries, {
					p = p,
					friend = friendCache[p.UserId] == true,
					key = string.lower(p.DisplayName),
					key2 = string.lower(p.Name),
				})
			end
		end
		table.sort(entries, function(a, b)
			if a.friend ~= b.friend then return a.friend end
			if a.key ~= b.key then return a.key < b.key end
			return a.key2 < b.key2
		end)

		local ok, err = pcall(function()
			if #entries == 0 then
				messageRow("Ninguém mais no servidor.", "textDim")
				return
			end
			for _, e in ipairs(entries) do
				local p = e.p
				local item = new3DButton(pickList, p.DisplayName .. " (@" .. p.Name .. ")", UDim2.new(),
					UDim2.new(1, 0, 0, 40), e.friend and "Net" or "Off")
				item.face.TextSize = 12
				item.face.TextXAlignment = Enum.TextXAlignment.Left
				mkPadding(item.face, 42, 0, 4, 0)

				-- foto do avatar à esquerda do nome (o padding de 42 empurra os filhos: compensa)
				local img = Instance.new("ImageLabel")
				img.Size = UDim2.fromOffset(28, 28)
				img.Position = UDim2.new(0, -36, 0.5, -14)
				img.BackgroundTransparency = 1
				img.BorderSizePixel = 0
				img.Parent = item.face
				Instance.new("UICorner", img).CornerRadius = UDim.new(1, 0)
				loadAvatar(img, p.UserId)

				item.face.Activated:Connect(function()
					selectedPlayer = p
					selectRow.setBase("Selecionado: " .. p.DisplayName)
					pickerOpen = false
					picker.Visible = false
					if spectating then startSpectate() end -- trocou de jogador: passa a espectar o novo
				end)
			end
		end)
		if not ok then messageRow("Erro ao montar a lista: " .. tostring(err), "bad") end
	end

	local function openPicker()
		pickerOpen = true
		refreshPicker()
		picker.Visible = true
		pickScale.Scale = 0.85
		tween(pickScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	local function closePicker()
		pickerOpen = false
		picker.Visible = false
	end
	selectRow.face.Activated:Connect(openPicker)
	pickClose.face.Activated:Connect(closePicker)
	conns.picker = { Disconnect = closePicker }
	table.insert(themeRefreshers, function() if pickerOpen then refreshPicker() end end)

	Players.PlayerAdded:Connect(function(p)
		queryFriend(p)
		if pickerOpen then refreshPicker() end
	end)
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then queryFriend(p) end
	end

	Players.PlayerRemoving:Connect(function(p)
		if p == selectedPlayer then
			selectedPlayer = nil
			selectRow.setBase("Escolha um jogador da lista.")
			if spectating then stopSpectate() end
		end
		if pickerOpen then task.defer(refreshPicker) end
	end)

	-- ===== TP =====
	local tpRow = addRow(page, "tp", "Teleporta até o jogador selecionado.", "action", "ir", "Tp")
	tpRow.face.Activated:Connect(function()
		local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local targetChar = selectedPlayer and selectedPlayer.Character
		local targetHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
		if myHrp and targetHrp then
			myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 3)
		else
			tpRow.flash("Selecione um jogador", "bad")
		end
	end)

	-- ===== ESPECTAR: a câmera vai até o jogador sem você sair do jogo; desligar devolve a câmera =====
	local specRow = addRow(page, "espectar", "A câmera vai até o jogador, sem você sair do jogo.", "switch")
	local specConn, specTarget = nil, nil
	function stopSpectate()
		spectating = false
		specTarget = nil
		if specConn then specConn:Disconnect() specConn = nil end
		local cam = workspace.CurrentCamera
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if cam and hum then cam.CameraSubject = hum end
		specRow.setOn(false)
		specRow.setName("espectar")
	end
	function startSpectate()
		local target = selectedPlayer
		if not target then
			specRow.flash("Selecione um jogador", "bad")
			specRow.setOn(false)
			return
		end
		if specConn then specConn:Disconnect() specConn = nil end
		spectating = true
		specTarget = target
		specRow.setOn(true)
		specRow.setName("parar de espectar")
		specConn = RunService.RenderStepped:Connect(function()
			local cam = workspace.CurrentCamera
			local hum = specTarget and specTarget.Character and specTarget.Character:FindFirstChildOfClass("Humanoid")
			if not specTarget or not specTarget.Parent then
				stopSpectate() -- o jogador saiu
				return
			end
			if cam and hum and cam.CameraSubject ~= hum then cam.CameraSubject = hum end
		end)
	end
	specRow.face.Activated:Connect(function()
		if spectating then stopSpectate() else startSpectate() end
	end)
	conns.spectate = { Disconnect = function() if spectating then stopSpectate() end end }

	-- ===== AJUDAR (deitado, só na vertical, segue o jogador selecionado) =====
	-- Ligado: fico em estado de "fly" (corpo duro e reto), SEMPRE deitado de barriga para cima, embaixo
	-- dos pés do jogador selecionado. Eu só me movo na vertical, com os botões subir/descer (e as teclas E/Q).
	-- Na horizontal eu sigo o jogador selecionado, para ele não cair. O botão "frear" pausa esse acompanhamento.
	-- Desligado (ou se eu morrer, ou se o jogador sair): levanto em pé onde estou.
	local LIE_OFFSET = 3.5       -- do centro dele até o meu centro deitado (aumente se ele afundar, diminua se ficar alto)
	local FOLLOW_GAIN = 25       -- quão rápido acompanho o jogador na horizontal (maior = mais colado)
	local FOLLOW_MAX = 60        -- velocidade máxima desse acompanhamento (studs por segundo)
	local FOLLOW_SNAP = 40       -- se ele ficar mais longe que isso (ex.: se teleportou), vou direto para baixo dele
	local FREAR_DELAY = 1        -- segundos segurando "frear" antes de ir para baixo do jogador
	local FREAR_OFFSET = 2       -- quantos studs abaixo do jogador eu vou quando o "frear" teleporta
	local helpState = nil        -- { bv, bg, hum, conn, yaw } enquanto o ajudar está ligado
	local helpApfPending = false -- o Anti Part Fling estava ligado e volta quando eu terminar

	local function targetRoot()
		local ch = selectedPlayer and selectedPlayer.Character
		return ch and ch:FindFirstChild("HumanoidRootPart")
	end

	local function myRoot()
		return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	end

	local helpRow = addRow(page, "ajudar", "Deita sob o jogador selecionado e o acompanha; só se move na vertical.", "switch")

	local function stopHelp()
		if not helpOn then return end
		helpOn = false
		helpFrearHeld = false
		local s = helpState
		helpState = nil
		if s then
			if s.conn then s.conn:Disconnect() end
			if s.bv then s.bv:Destroy() end
			if s.bg then s.bg:Destroy() end
		end
		noclip(false)

		-- levanta: de pé de novo, onde estou
		local r = myRoot()
		if r and s then
			r.CFrame = CFrame.new(r.Position + Vector3.new(0, 2.5, 0)) * CFrame.Angles(0, s.yaw, 0)
			r.AssemblyLinearVelocity = Vector3.zero
			r.AssemblyAngularVelocity = Vector3.zero
		end
		if s and s.hum and s.hum.Parent then
			s.hum.PlatformStand = false
			s.hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end

		if helpApfPending then
			helpApfPending = false
			toggles["Anti Part Fling"](true)
		end
		helpRow.setOn(false)
	end

	local function startHelp()
		if helpOn then return end
		if not targetRoot() then
			helpRow.flash("Selecione um jogador", "bad")
			helpRow.setOn(false)
			return
		end

		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local mine = myRoot()
		if not hum or not mine then return end

		helpOn = true
		helpRow.setOn(true)

		-- o ajudar tem o próprio voo: desliga fly, vfly e float (que usariam os mesmos botões)
		toggles.Fly(false)
		toggles.VFly(false)
		toggles.Float(false)
		-- o Anti Part Fling tem teto de altura e trava de posição: pausa agora e religa no fim
		if apfActive then
			helpApfPending = true
			toggles["Anti Part Fling"](false)
		end

		-- deitado de barriga para cima, mantendo para onde eu estava olhando
		local look = mine.CFrame.LookVector
		local yaw = math.atan2(-look.X, -look.Z)
		local lieRot = CFrame.Angles(0, yaw, 0) * CFrame.Angles(math.rad(90), 0, 0)

		-- estado de fly: corpo duro e reto
		hum.PlatformStand = true
		noclip(true)

		local bv = Instance.new("BodyVelocity")
		bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		bv.Velocity = Vector3.zero
		bv.Parent = mine

		local bg = Instance.new("BodyGyro")
		bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
		bg.P = 9e4
		bg.CFrame = lieRot -- sempre deitado
		bg.Parent = mine

		-- vai para baixo dos pés do jogador selecionado
		local tp = targetRoot().Position
		mine.CFrame = CFrame.new(tp.X, tp.Y - LIE_OFFSET, tp.Z) * lieRot
		mine.AssemblyLinearVelocity = Vector3.zero
		mine.AssemblyAngularVelocity = Vector3.zero

		helpState = { bv = bv, bg = bg, hum = hum, yaw = yaw }
		helpState.conn = RunService.Heartbeat:Connect(function()
			local r = myRoot()
			if not r or player.Character ~= char or hum.Health <= 0 then
				stopHelp() -- morri ou troquei de personagem
				return
			end
			if not selectedPlayer then
				stopHelp() -- o jogador saiu do servidor
				return
			end
			hum.PlatformStand = true

			-- vertical: os botões subir/descer (do Float) e as teclas E/Q
			local vy = 0
			if floatUp or UIS:IsKeyDown(Enum.KeyCode.E) then vy += FLOAT_SPEED end
			if floatDown or UIS:IsKeyDown(Enum.KeyCode.Q) then vy -= FLOAT_SPEED end

			-- horizontal: acompanho o jogador selecionado (fico sempre embaixo dos pés dele)
			local vx, vz = 0, 0
			local t = targetRoot()
			if helpFrearHeld then
				-- segurando "frear": paro de seguir; depois de 1 segundo vou (uma vez) para baixo do jogador
				if t and not helpFrearDone and os.clock() - helpFrearStart >= FREAR_DELAY then
					helpFrearDone = true
					local tpos = t.Position
					r.CFrame = CFrame.new(tpos.X, tpos.Y - FREAR_OFFSET, tpos.Z) * lieRot
					r.AssemblyLinearVelocity = Vector3.zero
				end
			elseif t then
				local pos, tpos = r.Position, t.Position
				local ex, ez = tpos.X - pos.X, tpos.Z - pos.Z
				if ex * ex + ez * ez > FOLLOW_SNAP * FOLLOW_SNAP then
					r.CFrame = CFrame.new(tpos.X, pos.Y, tpos.Z) * lieRot
				else
					vx, vz = ex * FOLLOW_GAIN, ez * FOLLOW_GAIN
					local mag = math.sqrt(vx * vx + vz * vz)
					if mag > FOLLOW_MAX then
						vx, vz = vx / mag * FOLLOW_MAX, vz / mag * FOLLOW_MAX
					end
				end
			end
			bv.Velocity = Vector3.new(vx, vy, vz)
		end)
	end

	helpRow.face.Activated:Connect(function()
		if helpOn then stopHelp() else startHelp() end
	end)
	-- ao fechar o painel, o "fechar" também desliga o ajudar
	conns.help = { Disconnect = function() if helpOn then stopHelp() end end }

	-- ===== subir / descer e frear (botões para segurar) =====
	local downRow = addRow(page, "descer", "Segure para descer a plataforma do float e do ajudar.", "action", "segurar")
	local upRow = addRow(page, "subir", "Segure para subir a plataforma do float e do ajudar.", "action", "segurar")
	bindHold(downRow.btn, function() floatDown = true end, function() floatDown = false end)
	bindHold(upRow.btn, function() floatUp = true end, function() floatUp = false end)

	local frearRow = addRow(page, "frear", "Segure (com o ajudar ligado): para de seguir e, após 1 s, vai para baixo do jogador.", "action", "segurar", "Help")
	bindHold(frearRow.btn, function()
		if not helpOn then
			frearRow.flash("Ligue o ajudar primeiro", "bad")
			return
		end
		helpFrearHeld = true
		helpFrearStart = os.clock()
		helpFrearDone = false
	end, function()
		helpFrearHeld = false -- soltou: volta a seguir o jogador
	end)
end

