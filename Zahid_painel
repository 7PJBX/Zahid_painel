local function tween(obj, time, props, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

-- ===== SONS DOS BOTÕES (pop, click e gota) =====
-- Usa sons que já vêm no cliente do Roblox. Para cada um o código testa os caminhos da lista e usa o primeiro que carregar.
local SFX_DEFS = {
	pop = { candidates = { "rbxasset://sounds/button.mp3", "rbxasset://sounds/clickfast.mp3" }, speed = 1.8, volume = 0.5, cut = 0.18 },
	click = { candidates = { "rbxasset://sounds/switch.mp3", "rbxasset://sounds/SWITCH3.mp3", "rbxasset://sounds/button.mp3" }, speed = 1.0, volume = 0.6, cut = 0.25 },
	gota = { candidates = { "rbxasset://sounds/impact_water.mp3" }, speed = 2.6, volume = 0.45, cut = 0.35 },
}
local SFX_ORDER = { "pop", "click", "gota" }
local sfxReady = {}    -- [nome] = Sound pronto para tocar
local sfxToken = 0

local function playSfx(name)
	if not config.sound then return end
	name = name or config.soundName
	local s, def = sfxReady[name], SFX_DEFS[name]
	if not s or not s.Parent then return end
	s.PlaybackSpeed = def.speed
	s.Volume = def.volume
	s.TimePosition = 0
	s:Play()
	sfxToken += 1
	local mine = sfxToken
	task.delay(def.cut, function()
		if sfxToken == mine then s:Stop() end
	end)
end

-- carrega os sons em segundo plano (sem travar a abertura do menu)
local function loadSfx(parent)
	task.spawn(function()
		for _, name in ipairs(SFX_ORDER) do
			for _, path in ipairs(SFX_DEFS[name].candidates) do
				local s = Instance.new("Sound")
				s.SoundId = path
				s.Volume = 0
				s.Parent = parent
				local t0 = os.clock()
				while not s.IsLoaded and os.clock() - t0 < 2 do task.wait(0.05) end
				if s.IsLoaded and s.TimeLength > 0 then
					sfxReady[name] = s
					break
				end
				s:Destroy()
			end
		end
	end)
end

-- ===== BOTÃO 3D =====
-- dois retângulos arredondados: o corpo (escuro) fica parado e a face desce por cima dele ao apertar.
-- role escolhe as cores: "Off", "Tp", "Help", "Net" ou "Danger" (as cores seguem o tema)
local pressedFaces = {}

-- ao soltar o dedo/mouse em qualquer lugar, todas as faces apertadas voltam para cima (efeito mola)
UIS.InputEnded:Connect(function(input)
	if not isPress(input) then return end
	for face in pairs(pressedFaces) do
		pressedFaces[face] = nil
		tween(face, 0.14, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
	end
end)

local function new3DButton(parent, text, position, size, role)
	role = role or "Off"
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Position = position
	holder.Size = size
	holder.Parent = parent

	local faceH = size.Y.Offset - DEPTH

	local base = Instance.new("Frame")
	base.Size = UDim2.new(1, 0, 0, faceH)
	base.Position = UDim2.fromOffset(0, DEPTH)
	base.BackgroundColor3 = T["base" .. role]
	base.BorderSizePixel = 0
	base.Parent = holder
	Instance.new("UICorner", base).CornerRadius = UDim.new(0, 10)

	local face = Instance.new("TextButton")
	face.Size = UDim2.new(1, 0, 0, faceH)
	face.Position = UDim2.fromOffset(0, 0)
	face.BackgroundColor3 = T["face" .. role]
	face.BorderSizePixel = 0
	face.AutoButtonColor = false
	face.Font = FONT
	face.TextColor3 = T.text
	face.TextSize = 14
	face.TextTruncate = Enum.TextTruncate.AtEnd
	face.Text = text
	face.Parent = holder
	Instance.new("UICorner", face).CornerRadius = UDim.new(0, 10)

	local obj = { holder = holder, base = base, face = face, role = role, isOn = false }

	face.InputBegan:Connect(function(input)
		if isPress(input) then
			pressedFaces[face] = true
			tween(face, 0.06, { Position = UDim2.fromOffset(0, DEPTH) })
			playSfx()
		end
	end)

	-- aceso/apagado
	function obj.setOn(on)
		obj.isOn = on
		tween(face, 0.2, { BackgroundColor3 = on and T.faceOn or T["face" .. role], TextColor3 = on and T.textOn or T.text })
		tween(base, 0.2, { BackgroundColor3 = on and T.baseOn or T["base" .. role] })
	end

	-- repinta com as cores do tema atual (sem animação)
	function obj.applyTheme()
		face.BackgroundColor3 = obj.isOn and T.faceOn or T["face" .. role]
		face.TextColor3 = obj.isOn and T.textOn or T.text
		base.BackgroundColor3 = obj.isOn and T.baseOn or T["base" .. role]
	end

	if #buttons3D > 160 then
		for i = #buttons3D, 1, -1 do
			if not buttons3D[i].holder.Parent then table.remove(buttons3D, i) end
		end
	end
	table.insert(buttons3D, obj)
	return obj
end

