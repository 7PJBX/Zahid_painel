	local minX, minY, maxX, maxY = bubbleBounds()
	bx, by = math.clamp(bx, minX, maxX), math.clamp(by, minY, maxY)
	tween(bubble, 0.5, { Position = UDim2.fromOffset(bx, by) }, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
	if windowOpen then placeWindow() end
end)

