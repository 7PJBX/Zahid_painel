			end)
			task.delay(ok and 8 or 1.5, function()
				if joinBtn.face.Parent then joinBtn.face.Text = ok and "entrar" or "Falhou" end
			end)
		end)

		-- fotos dos jogadores: no servidor atual vêm direto; nos outros o Roblox só dá fotos anônimas
		local slots = {}
		if isCurrent then
			for _, p in ipairs(Players:GetPlayers()) do
				if #slots >= 8 then break end
				table.insert(slots, { userId = p.UserId })
			end
		else
			for i, tok in ipairs(s.tokens) do
				if i > 8 then break end
				table.insert(slots, { token = tok })
			end
		end
		for i, sl in ipairs(slots) do
			local img = Instance.new("ImageLabel")
			img.Size = UDim2.fromOffset(26, 26)
			img.Position = UDim2.fromOffset(8 + (i - 1) * 30, 36)
