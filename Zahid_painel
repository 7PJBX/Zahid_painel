					end
				end
			end
			if next(chosen) == nil then return false end
			for _, d in ipairs(view.model:GetDescendants()) do
				if d:IsA("BasePart") then
					local inSel = false
					for acc in pairs(chosen) do
						if d:IsDescendantOf(acc) then inSel = true break end
					end
					if not inSel then
