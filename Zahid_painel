-- ===== CÂMERA: FOV, BINÓCULOS E TRAVA DE DIREÇÃO =====
local binocularsToggle, setShiftLockFeature, setBaseFov
do
	local FOV_MIN, FOV_MAX = 30, 100
	local function clampFov(v) return math.clamp(v, FOV_MIN, FOV_MAX) end
	config.fov = clampFov(config.fov)

	local binocularsEquipped = false
	local zoomT = 0            -- 0 = sem zoom (fov normal) .. 1 = zoom máximo
	local ZOOM_FOV_MIN = 8
	local activeFov = config.fov
	local rotScale = 1         -- multiplicador da rotação da câmera (cai com o zoom dos binóculos)
	local origMouseDelta = UIS.MouseDeltaSensitivity

	local function recomputeFov()
		activeFov = binocularsEquipped and (config.fov - (config.fov - ZOOM_FOV_MIN) * zoomT) or config.fov
		-- quanto mais zoom, menor a sensibilidade (proporcional ao ângulo de visão), com um mínimo
		rotScale = binocularsEquipped and math.clamp(activeFov / config.fov, 0.12, 1) or 1
		pcall(function() UIS.MouseDeltaSensitivity = origMouseDelta * rotScale end)
	end

	-- aplica o FOV o tempo todo (some do close/toggles: fica sempre ligado, igual ao botão do menu)
	conns.fovLoop = RunService.RenderStepped:Connect(function()
		local cam = workspace.CurrentCamera
		if cam then cam.FieldOfView = activeFov end
	end)

	-- a rotação da câmera padrão do Roblox (toque e mouse) passa a ser multiplicada por rotScale
	local camInputMod, origGetRotation
	task.spawn(function()
		pcall(function()
			local ps = player:WaitForChild("PlayerScripts", 10)
			local pm = ps and ps:WaitForChild("PlayerModule", 10)
			local cm = pm and pm:WaitForChild("CameraModule", 10)
			local ci = cm and cm:WaitForChild("CameraInput", 10)
			if not ci then return end
			local mod = require(ci)
			if type(mod.getRotation) == "function" then
				origGetRotation = mod.getRotation
				camInputMod = mod
				mod.getRotation = function(...)
					return origGetRotation(...) * rotScale
				end
			end
		end)
	end)

	function setBaseFov(v)
		config.fov = clampFov(v)
		recomputeFov()
		saveConfig()
	end

	-- ===== BINÓCULOS (ferramenta): só o zoom, com a barra à direita, enquanto equipada =====
	local binOverlay = Instance.new("ScreenGui")
	binOverlay.Name = "Binoculos"
