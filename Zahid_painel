local USE_QUEUE = true                    -- false se o script já roda sozinho pela pasta autoexec
local TELEPORT_JUMP = 15                  -- deslocamento em 1 frame (studs) que conta como teleporte
local USE_INTERVAL = 5                    -- segundos entre cada uso da ferramenta
local FARM_ANTIFLING_ON_RELOG = true   -- depois de relogar (queda de internet), já deixa o AntiFling ligado

local farmOn = false
local farmCFrame = nil       -- posição definida
local farmToolName = nil     -- ferramenta que está sendo usada
local farmLastPos = nil
local farmLastReturn = 0
local farmLastUse = 0
local farmLastEquip = 0
local farmGoToken = 0
local farmQueued = false
local farmReconnecting = false

local function farmRoot()
	return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end

-- salva posição e estado em arquivo (se o executor tiver writefile)
local function farmSave()
	if not writefile then return end
	local data = { placeId = game.PlaceId, active = farmOn }
	if farmCFrame then data.cf = { farmCFrame:GetComponents() } end
	pcall(function()
		writefile(FARM_FILE, HttpService:JSONEncode(data))
	end)
end

local function farmLoad()
	if not (readfile and isfile) then return nil end
	local ok, data = pcall(function()
		if not isfile(FARM_FILE) then return nil end
		return HttpService:JSONDecode(readfile(FARM_FILE))
	end)
	if ok and type(data) == "table" and data.placeId == game.PlaceId then return data end
	return nil
end

-- pede ao executor para rodar este script de novo depois do teleporte de reconexão
local function farmQueueSelf()
	if farmQueued or not USE_QUEUE then return end
	local q = queue_on_teleport or (syn and syn.queue_on_teleport)
	if not q then return end
	local code
	if SCRIPT_URL ~= "" then
		code = 'loadstring(game:HttpGet("' .. SCRIPT_URL .. '"))()'
	else
		code = 'loadstring(readfile("' .. SCRIPT_FILE .. '"))()'
	end
	if pcall(q, code) then farmQueued = true end
end

-- vai para a posição definida (repete por uns segundos, pois o jogo também posiciona o personagem)
local function farmGoTo()
	farmGoToken += 1
	local token = farmGoToken
	task.spawn(function()
		local char = player.Character or player.CharacterAdded:Wait()
		local hrp = char:WaitForChild("HumanoidRootPart", 10)
		if not hrp then return end
		for _ = 1, 20 do
			if not farmOn or farmGoToken ~= token or not hrp.Parent then return end
			hrp.CFrame = farmCFrame
			hrp.AssemblyLinearVelocity = Vector3.zero
			farmLastPos = nil
			task.wait(0.15)
		end
	end)
end

-- equipa a ferramenta usada antes; se não achar, a do slot 2 (ordem da mochila)
local function farmEquip()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not hum or not backpack or hum.Health <= 0 then return end

	local tool = farmToolName and backpack:FindFirstChild(farmToolName)
	if not (tool and tool:IsA("Tool")) then
		local list = {}
		for _, c in ipairs(backpack:GetChildren()) do
			if c:IsA("Tool") then table.insert(list, c) end
		end
		tool = list[2] or list[1]
	end
	if tool then
		farmToolName = tool.Name
		hum:EquipTool(tool)
	end
end

-- tenta voltar ao jogo quando a conexão cai
local function farmReconnect()
	if farmReconnecting or not farmOn then return end
	farmReconnecting = true
	farmSave()
	farmQueueSelf()
	task.spawn(function()
		local attempt = 0
		while farmOn do
			attempt += 1
			pcall(function()
				if attempt <= 3 then
					-- primeiro tenta o mesmo servidor
					TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
				else
					-- se ele já fechou, entra em outro
					TeleportService:Teleport(game.PlaceId, player)
				end
			end)
			task.wait(8) -- sem internet o teleporte falha; tenta de novo
		end
		farmReconnecting = false
	end)
end

local function farmEnable(on)
	for _, k in ipairs({ "farmHB", "farmChar", "farmErr1", "farmErr2", "farmIdle" }) do
		if conns[k] then conns[k]:Disconnect() conns[k] = nil end
	end
	farmOn = on
	farmSave()
	if not on then return end
	if not farmCFrame then farmOn = false return end

	farmQueueSelf()
	farmGoTo()
	farmLastPos = nil

	-- loop principal: volta se for teleportado + usa a ferramenta sem parar
	conns.farmHB = RunService.Heartbeat:Connect(function()
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then farmLastPos = nil return end
		local now = os.clock()

		-- 1) o jogo me teleportou? volta para a posição definida
		if farmLastPos and (hrp.Position - farmLastPos).Magnitude > TELEPORT_JUMP then
			if now - farmLastReturn > 0.3 then
				hrp.CFrame = farmCFrame
				hrp.AssemblyLinearVelocity = Vector3.zero
				farmLastReturn = now
				farmLastPos = farmCFrame.Position
			end
		else
			farmLastPos = hrp.Position
		end

		-- 2) usa a ferramenta da mão a cada USE_INTERVAL segundos; sem ferramenta, equipa a do slot 2
		local tool = char:FindFirstChildOfClass("Tool")
		if tool then
			farmToolName = tool.Name
			if now - farmLastUse >= USE_INTERVAL then
				farmLastUse = now
				tool:Activate()
			end
		elseif now - farmLastEquip >= 0.5 then
			farmLastEquip = now
			farmEquip()
		end
	end)

	-- morreu: ao renascer volta para a posição definida
	conns.farmChar = player.CharacterAdded:Connect(function()
		farmLastPos = nil
		farmGoTo()
	end)

	-- queda de conexão (erro 277 etc.): reconecta sozinho
	conns.farmErr1 = GuiService.ErrorMessageChanged:Connect(function()
		local msg = string.lower(GuiService:GetErrorMessage() or "")
		if msg:find("277") or msg:find("connection") or msg:find("conex") then
			farmReconnect()
		end
	end)
	task.spawn(function()
		pcall(function()
			local gui = game:GetService("CoreGui"):WaitForChild("RobloxPromptGui", 10)
			local overlay = gui and gui:WaitForChild("promptOverlay", 10)
			if overlay and farmOn and not conns.farmErr2 then
				conns.farmErr2 = overlay.ChildAdded:Connect(function(child)
					if child.Name == "ErrorPrompt" then farmReconnect() end
				end)
			end
		end)
	end)

	-- anti-idle: evita ser expulso por ficar parado
	conns.farmIdle = player.Idled:Connect(function()
		pcall(function()
			local vu = game:GetService("VirtualUser")
			vu:CaptureController()
			vu:ClickButton2(Vector2.new())
		end)
	end)
end

-- ===== ANTI PART FLING =====
-- Enquanto ligado:
--  * corpo denso (peso alto) em todas as partes;
--  * noclip em TODAS as partes do corpo, inclusive pés: nada encosta em você, então
--    nenhuma parte voando consegue empurrar o seu personagem;
--  * plataforma invisível sob os pés, no nível do chão (segue o terreno), para o personagem ficar em pé;
--  * parado: o corpo só se move na vertical (qualquer empurrão horizontal é desfeito);
--  * limite de altura acima do chão (o "teto"): ninguém te lança para cima;
--  * trava velocidades absurdas e desliga os estados de queda/ragdoll.
-- Obs.: o Roblox não deixa o client criar grupos de colisão (só o servidor), então não dá para os pés
-- colidirem "só com a plataforma". O personagem fica em pé porque o Humanoid detecta o chão (e a
-- plataforma) por raycast, mesmo com todas as partes sem colisão.
local apfActive = false
local antiPartFling
do
	local CEILING_HEIGHT = 14   -- altura máxima acima do chão (um pulo normal sobe ~7 studs)
	local IDLE_PUSH_SPEED = 1.5 -- parado: velocidade horizontal acima disso conta como empurrão
	local MAX_SPEED = 150       -- velocidade linear máxima
	local MAX_SPIN = 50         -- rotação máxima
	local DENSE = PhysicalProperties.new(100, 0.5, 0, 1, 1)
	local BLOCKED_STATES = {
		Enum.HumanoidStateType.Ragdoll,
		Enum.HumanoidStateType.FallingDown,
		Enum.HumanoidStateType.Physics,
	}

	local saved = {}   -- [parte] = { cc = CanCollide original, pp = propriedades físicas originais }
	local plat         -- plataforma invisível sob os pés
	local anchor       -- posição (X, Z) em que fiquei parado
	local lastBaseY    -- último nível de chão encontrado
	local supportY     -- último nível em que estive apoiado (base do "teto")
	local stateHum     -- humanoid que está com estados bloqueados

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.RespectCanCollide = true

	local function restoreAll()
		for part, s in pairs(saved) do
			if part.Parent then
				part.CanCollide = s.cc
				part.CustomPhysicalProperties = s.pp or nil
			end
			saved[part] = nil
		end
		local char = player.Character
		if char then
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") and CORE_PARTS[part.Name] then
					part.CanCollide = true
				end
			end
		end
		if stateHum then
			for _, st in ipairs(BLOCKED_STATES) do
				pcall(stateHum.SetStateEnabled, stateHum, st, true)
			end
			stateHum = nil
		end
		if plat then plat:Destroy() plat = nil end
		anchor, lastBaseY, supportY = nil, nil, nil
	end

	antiPartFling = function(on)
		for _, k in ipairs({ "apfStep", "apfBeat" }) do
			if conns[k] then conns[k]:Disconnect() conns[k] = nil end
		end
		apfActive = on
		restoreAll()
		if not on then return end

		-- plataforma invisível sob os pés (igual ao float)
		plat = Instance.new("Part")
		plat.Name = "AntiPartFlingPlatform"
		plat.Size = Vector3.new(6, 1, 6)
		plat.Anchored = true
		plat.CanCollide = true
		plat.CanQuery = false
		plat.CanTouch = false
		plat.Transparency = 1
		plat.Parent = workspace

		-- antes da física: corpo denso e sem colisão em todas as partes (pés incluídos)
		conns.apfStep = RunService.Stepped:Connect(function()
			local char = player.Character
			if not char then return end
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					if not saved[part] then
						saved[part] = { cc = part.CanCollide, pp = part.CustomPhysicalProperties or false }
						part.CustomPhysicalProperties = DENSE
					end
					part.CanCollide = false
				end
			end
		end)

		-- depois da física: plataforma, trava horizontal, teto e limites de velocidade
		conns.apfBeat = RunService.Heartbeat:Connect(function()
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not hrp or not hum or not plat then return end

			if hum ~= stateHum then -- personagem novo (ou primeiro): bloqueia queda/ragdoll
				stateHum = hum
				anchor, lastBaseY, supportY = nil, nil, nil
				for _, st in ipairs(BLOCKED_STATES) do
					pcall(hum.SetStateEnabled, hum, st, false)
				end
			end

			local pos = hrp.Position
			local standH = (hum.RigType == Enum.HumanoidRigType.R15) and (hum.HipHeight + hrp.Size.Y / 2) or 3
			local flying = flyState.fly ~= nil or flyState.vfly ~= nil or hum.SeatPart ~= nil

			-- nível do chão sob mim (se o Float está ligado, é o topo dele)
			local baseY
			if floatPart and floatY then
				baseY = floatY + 0.5
			else
				local filter = { plat }
				for _, p in ipairs(Players:GetPlayers()) do
					if p.Character then filter[#filter + 1] = p.Character end
				end
				rayParams.FilterDescendantsInstances = filter
				local hit = workspace:Raycast(pos, Vector3.new(0, -500, 0), rayParams)
				if hit then baseY = hit.Position.Y end
			end
			if baseY then lastBaseY = baseY end
			baseY = lastBaseY or (pos.Y - standH)
			lastBaseY = baseY
			plat.CFrame = CFrame.new(pos.X, baseY - 0.5, pos.Z)

			-- base do teto: último lugar em que estive apoiado (ou subindo escada)
			if hum.FloorMaterial ~= Enum.Material.Air or hum:GetState() == Enum.HumanoidStateType.Climbing then
				supportY = pos.Y - standH
			end
			supportY = supportY or (pos.Y - standH)

			if not flying then
				-- atravessou o chão? volta para cima da plataforma
				if pos.Y < baseY - 0.5 then
					hrp.CFrame = CFrame.new(pos.X, baseY + standH, pos.Z) * hrp.CFrame.Rotation
					hrp.AssemblyLinearVelocity = Vector3.zero
					pos = hrp.Position
				end

				local v = hrp.AssemblyLinearVelocity

				-- teto: não deixa subir além do limite (só corta a velocidade para cima)
				if v.Y > 0 and pos.Y > supportY + CEILING_HEIGHT then
					hrp.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
					v = hrp.AssemblyLinearVelocity
				end

				-- parado: só se move na vertical
				if hum.MoveDirection.Magnitude > 0.05 then
					anchor = nil
				else
					local hv = Vector3.new(v.X, 0, v.Z).Magnitude
					if anchor and hv > IDLE_PUSH_SPEED then
						-- empurrão: volta ao ponto onde eu estava e zera o movimento horizontal
						hrp.CFrame = CFrame.new(anchor.X, pos.Y, anchor.Z) * hrp.CFrame.Rotation
						hrp.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
						hrp.AssemblyAngularVelocity = Vector3.zero
					else
						-- (teleportes feitos por mim são aceitos: o ponto fixo passa a ser o novo lugar)
						anchor = Vector3.new(pos.X, 0, pos.Z)
						if hv > 0 then hrp.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0) end
					end
				end

				-- velocidade ou giro absurdos: zera
				if hrp.AssemblyLinearVelocity.Magnitude > MAX_SPEED
					or hrp.AssemblyAngularVelocity.Magnitude > MAX_SPIN then
					hrp.AssemblyLinearVelocity = Vector3.zero
					hrp.AssemblyAngularVelocity = Vector3.zero
				end
			else
				anchor = nil
			end
		end)
	end
end


