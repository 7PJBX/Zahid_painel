	nameL.TextSize = 13
	nameL.TextXAlignment = Enum.TextXAlignment.Left
	nameL.TextYAlignment = Enum.TextYAlignment.Center
	nameL.TextTruncate = Enum.TextTruncate.AtEnd
	nameL.Position = UDim2.fromOffset(10, 5)
	nameL.Size = UDim2.new(1, -78, 0, 16)
	nameL.Text = name
	nameL.Parent = row

	local descL = Instance.new("TextLabel")
	descL.BackgroundTransparency = 1
	descL.Font = FONT
	descL.TextSize = 11
	descL.TextWrapped = true
	descL.TextXAlignment = Enum.TextXAlignment.Left
	descL.TextYAlignment = Enum.TextYAlignment.Top
	descL.Position = UDim2.fromOffset(10, 22)
	descL.Size = UDim2.new(1, -78, 0, 28)
	descL.Text = desc
	descL.Parent = row

	onTheme(function()
		nameL.TextColor3 = T.text
		descL.TextColor3 = T.textDim
	end)

	local obj = { frame = row, nameLabel = nameL, descLabel = descL, base = desc, isOn = false }
	local flashToken = 0

	-- mostra uma mensagem no lugar da descrição por um instante
	function obj.flash(text, colorKey)
		flashToken += 1
		local mine = flashToken
		descL.Text = text
		descL.TextColor3 = T[colorKey or "text"]
		task.delay(1.6, function()
			if flashToken == mine then
				descL.Text = obj.base
				descL.TextColor3 = T.textDim
			end
		end)
	end
	-- troca a descrição de verdade
	function obj.setBase(text)
		obj.base = text
		flashToken += 1
		descL.Text = text
		descL.TextColor3 = T.textDim
	end
	function obj.setName(text) nameL.Text = text end

	if kind == "switch" then
		local face = Instance.new("TextButton")
		face.BackgroundTransparency = 1
		face.Size = UDim2.fromScale(1, 1)
		face.Text = ""
		face.AutoButtonColor = false
		face.Parent = row

		local track = Instance.new("Frame")
		track.AnchorPoint = Vector2.new(1, 0.5)
		track.Position = UDim2.new(1, -10, 0.5, 0)
		track.Size = UDim2.fromOffset(42, 24)
		track.BorderSizePixel = 0
		track.Parent = row
		Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
		local knob = Instance.new("Frame")
		knob.Size = UDim2.fromOffset(18, 18)
		knob.Position = UDim2.new(0, 3, 0.5, -9)
		knob.BackgroundColor3 = Color3.fromRGB(246, 246, 250)
		knob.BorderSizePixel = 0
		knob.Parent = track
		Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

		onTheme(function() track.BackgroundColor3 = obj.isOn and T.good or T.trackOff end)
		function obj.setOn(on)
			obj.isOn = on
			tween(track, 0.18, { BackgroundColor3 = on and T.good or T.trackOff })
			tween(knob, 0.2, { Position = on and UDim2.new(0, 21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9) }, Enum.EasingStyle.Back)
		end
		face.InputBegan:Connect(function(input)
			if isPress(input) then playSfx() end
		end)
		obj.face = face
	else
		local btn = new3DButton(row, btnText or "usar", UDim2.new(1, -66, 0.5, -15), UDim2.fromOffset(56, 30), role or "Off")
		btn.face.TextSize = 12
		obj.btn = btn
		obj.face = btn.face
		function obj.setOn(on) btn.setOn(on) end
	end
	return obj
end

