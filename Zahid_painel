				for _, a in ipairs(accs) do
					if type(a.AssetId) == "number" and a.AssetId ~= 0 then
						local kind = (tostring(a.AccessoryType):gsub("^Enum%.AccessoryType%.", ""))
						table.insert(items, { id = a.AssetId, kind = kind })
					end
				end
			end
			local singles = {
				{ "Shirt", "Camisa" }, { "Pants", "Calça" }, { "GraphicTShirt", "Camiseta" }, { "Face", "Rosto" },
				{ "Head", "Cabeça" }, { "Torso", "Torso" }, { "LeftArm", "Braço esquerdo" }, { "RightArm", "Braço direito" },
				{ "LeftLeg", "Perna esquerda" }, { "RightLeg", "Perna direita" },
			}
			for _, s in ipairs(singles) do
				local id = desc[s[1]]
				if type(id) == "number" and id ~= 0 then table.insert(items, { id = id, kind = s[2] }) end
			end
			if #items == 0 then
				detailLabel.Text = "Nenhum item público no avatar."
				return
			end

			-- destaca um acessório: o resto do avatar fica meio transparente
			local origTransp = {}
			local selectedItem = nil
			local function restoreModel()
				for part, t in pairs(origTransp) do
					if part.Parent then part.Transparency = t end
				end
				origTransp = {}
			end
			local function findAccessory(name)
				if not model or not name then return nil end
				local lower = string.lower(name)
				for _, d in ipairs(model:GetChildren()) do
					if d:IsA("Accessory") and string.find(string.lower(d.Name), lower, 1, true) then return d end
				end
				return nil
			end
			local function isolate(acc)
				restoreModel()
				if not model or not acc then return end
				for _, d in ipairs(model:GetDescendants()) do
					if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and not d:IsDescendantOf(acc) then
						origTransp[d] = d.Transparency
						d.Transparency = math.max(d.Transparency, 0.8)
					end
				end
			end

			local function updateTotal()
				local sum, priced, unknown = 0, 0, 0
				for _, it in ipairs(items) do
					if it.loaded then
						if type(it.price) == "number" then
							sum += it.price
							priced += 1
						else
							unknown += 1
						end
					end
				end
				totalLabel.Text = "Valor da roupa (preço de loja): R$ " .. commas(sum)
					.. (unknown > 0 and ("\n" .. unknown .. " item(ns) sem preço") or "")
			end

			for i, it in ipairs(items) do
				local row = new3DButton(itemsHolder, it.kind .. " ...", UDim2.new(), UDim2.new(1, 0, 0, 38), "Off")
				row.face.TextSize = 11
				row.face.TextXAlignment = Enum.TextXAlignment.Left
				mkPadding(row.face, 38, 0, 4, 0)
				local img = Instance.new("ImageLabel")
				img.Size = UDim2.fromOffset(26, 26)
				img.Position = UDim2.new(0, -32, 0.5, -13)
				img.BackgroundTransparency = 1
				img.Image = string.format("rbxthumb://type=Asset&id=%d&w=60&h=60", it.id)
				img.Parent = row.face
				Instance.new("UICorner", img).CornerRadius = UDim.new(0, 6)
				it.row = row

				row.face.Activated:Connect(function()
					if selectedItem == it then
						selectedItem = nil
						restoreModel()
						detailLabel.Text = "Toque em um item para ver os detalhes e destacá-lo no avatar."
						return
					end
					selectedItem = it
					isolate(findAccessory(it.name))
					local priceText = type(it.price) == "number" and ("R$ " .. commas(it.price)) or "sem preço de loja"
					detailLabel.Text = string.format("%s\nTipo: %s\nCriador: %s\nPreço: %s%s\nID: %d",
						it.name or "?", it.kind, it.creator or "?", priceText, it.limited and " (limitado)" or "", it.id)
				end)

				task.spawn(function()
					task.wait((i - 1) * 0.07) -- espaça os pedidos para não estourar o limite da loja
					local okInfo, info = pcall(function()
						return MarketplaceService:GetProductInfo(it.id, Enum.InfoType.Asset)
					end)
					if my ~= token then return end
					it.loaded = true
					if okInfo and type(info) == "table" then
						it.name = info.Name
						it.price = info.PriceInRobux
						it.creator = info.Creator and info.Creator.Name
						it.limited = info.IsLimited or info.IsLimitedUnique
					end
					local priceShort = type(it.price) == "number" and ("R$ " .. commas(it.price)) or "-"
					row.face.Text = string.format("%s: %s | %s", it.kind, it.name or "?", priceShort)
					updateTotal()
				end)
			end
		end)
	end
end

