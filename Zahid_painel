-- ===== EXPLORAR SERVIDORES (janela) =====
-- Até 5 servidores por página, com jogadores, ping e fotos; filtros por jogadores e ping; botões de página embaixo.
do
	local PAGE_SIZE = 5
	local BR_W = math.min(440, viewport.X - 16)
	local BR_H = math.min(340, viewport.Y - 16)

	local popup = mkWindowFrame(gui)
	popup.Name = "Servidores"
	popup.Size = UDim2.fromOffset(BR_W, BR_H)
	popup.AnchorPoint = Vector2.new(0.5, 0.5)
	popup.Position = UDim2.fromScale(0.5, 0.5)
	popup.ZIndex = 25
	popup.Visible = false
	local popScale = Instance.new("UIScale")
	popScale.Parent = popup

	local title = mkLabel(popup, "Servidores deste jogo", 15, "text")
	title.Font = FONT_BOLD
	title.Position = UDim2.fromOffset(12, 10)
	title.Size = UDim2.new(1, -96, 0, 20)
	local closeB = new3DButton(popup, "fechar", UDim2.new(1, -78, 0, 6), UDim2.fromOffset(70, 28), "Danger")
	closeB.face.TextSize = 12

	-- filtros: [-] valor [+]
	local minPlayers, maxPing = 0, 0     -- 0 = sem filtro
	local servers, filtered = {}, {}
	local page, loading = 1, false
	local render

	local function stepper(x, y, w, getText, change)
		local label = mkPanel(popup, "field", 8)
		label.Position = UDim2.fromOffset(x + 34, y)
		label.Size = UDim2.fromOffset(w - 68, 24)
		local txt = mkLabel(label, "", 12, "text", Enum.TextXAlignment.Center)
		txt.Size = UDim2.fromScale(1, 1)
		txt.TextYAlignment = Enum.TextYAlignment.Center
		local minus = new3DButton(popup, "-", UDim2.fromOffset(x, y), UDim2.fromOffset(30, 28), "Off")
		local plus = new3DButton(popup, "+", UDim2.fromOffset(x + w - 30, y), UDim2.fromOffset(30, 28), "Off")
		local function refreshText() txt.Text = getText() end
		minus.face.Activated:Connect(function() change(-1) refreshText() end)
		plus.face.Activated:Connect(function() change(1) refreshText() end)
		refreshText()
		return refreshText
	end

	local halfW = math.floor((BR_W - 36) / 2)
	local function applyFilters()
		filtered = {}
		for _, s in ipairs(servers) do
			if s.playing >= minPlayers and (maxPing == 0 or (s.ping and s.ping <= maxPing)) then
				table.insert(filtered, s)
			end
		end
		table.sort(filtered, function(a, b)
			if a.playing ~= b.playing then return a.playing > b.playing end
			return (a.ping or math.huge) < (b.ping or math.huge)
		end)
		page = 1
	end
	stepper(12, 40, halfW, function() return minPlayers == 0 and "jogadores: todos" or ("mín. " .. minPlayers .. " jogadores") end,
		function(d)
			minPlayers = math.clamp(minPlayers + d, 0, 60)
			applyFilters()
			render()
		end)
	stepper(18 + halfW, 40, halfW, function() return maxPing == 0 and "ping: livre" or ("ping até " .. maxPing .. " ms") end,
		function(d)
			maxPing = math.clamp(maxPing + d * 25, 0, 500)
			applyFilters()
			render()
		end)

	local refreshBtn = new3DButton(popup, "refresh", UDim2.fromOffset(12, 76), UDim2.fromOffset(86, 30), "Net")
	refreshBtn.face.TextSize = 13
	local statusLabel = mkLabel(popup, "", 12, "textDim", Enum.TextXAlignment.Left)
	statusLabel.Position = UDim2.fromOffset(106, 82)
	statusLabel.Size = UDim2.new(1, -118, 0, 18)
	statusLabel.TextYAlignment = Enum.TextYAlignment.Center

	local list = mkScroll(popup)
	list.Position = UDim2.fromOffset(8, 112)
	list.Size = UDim2.new(1, -16, 1, -156)
	mkList(list, 6)
	mkPadding(list, 0, 0, 6, 4)

	local prevBtn = new3DButton(popup, "< anterior", UDim2.new(0, 12, 1, -38), UDim2.fromOffset(100, 32), "Off")
	local nextBtn = new3DButton(popup, "próxima >", UDim2.new(1, -112, 1, -38), UDim2.fromOffset(100, 32), "Off")
	prevBtn.face.TextSize = 12
	nextBtn.face.TextSize = 12
	local pageLabel = mkLabel(popup, "", 12, "text", Enum.TextXAlignment.Center)
	pageLabel.Position = UDim2.new(0, 116, 1, -30)
	pageLabel.Size = UDim2.new(1, -232, 0, 18)
	pageLabel.TextYAlignment = Enum.TextYAlignment.Center

	local function pageCount()
		return math.max(1, math.ceil(#filtered / PAGE_SIZE))
	end

	-- uma linha por servidor: jogadores/ping, fotos (clicáveis) e o botão entrar
	local function addRow(s)
		local isCurrent = (s.id == game.JobId)
		local row = Instance.new("Frame") -- (sem registrar no tema: a lista é refeita ao trocar de tema)
		row.BackgroundColor3 = T.card
		row.BorderSizePixel = 0
		row.Size = UDim2.new(1, 0, 0, 64)
		row.Parent = list
		Instance.new("UICorner", row).CornerRadius = UDim.new(0, 10)

		local info = Instance.new("TextLabel")
		info.BackgroundTransparency = 1
		info.Font = FONT
		info.TextSize = 12
		info.TextColor3 = T.text
		info.TextXAlignment = Enum.TextXAlignment.Left
		info.TextYAlignment = Enum.TextYAlignment.Top
		info.Position = UDim2.fromOffset(8, 6)
		info.Size = UDim2.new(1, -90, 0, 30)
		info.Text = string.format("%d/%d jogadores%s\nping %s | fps %s", s.playing, s.maxPlayers,
			isCurrent and "  (atual)" or "",
			s.ping and (math.floor(s.ping) .. " ms") or "?", s.fps and tostring(math.floor(s.fps)) or "?")
		info.Parent = row

		local joinBtn = new3DButton(row, isCurrent and "aqui" or "entrar", UDim2.new(1, -76, 0, 6), UDim2.fromOffset(68, 30), "Net")
		joinBtn.face.TextSize = 12
		joinBtn.face.Activated:Connect(function()
			if isCurrent then return end
			joinBtn.face.Text = "..."
			local ok = pcall(function()
				TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, player)
			end)
			task.delay(ok and 8 or 1.5, function()
				if joinBtn.face.Parent then joinBtn.face.Text = ok and "entrar" or "Falhou" end
			end)
		end)

		-- fotos: no servidor atual dá para abrir o perfil; nos outros o Roblox só informa fotos anônimas
		local slots = {}
		if isCurrent then
			for _, p in ipairs(Players:GetPlayers()) do
				if #slots >= 8 then break end
				table.insert(slots, { userId = p.UserId, plr = p })
			end
		else
			for i, tok in ipairs(s.tokens) do
				if i > 8 then break end
				table.insert(slots, { token = tok })
			end
		end
		for i, sl in ipairs(slots) do
			local b = Instance.new("ImageButton")
			b.Size = UDim2.fromOffset(26, 26)
			b.Position = UDim2.fromOffset(8 + (i - 1) * 30, 36)
			b.BackgroundColor3 = T.field
			b.BorderSizePixel = 0
			b.AutoButtonColor = true
			b.Parent = row
			Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
			if sl.userId then
				b.Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48", sl.userId)
			else
				task.spawn(function()
					local asset = tokenAvatarAsset(sl.token)
					if asset and b.Parent then b.Image = asset end
				end)
			end
			b.Activated:Connect(function()
				if sl.userId then
					openProfile(sl.userId, sl.plr)
				else
					statusLabel.Text = "Perfil indisponível: o Roblox não informa quem está em outros servidores."
				end
			end)
		end
	end

	function render()
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end
		local total = pageCount()
		page = math.clamp(page, 1, total)
		local first = (page - 1) * PAGE_SIZE + 1
		for i = first, math.min(first + PAGE_SIZE - 1, #filtered) do
			addRow(filtered[i])
		end
		list.CanvasPosition = Vector2.zero
		pageLabel.Text = string.format("página %d de %d", page, total)
		if not loading then
			statusLabel.Text = string.format("%d servidores (%d após os filtros)", #servers, #filtered)
		end
	end

	local function refresh()
		if loading then return end
		loading = true
		statusLabel.Text = "Carregando servidores..."
		task.spawn(function()
			local list2, reached = fetchServers(3)
			loading = false
			servers = list2
			applyFilters()
			render()
			if not reached then
				statusLabel.Text = "Sem acesso à lista (o executor não faz requisições?)."
			end
		end)
	end

	refreshBtn.face.Activated:Connect(refresh)
	prevBtn.face.Activated:Connect(function()
		page = math.max(1, page - 1)
		render()
	end)
	nextBtn.face.Activated:Connect(function()
		page = math.min(pageCount(), page + 1)
		render()
	end)

	local function closePopup()
		popup.Visible = false
	end
	closeB.face.Activated:Connect(closePopup)
	conns.browser = { Disconnect = closePopup }
	table.insert(themeRefreshers, function() if popup.Visible then render() end end)

	openServerBrowser = function()
		popup.Visible = true
		popScale.Scale = 0.85
		tween(popScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		if #servers == 0 then refresh() else render() end
	end
end

