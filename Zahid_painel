	prevBtn.face.TextSize = 12
	nextBtn.face.TextSize = 12
	local pageLabel = mkLabel(body, "", 12, "text", Enum.TextXAlignment.Center)
	pageLabel.Position = UDim2.new(0, 116, 1, -30)
	pageLabel.Size = UDim2.new(1, -232, 0, 18)
	pageLabel.TextYAlignment = Enum.TextYAlignment.Center

	local function pageCount()
		return math.max(1, math.ceil(#filtered / PAGE_SIZE))
	end

	-- mensagem dentro da lista (nada encontrado, erro...)
	local function listMessage(text)
		local holder = Instance.new("Frame")
		holder.BackgroundTransparency = 1
		holder.Size = UDim2.new(1, 0, 0, 56)
		holder.Parent = list
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Size = UDim2.fromScale(1, 1)
