-- ===== ARRASTAR O BOTÃO: não sai da tela; se passar da borda, volta com efeito mola =====
local dragging, dragInput, dragStart = false, nil, nil
local startBx, startBy, moved = 0, 0, false

local function bubbleBounds()
	local screen = gui.AbsoluteSize
	return MARGIN, MARGIN, math.max(MARGIN, screen.X - BUBBLE - MARGIN), math.max(MARGIN, screen.Y - BUBBLE - MARGIN)
end

-- além da borda ele "estica" só um pouco, como um elástico
local function rubber(v, lo, hi)
	if v < lo then return lo + (v - lo) * 0.35 end
	if v > hi then return hi + (v - hi) * 0.35 end
	return v
end

bubble.InputBegan:Connect(function(input)
	if isPress(input) then
		dragging = true
		dragInput = input
		dragStart = input.Position
		startBx, startBy = bx, by
		moved = false
	end
end)

UIS.InputChanged:Connect(function(input)
	if not dragging then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or (input.UserInputType == Enum.UserInputType.Touch and input == dragInput) then
		local d = input.Position - dragStart
		if d.Magnitude > 6 then moved = true end
		if moved then
			local minX, minY, maxX, maxY = bubbleBounds()
			bx = rubber(startBx + d.X, minX, maxX)
			by = rubber(startBy + d.Y, minY, maxY)
			bubble.Position = UDim2.fromOffset(bx, by)
			if windowOpen then placeWindow() end
		end
	end
end)

UIS.InputEnded:Connect(function(input)
	if not dragging then return end
	if isPress(input) and (input.UserInputType == Enum.UserInputType.MouseButton1 or input == dragInput) then
		dragging = false
		if not moved then
			setWindow(not windowOpen) -- foi um toque: abre/fecha o menu
			return
		end
		local minX, minY, maxX, maxY = bubbleBounds()
		local cx, cy = math.clamp(bx, minX, maxX), math.clamp(by, minY, maxY)
		if cx ~= bx or cy ~= by then
			-- passou da borda: volta com efeito mola
			bx, by = cx, cy
			tween(bubble, 0.6, { Position = UDim2.fromOffset(cx, cy) }, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
			task.spawn(function()
				local t0 = os.clock()
				while os.clock() - t0 < 0.7 do
					if windowOpen then placeWindow() end
					task.wait()
				end
			end)
		end
	end
end)

-- se o tamanho da tela mudar (girar o celular), o botão volta para dentro dela
gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
	local minX, minY, maxX, maxY = bubbleBounds()
	bx, by = math.clamp(bx, minX, maxX), math.clamp(by, minY, maxY)
	tween(bubble, 0.5, { Position = UDim2.fromOffset(bx, by) }, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
	if windowOpen then placeWindow() end
end)

