local SETTINGS_FILE = "ZahidPainel_config.json"
local PLAYTIME_FILE = "ZahidPainel_tempo.json"
local settings = { theme = "dark", sound = "click", soundOn = true }
local hasFS = (writefile and readfile and isfile) ~= nil

local function loadJson(file)
	if not hasFS then return nil end
	local ok, data = pcall(function()
		if not isfile(file) then return nil end
		return HttpService:JSONDecode(readfile(file))
	end)
	if ok and type(data) == "table" then return data end
	return nil
end

local function saveJson(file, data)
	if not hasFS then return end
	pcall(function() writefile(file, HttpService:JSONEncode(data)) end)
end

local function esc(s)
	s = tostring(s or "")
	s = s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
	return s
end

-- API do Roblox (tenta direto e depois por proxy, que costuma passar quando o direto é bloqueado)
local function apiJson(url)
	local function try(u)
		local body = httpGetBody(u)
		if not body then return nil end
		local ok, d = pcall(function() return HttpService:JSONDecode(body) end)
		if ok and type(d) == "table" and not d.errors then return d end
		return nil
	end
	local d = try(url)
	if d then return d end
	return try((url:gsub("roblox%.com", "roproxy.com")))
end

