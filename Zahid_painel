-- faz a requisição HTTP (usa o que o executor oferecer)
local function httpGetBody(url)
	local reqFn = request or http_request or (syn and syn.request)
	if reqFn then
		local ok, res = pcall(reqFn, { Url = url, Method = "GET" })
		if ok and res and res.Body then return res.Body end
	end
	local ok, body = pcall(function() return game:HttpGet(url) end)
	if ok then return body end
	return nil
end

-- procura um servidor público com no mínimo 6 jogadores e o menor ping
local MIN_PLAYERS = 6
local function findOtherServer()
	local best, bestPing = nil, math.huge
	local cursor = nil
	for _ = 1, 3 do -- até 3 páginas de 100 servidores (do mais cheio para o menos cheio)
		local url = "https://games.roblox.com/v1/games/" .. game.PlaceId
			.. "/servers/Public?sortOrder=Desc&excludeFullGames=true&limit=100"
		if cursor then url = url .. "&cursor=" .. cursor end

		local body = httpGetBody(url)
		if not body then break end
		local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
		if not ok or type(data) ~= "table" or type(data.data) ~= "table" then break end

		local lastPlaying = math.huge
		for _, s in ipairs(data.data) do
			if type(s.playing) == "number" then lastPlaying = s.playing end
			if s.id ~= game.JobId and type(s.playing) == "number" and type(s.maxPlayers) == "number"
				and s.playing >= MIN_PLAYERS and s.playing < s.maxPlayers - 1 then
				local ping = type(s.ping) == "number" and s.ping or math.huge
				if best == nil or ping < bestPing then
					best, bestPing = s.id, ping
				end
			end
		end

		if lastPlaying < MIN_PLAYERS then break end -- as próximas páginas só têm servidores menores que isso
		if type(data.nextPageCursor) ~= "string" then break end
		cursor = data.nextPageCursor
	end
	return best
end

-- entra em outro servidor; devolve true se o teleporte foi iniciado, ou false e o motivo
local function serverHop()
	local id = findOtherServer()
	if not id then return false, "Sem servidor 6+" end
	local ok = pcall(function()
		TeleportService:TeleportToPlaceInstance(game.PlaceId, id, player)
	end)
	if not ok then return false, "Falhou" end
	return true
end

-- ===== SERVIDOR ANTERIOR (botão "voltar") =====
-- Cada vez que o script abre em um servidor, o servidor em que ele estava antes (guardado no arquivo)
-- vira o "último". O botão "voltar" teleporta para ele.
local SERVERS_FILE = "ZahidPainel_servidores.json"
local serversState = { current = nil, last = nil } -- cada um: { placeId, jobId }

local function serversSave()
	if not writefile then return end
	pcall(function() writefile(SERVERS_FILE, HttpService:JSONEncode(serversState)) end)
end

do
	local function valid(s)
		return type(s) == "table" and type(s.placeId) == "number" and type(s.jobId) == "string"
	end
	if readfile and isfile then
		local ok, data = pcall(function()
			if not isfile(SERVERS_FILE) then return nil end
			return HttpService:JSONDecode(readfile(SERVERS_FILE))
		end)
		if ok and type(data) == "table" then
			if valid(data.last) then serversState.last = data.last end
			if valid(data.current) then serversState.current = data.current end
		end
	end
	-- se o servidor "atual" do arquivo é outro, é de lá que eu vim
	if serversState.current and serversState.current.jobId ~= game.JobId then
		serversState.last = serversState.current
	end
	serversState.current = { placeId = game.PlaceId, jobId = game.JobId }
	serversSave()
end

-- volta para o último servidor em que eu estava; devolve true se o teleporte foi iniciado, ou false e o motivo
local function backServer()
	local s = serversState.last
	if not s then return false, "Sem servidor anterior" end
	local ok = pcall(function()
		TeleportService:TeleportToPlaceInstance(s.placeId, s.jobId, player)
	end)
	if not ok then return false, "Falhou" end
	return true
end

-- ===== AUTO FARM: POSIÇÃO FIXA + USO CONTÍNUO + RECONEXÃO =====
-- "Definir posição" guarda onde você está. "Auto farm" (ligado):
--  * se o jogo te teleportar ou você morrer, volta para a posição definida;
--  * usa a ferramenta da mão a cada 5 segundos (se não houver, equipa a do slot 2);
--  * se a conexão cair (erro 277 etc.), tenta reconectar sozinho; ao voltar,
--    o estado é restaurado (posição, auto farm ligado e ferramenta do slot 2).
-- Para restaurar depois de reconectar, o script precisa rodar de novo no novo servidor:
--  * o link do script está em SCRIPT_URL (ele precisa conter esta versão do script), OU salve este
--    script com o nome de SCRIPT_FILE na pasta workspace do executor (deixando SCRIPT_URL vazio),
--    OU deixe-o na pasta autoexec (e use USE_QUEUE = false).
