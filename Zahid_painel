-- faz a requisição HTTP (usa o que o executor oferecer)
local function httpGetBody(url)
	local reqFn = request or http_request or (syn and syn.request)
	if reqFn then
		local ok, res = pcall(reqFn, { Url = url, Method = "GET" })
		if ok and res and res.Body then return res.Body end
	end
	local ok, body = pcall(function() return game:HttpGet(url) end)
	if ok then return body end
	return nil
end

-- procura um servidor público com no mínimo 6 jogadores e o menor ping
local MIN_PLAYERS = 6
local function findOtherServer()
	local best, bestPing = nil, math.huge
	local cursor = nil
	for _ = 1, 3 do -- até 3 páginas de 100 servidores (do mais cheio para o menos cheio)
		local url = "https://games.roblox.com/v1/games/" .. game.PlaceId
			.. "/servers/Public?sortOrder=Desc&excludeFullGames=true&limit=100"
		if cursor then url = url .. "&cursor=" .. cursor end

		local body = httpGetBody(url)
		if not body then break end
		local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
		if not ok or type(data) ~= "table" or type(data.data) ~= "table" then break end

		local lastPlaying = math.huge
		for _, s in ipairs(data.data) do
			if type(s.playing) == "number" then lastPlaying = s.playing end
			if s.id ~= game.JobId and type(s.playing) == "number" and type(s.maxPlayers) == "number"
				and s.playing >= MIN_PLAYERS and s.playing < s.maxPlayers - 1 then
				local ping = type(s.ping) == "number" and s.ping or math.huge
				if best == nil or ping < bestPing then
					best, bestPing = s.id, ping
				end
			end
		end

		if lastPlaying < MIN_PLAYERS then break end -- as próximas páginas só têm servidores menores que isso
		if type(data.nextPageCursor) ~= "string" then break end
		cursor = data.nextPageCursor
	end
	return best
end

-- entra em outro servidor; devolve true se o teleporte foi iniciado, ou false e o motivo
local function serverHop()
	local id = findOtherServer()
	if not id then return false, "Sem servidor 6+" end
	local ok = pcall(function()
		TeleportService:TeleportToPlaceInstance(game.PlaceId, id, player)
	end)
	if not ok then return false, "Falhou" end
	return true
end

-- ===== SERVIDOR ANTERIOR (botão "voltar") =====
-- Cada vez que o script abre em um servidor, o servidor em que ele estava antes (guardado no arquivo)
-- vira o "último". O botão "voltar" teleporta para ele.
local SERVERS_FILE = "ZahidPainel_servidores.json"
local serversState = { current = nil, last = nil } -- cada um: { placeId, jobId }

local function serversSave()
	if not writefile then return end
	pcall(function() writefile(SERVERS_FILE, HttpService:JSONEncode(serversState)) end)
end

do
	local function valid(s)
		return type(s) == "table" and type(s.placeId) == "number" and type(s.jobId) == "string"
	end
	if readfile and isfile then
		local ok, data = pcall(function()
			if not isfile(SERVERS_FILE) then return nil end
			return HttpService:JSONDecode(readfile(SERVERS_FILE))
		end)
		if ok and type(data) == "table" then
			if valid(data.last) then serversState.last = data.last end
			if valid(data.current) then serversState.current = data.current end
		end
	end
	-- se o servidor "atual" do arquivo é outro, é de lá que eu vim
	if serversState.current and serversState.current.jobId ~= game.JobId then
		serversState.last = serversState.current
	end
	serversState.current = { placeId = game.PlaceId, jobId = game.JobId }
	serversSave()
end

-- volta para o último servidor em que eu estava; devolve true se o teleporte foi iniciado, ou false e o motivo
local function backServer()
	local s = serversState.last
	if not s then return false, "Sem servidor anterior" end
	local ok = pcall(function()
		TeleportService:TeleportToPlaceInstance(s.placeId, s.jobId, player)
	end)
	if not ok then return false, "Falhou" end
	return true
end

-- ===== EXPLORAR SERVIDORES (dados) =====
-- requisição com corpo (POST etc.); devolve o corpo da resposta ou nil
local function httpRequestBody(method, url, body, headers)
	local reqFn = request or http_request or (syn and syn.request)
	if not reqFn then return nil end
	local ok, res = pcall(reqFn, { Url = url, Method = method, Body = body, Headers = headers })
	if ok and res and res.Body then return res.Body end
	return nil
end

-- baixa um JSON por GET e já decodifica (nil se falhar)
local function httpGetJson(url)
	local body = httpGetBody(url)
	if not body then return nil end
	local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
	if ok and type(data) == "table" then return data end
	return nil
end

-- lista os servidores públicos do jogo atual (até maxPages de 100). Devolve a lista, se a internet do executor funcionou
-- e, se deu erro, a mensagem. Cada item: { id, playing, maxPlayers, ping, fps, tokens }
local function fetchServers(maxPages)
	local list = {}
	local cursor = nil
	local reached = false
	local errMsg = nil
	for _ = 1, maxPages or 3 do
		local url = "https://games.roblox.com/v1/games/" .. game.PlaceId
			.. "/servers/Public?sortOrder=Desc&excludeFullGames=false&limit=100"
		if cursor then url = url .. "&cursor=" .. cursor end
		local data = httpGetJson(url)
		if not data then
			if not reached then errMsg = "sem resposta (o executor não conseguiu fazer a requisição)" end
			break
		end
		if type(data.errors) == "table" and data.errors[1] then
			errMsg = tostring(data.errors[1].message or "erro da API")
			break
		end
		if type(data.data) ~= "table" then break end
		reached = true
		for _, s in ipairs(data.data) do
			if type(s.id) == "string" and type(s.playing) == "number" and type(s.maxPlayers) == "number" then
				table.insert(list, {
					id = s.id,
					playing = s.playing,
					maxPlayers = s.maxPlayers,
					ping = type(s.ping) == "number" and s.ping or nil,
					fps = type(s.fps) == "number" and s.fps or nil,
					tokens = type(s.playerTokens) == "table" and s.playerTokens or {},
				})
			end
		end
		if type(data.nextPageCursor) ~= "string" then break end
		cursor = data.nextPageCursor
	end
	return list, reached, errMsg
end

-- foto (rosto) de um jogador de OUTRO servidor, pelo token anônimo que a API devolve.
-- Precisa de requisição, writefile e getcustomasset do executor; devolve o caminho do asset ou nil
local avatarCache = {} -- [token] = asset
local function tokenAvatarAsset(token)
	if avatarCache[token] ~= nil then return avatarCache[token] or nil end
	avatarCache[token] = false
	if not (writefile and getcustomasset) then return nil end
	local payload = HttpService:JSONEncode({ {
		requestId = "a",
		token = token,
		type = "AvatarHeadShot",
		size = "48x48",
		format = "png",
		isCircular = false,
	} })
	local body = httpRequestBody("POST", "https://thumbnails.roblox.com/v1/batch", payload,
		{ ["Content-Type"] = "application/json" })
	if not body then return nil end
	local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
	local url = ok and type(data) == "table" and type(data.data) == "table" and data.data[1] and data.data[1].imageUrl
	if type(url) ~= "string" or url == "" then return nil end
	local bytes = httpRequestBody("GET", url)
	if not bytes then return nil end
	local file = "zahid_av_" .. string.sub(HttpService:GenerateGUID(false), 1, 8) .. ".png"
	local ok2, asset = pcall(function()
		writefile(file, bytes)
		return getcustomasset(file)
	end)
	if ok2 and type(asset) == "string" then
		avatarCache[token] = asset
		return asset
	end
	return nil
end

-- ===== AUTO FARM: POSIÇÃO FIXA + USO CONTÍNUO + RECONEXÃO =====
-- "Definir posição" guarda onde você está. "Auto farm" (ligado):
--  * se o jogo te teleportar ou você morrer, volta para a posição definida;
--  * usa a ferramenta da mão a cada 5 segundos (se não houver, equipa a do slot 2);
--  * se a conexão cair (erro 277 etc.), tenta reconectar sozinho; ao voltar,
--    o estado é restaurado (posição, auto farm ligado e ferramenta do slot 2).
-- Para restaurar depois de reconectar, o script precisa rodar de novo no novo servidor:
--  * o link do script está em SCRIPT_URL (ele precisa conter esta versão do script), OU salve este
--    script com o nome de SCRIPT_FILE na pasta workspace do executor (deixando SCRIPT_URL vazio),
--    OU deixe-o na pasta autoexec (e use USE_QUEUE = false).
local GuiService = game:GetService("GuiService")

local FARM_FILE = "ZahidPainel_farm.json" -- onde a posição e o estado ficam salvos
local SCRIPT_FILE = "Zahid_painel.lua"    -- nome deste script na pasta workspace do executor
local SCRIPT_URL = "https://raw.githubusercontent.com/7PJBX/Zahid_painel/refs/heads/main/Zahid_painel" -- link (raw) do script
local USE_QUEUE = true                    -- false se o script já roda sozinho pela pasta autoexec
local TELEPORT_JUMP = 15                  -- deslocamento em 1 frame (studs) que conta como teleporte
local USE_INTERVAL = 5                    -- segundos entre cada uso da ferramenta
local FARM_ANTIFLING_ON_RELOG = true   -- depois de relogar (queda de internet), já deixa o AntiFling ligado

local farmOn = false
local farmCFrame = nil       -- posição definida
local farmToolName = nil     -- ferramenta que está sendo usada
local farmLastPos = nil
local farmLastReturn = 0
local farmLastUse = 0
local farmLastEquip = 0
local farmGoToken = 0
local farmQueued = false
local farmReconnecting = false

local function farmRoot()
	return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end

-- salva posição e estado em arquivo (se o executor tiver writefile)
local function farmSave()
	if not writefile then return end
	local data = { placeId = game.PlaceId, active = farmOn }
	if farmCFrame then data.cf = { farmCFrame:GetComponents() } end
	pcall(function()
		writefile(FARM_FILE, HttpService:JSONEncode(data))
	end)
end

local function farmLoad()
	if not (readfile and isfile) then return nil end
	local ok, data = pcall(function()
		if not isfile(FARM_FILE) then return nil end
		return HttpService:JSONDecode(readfile(FARM_FILE))
	end)
	if ok and type(data) == "table" and data.placeId == game.PlaceId then return data end
	return nil
end

-- pede ao executor para rodar este script de novo depois do teleporte de reconexão
local function farmQueueSelf()
	if farmQueued or not USE_QUEUE then return end
	local q = queue_on_teleport or (syn and syn.queue_on_teleport)
	if not q then return end
	local code
	if SCRIPT_URL ~= "" then
		code = 'loadstring(game:HttpGet("' .. SCRIPT_URL .. '"))()'
	else
		code = 'loadstring(readfile("' .. SCRIPT_FILE .. '"))()'
	end
	if pcall(q, code) then farmQueued = true end
end

-- vai para a posição definida (repete por uns segundos, pois o jogo também posiciona o personagem)
local function farmGoTo()
	farmGoToken += 1
	local token = farmGoToken
	task.spawn(function()
		local char = player.Character or player.CharacterAdded:Wait()
		local hrp = char:WaitForChild("HumanoidRootPart", 10)
		if not hrp then return end
		for _ = 1, 20 do
			if not farmOn or farmGoToken ~= token or not hrp.Parent then return end
			hrp.CFrame = farmCFrame
			hrp.AssemblyLinearVelocity = Vector3.zero
			farmLastPos = nil
			task.wait(0.15)
		end
	end)
end

-- equipa a ferramenta usada antes; se não achar, a do slot 2 (ordem da mochila)
local function farmEquip()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not hum or not backpack or hum.Health <= 0 then return end

	local tool = farmToolName and backpack:FindFirstChild(farmToolName)
	if not (tool and tool:IsA("Tool")) then
		local list = {}
		for _, c in ipairs(backpack:GetChildren()) do
			if c:IsA("Tool") then table.insert(list, c) end
		end
		tool = list[2] or list[1]
	end
	if tool then
		farmToolName = tool.Name
		hum:EquipTool(tool)
	end
end

-- tenta voltar ao jogo quando a conexão cai
local function farmReconnect()
	if farmReconnecting or not farmOn then return end
	farmReconnecting = true
	farmSave()
	farmQueueSelf()
	task.spawn(function()
		local attempt = 0
		while farmOn do
			attempt += 1
			pcall(function()
				if attempt <= 3 then
					-- primeiro tenta o mesmo servidor
					TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
				else
					-- se ele já fechou, entra em outro
					TeleportService:Teleport(game.PlaceId, player)
				end
			end)
			task.wait(8) -- sem internet o teleporte falha; tenta de novo
		end
		farmReconnecting = false
	end)
end

local function farmEnable(on)
	for _, k in ipairs({ "farmHB", "farmChar", "farmErr1", "farmErr2", "farmIdle" }) do
		if conns[k] then conns[k]:Disconnect() conns[k] = nil end
	end
	farmOn = on
	farmSave()
	if not on then return end
	if not farmCFrame then farmOn = false return end

	farmQueueSelf()
	farmGoTo()
	farmLastPos = nil

	-- loop principal: volta se for teleportado + usa a ferramenta sem parar
	conns.farmHB = RunService.Heartbeat:Connect(function()
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then farmLastPos = nil return end
		local now = os.clock()

		-- 1) o jogo me teleportou? volta para a posição definida
		if farmLastPos and (hrp.Position - farmLastPos).Magnitude > TELEPORT_JUMP then
			if now - farmLastReturn > 0.3 then
				hrp.CFrame = farmCFrame
				hrp.AssemblyLinearVelocity = Vector3.zero
				farmLastReturn = now
				farmLastPos = farmCFrame.Position
			end
		else
			farmLastPos = hrp.Position
		end

		-- 2) usa a ferramenta da mão a cada USE_INTERVAL segundos; sem ferramenta, equipa a do slot 2
		local tool = char:FindFirstChildOfClass("Tool")
		if tool then
			farmToolName = tool.Name
			if now - farmLastUse >= USE_INTERVAL then
				farmLastUse = now
				tool:Activate()
			end
		elseif now - farmLastEquip >= 0.5 then
			farmLastEquip = now
			farmEquip()
		end
	end)

	-- morreu: ao renascer volta para a posição definida
	conns.farmChar = player.CharacterAdded:Connect(function()
		farmLastPos = nil
		farmGoTo()
	end)

	-- queda de conexão (erro 277 etc.): reconecta sozinho
	conns.farmErr1 = GuiService.ErrorMessageChanged:Connect(function()
		local msg = string.lower(GuiService:GetErrorMessage() or "")
		if msg:find("277") or msg:find("connection") or msg:find("conex") then
			farmReconnect()
		end
	end)
	task.spawn(function()
		pcall(function()
			local gui = game:GetService("CoreGui"):WaitForChild("RobloxPromptGui", 10)
			local overlay = gui and gui:WaitForChild("promptOverlay", 10)
			if overlay and farmOn and not conns.farmErr2 then
				conns.farmErr2 = overlay.ChildAdded:Connect(function(child)
					if child.Name == "ErrorPrompt" then farmReconnect() end
				end)
			end
		end)
	end)

	-- anti-idle: evita ser expulso por ficar parado
	conns.farmIdle = player.Idled:Connect(function()
		pcall(function()
			local vu = game:GetService("VirtualUser")
			vu:CaptureController()
			vu:ClickButton2(Vector2.new())
		end)
	end)
end

-- ===== ANTI PART FLING =====
-- Enquanto ligado:
--  * corpo denso (peso alto) em todas as partes;
--  * noclip em TODAS as partes do corpo, inclusive pés: nada encosta em você, então
--    nenhuma parte voando consegue empurrar o seu personagem;
--  * plataforma invisível sob os pés, no nível do chão (segue o terreno), para o personagem ficar em pé;
--  * parado: o corpo só se move na vertical (qualquer empurrão horizontal é desfeito);
--  * limite de altura acima do chão (o "teto"): ninguém te lança para cima;
--  * trava velocidades absurdas e desliga os estados de queda/ragdoll.
-- Obs.: o Roblox não deixa o client criar grupos de colisão (só o servidor), então não dá para os pés
-- colidirem "só com a plataforma". O personagem fica em pé porque o Humanoid detecta o chão (e a
-- plataforma) por raycast, mesmo com todas as partes sem colisão.
local apfActive = false
local antiPartFling
do
	-- comportamento normal (teto, trava de velocidade)
	local CEILING_HEIGHT = 14   -- altura máxima acima do chão (um pulo normal sobe ~7 studs)
	local SPEED_BUFFER = 14     -- tolerância acima da velocidade esperada antes de considerar "empurrão"
	local RECOVER_DELAY = 0.18  -- segundos de empurrão sustentado antes de voltar para o lugar seguro
	local MAX_SPEED = 150       -- velocidade linear máxima (sempre corta, é o último limite)
	local MAX_SPIN = 50         -- rotação máxima (sempre corta)
	-- "fantasma" (imunidade a toque/dano e a queda)
	local LAND_SOFTEN_SPEED = 75  -- studs/s: acima disso, a queda é amortecida perto do chão
	local LAND_SOFTEN_DIST = 10   -- studs do chão em que o amortecimento começa a agir
	local DENSE = PhysicalProperties.new(100, 0.5, 0, 1, 1)
	local BLOCKED_STATES = {
		Enum.HumanoidStateType.Ragdoll,
		Enum.HumanoidStateType.FallingDown,
		Enum.HumanoidStateType.Physics,
	}

	local saved = {}   -- [parte] = { cc = CanCollide original, ct = CanTouch original, pp = propriedades físicas originais }
	local plat         -- plataforma invisível sob os pés
	local safeX, safeZ -- último lugar em que eu NÃO estava sendo empurrado (ponto de retorno)
	local pushTime = 0 -- há quanto tempo estou sendo empurrado sem parar
	local lastBaseY    -- último nível de chão encontrado
	local supportY     -- último nível em que estive apoiado (base do "teto")
	local stateHum     -- humanoid que está com estados bloqueados

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.RespectCanCollide = true

	local function restoreAll()
		for part, s in pairs(saved) do
			if part.Parent then
				part.CanCollide = s.cc
				part.CanTouch = s.ct
				part.CustomPhysicalProperties = s.pp or nil
			end
			saved[part] = nil
		end
		local char = player.Character
		if char then
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") and CORE_PARTS[part.Name] then
					part.CanCollide = true
				end
			end
		end
		if stateHum then
			for _, st in ipairs(BLOCKED_STATES) do
				pcall(stateHum.SetStateEnabled, stateHum, st, true)
			end
			stateHum = nil
		end
		if plat then plat:Destroy() plat = nil end
		safeX, safeZ, pushTime, lastBaseY, supportY = nil, nil, 0, nil, nil
	end

	antiPartFling = function(on)
		for _, k in ipairs({ "apfStep", "apfBeat" }) do
			if conns[k] then conns[k]:Disconnect() conns[k] = nil end
		end
		apfActive = on
		restoreAll()
		if not on then return end

		-- plataforma invisível sob os pés (igual ao float)
		plat = Instance.new("Part")
		plat.Name = "AntiPartFlingPlatform"
		plat.Size = Vector3.new(6, 1, 6)
		plat.Anchored = true
		plat.CanCollide = true
		plat.CanQuery = false
		plat.CanTouch = false
		plat.Transparency = 1
		plat.Parent = workspace

		-- antes da física: corpo denso, sem colisão e sem gerar/receber toque (dano de objeto, botões, etc.)
		-- em todas as partes (pés incluídos) — "fantasma": nada físico ou de evento interage comigo
		conns.apfStep = RunService.Stepped:Connect(function()
			local char = player.Character
			if not char then return end
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					if not saved[part] then
						saved[part] = { cc = part.CanCollide, ct = part.CanTouch, pp = part.CustomPhysicalProperties or false }
						part.CustomPhysicalProperties = DENSE
					end
					part.CanCollide = false
					part.CanTouch = false
				end
			end
		end)

		-- depois da física: plataforma, retorno de empurrão (mesmo andando), teto, pouso suave e limites
		conns.apfBeat = RunService.Heartbeat:Connect(function(dt)
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not hrp or not hum or not plat then return end

			if hum ~= stateHum then -- personagem novo (ou primeiro): bloqueia queda/ragdoll
				stateHum = hum
				safeX, safeZ, pushTime = nil, nil, 0
				lastBaseY, supportY = nil, nil
				for _, st in ipairs(BLOCKED_STATES) do
					pcall(hum.SetStateEnabled, hum, st, false)
				end
			end

			local pos = hrp.Position
			local standH = (hum.RigType == Enum.HumanoidRigType.R15) and (hum.HipHeight + hrp.Size.Y / 2) or 3
			local flying = flyState.fly ~= nil or flyState.vfly ~= nil or hum.SeatPart ~= nil

			-- nível do chão sob mim (se o Float está ligado, é o topo dele)
			local baseY
			if floatPart and floatY then
				baseY = floatY + 0.5
			else
				local filter = { plat }
				for _, p in ipairs(Players:GetPlayers()) do
					if p.Character then filter[#filter + 1] = p.Character end
				end
				rayParams.FilterDescendantsInstances = filter
				local hit = workspace:Raycast(pos, Vector3.new(0, -500, 0), rayParams)
				if hit then baseY = hit.Position.Y end
			end
			if baseY then lastBaseY = baseY end
			baseY = lastBaseY or (pos.Y - standH)
			lastBaseY = baseY
			plat.CFrame = CFrame.new(pos.X, baseY - 0.5, pos.Z)

			-- base do teto: último lugar em que estive apoiado (ou subindo escada)
			if hum.FloorMaterial ~= Enum.Material.Air or hum:GetState() == Enum.HumanoidStateType.Climbing then
				supportY = pos.Y - standH
			end
			supportY = supportY or (pos.Y - standH)

			if not flying then
				-- atravessou o chão? volta para cima da plataforma
				if pos.Y < baseY - 0.5 then
					hrp.CFrame = CFrame.new(pos.X, baseY + standH, pos.Z) * hrp.CFrame.Rotation
					hrp.AssemblyLinearVelocity = Vector3.zero
					pos = hrp.Position
				end

				local v = hrp.AssemblyLinearVelocity

				-- teto: não deixa subir além do limite (só corta a velocidade para cima)
				if v.Y > 0 and pos.Y > supportY + CEILING_HEIGHT then
					hrp.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
					v = hrp.AssemblyLinearVelocity
				end

				-- pouso suave perto do chão: se estou caindo rápido demais perto do chão, freio antes do impacto
				-- (o jogo costuma medir a velocidade do impacto pra aplicar dano de queda; assim ela nunca é alta)
				local groundDist = pos.Y - baseY
				if v.Y < -LAND_SOFTEN_SPEED and groundDist < LAND_SOFTEN_DIST and groundDist > -2 then
					local factor = math.clamp(1 - groundDist / LAND_SOFTEN_DIST, 0, 1) * 0.6
					hrp.AssemblyLinearVelocity = Vector3.new(v.X, v.Y + (-LAND_SOFTEN_SPEED - v.Y) * factor, v.Z)
					v = hrp.AssemblyLinearVelocity
				end

				-- "fantasma": se algo me empurrar mais rápido do que eu mesmo andaria (parado ou andando),
				-- devolvo ao último lugar seguro depois de um instante de empurrão sustentado
				local wantH = (hum.MoveDirection.Magnitude > 0.05) and hum.WalkSpeed or 0
				local hv = Vector3.new(v.X, 0, v.Z).Magnitude
				if safeX and hv > wantH + SPEED_BUFFER then
					pushTime += dt
					if pushTime >= RECOVER_DELAY then
						hrp.CFrame = CFrame.new(safeX, pos.Y, safeZ) * hrp.CFrame.Rotation
						hrp.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
						hrp.AssemblyAngularVelocity = Vector3.zero
						pushTime = 0
					end
				else
					-- (teleportes feitos por mim são aceitos: o ponto seguro passa a ser o novo lugar)
					pushTime = 0
					safeX, safeZ = pos.X, pos.Z
				end

				-- velocidade ou giro absurdos: zera (último limite, mesmo durante o empurrão)
				if hrp.AssemblyLinearVelocity.Magnitude > MAX_SPEED
					or hrp.AssemblyAngularVelocity.Magnitude > MAX_SPIN then
					hrp.AssemblyLinearVelocity = Vector3.zero
					hrp.AssemblyAngularVelocity = Vector3.zero
				end
			else
				safeX, safeZ, pushTime = nil, nil, 0
			end
		end)
	end
end

