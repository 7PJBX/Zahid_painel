-- ===== ABA FUN: ANGRY BIRD (gravidade + arremesso estilo estilingue) =====
-- "angry bird" (interruptor): abre um mini menu independente (arrastável pelo título, com botão de minimizar), que
-- fica aberto enquanto o interruptor estiver ligado. Nele: barra de gravidade (0 a 40, com 3 sensibilidades e botão "N"
-- para a gravidade normal e cadeado para travar), caixas para digitar gravidade e força (com cadeado), "airbag",
-- "escolher destino" e "lançar". Para ficar em pé no ar, use o botão de pular do Roblox.
-- Do lado direito da tela fica a barra de força (estilo taco de sinuca): puxe para baixo e solte para arremessar.
-- No modo livre, soltar a barra já arremessa na direção da câmera. Com "escolher destino" ligado, o toque no cenário
-- escolhe o alvo e o código procura um caminho livre (sobe o arremesso para passar por cima do que estiver no meio).
-- Ao pousar (ou morrer), a gravidade volta ao normal, a menos que esteja travada no cadeado. Dá para arremessar de novo no ar.
local angryBirdToggle
do
	local function build()
		local GRAV_MIN, GRAV_MAX = 0, 40   -- faixa da barra
		local GRAV_TYPE_MAX = 40           -- limite ao digitar (igual ao da barra)
		local FORCE_MAX = 70               -- studs/s no fim da barra de força
		local FORCE_TRACK_H = 220
		local AIM_POINTS = 80
		local RED = Color3.fromRGB(255, 90, 90)
		local BLUE = Color3.fromRGB(80, 210, 255)
		local ORANGE = Color3.fromRGB(255, 170, 60)
		local SENS = { { name = "fina", f = 0.1 }, { name = "média", f = 0.4 }, { name = "alta", f = nil } }
		local sensIdx = 3

		local originalGravity = workspace.Gravity
		local on = false
		local destinoMode = false
		local destinoPoint = nil
		local force = 0                 -- 0..FORCE_MAX
		local launchToken = 0
		local flying = false
		local airbagOn = false
		local gravLocked, forceLocked = false, false   -- travas: mantêm o valor escolhido depois do pouso
		local apfPaused = false         -- o Anti Part Fling foi pausado pelo arremesso
		local connList = {}
		local diedConn = nil
		local statusExtra = nil

		local rayParams = RaycastParams.new()
		rayParams.FilterType = Enum.RaycastFilterType.Exclude
		local overlap = OverlapParams.new()
		overlap.FilterType = Enum.RaycastFilterType.Exclude
		overlap.MaxParts = 8
		local hasSphere = pcall(function() return workspace.Spherecast end)

		local function myParts()
			local ex = {}
			if player.Character then table.insert(ex, player.Character) end
			if floatPart then table.insert(ex, floatPart) end
			return ex
		end
		local function getRoot()
			return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		end
		local function getHum()
			return player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		end
		local function aimDir()
			return workspace.CurrentCamera.CFrame.LookVector
		end

		-- ===== matemática do arremesso =====
		-- menor força que alcança (dx, dy) com a gravidade g
		local function minForce(g, dx, dy)
			local dist = math.sqrt(dx * dx + dy * dy)
			return math.sqrt(math.max(g * (dist + dy), 0))
		end
		-- maior gravidade com que a força v ainda alcança (dx, dy)
		local function maxGravity(v, dx, dy)
			dx = math.max(dx, 0.5)
			local a, b, c = dx * dx, 2 * dy * v * v, -(v ^ 4)
			local disc = b * b - 4 * a * c
			if disc < 0 then return nil end
			local g1 = (-b + math.sqrt(disc)) / (2 * a)
			return g1 > 0 and g1 or nil
		end
		-- passo de tempo da simulação (voos longos, com gravidade baixa, precisam de passos maiores)
		local function stepDt(v0, g)
			local tguess = (2 * math.max(v0.Y, 0) + 30) / math.max(g, 1)
			return math.clamp(tguess / AIM_POINTS, 0.04, 1.0)
		end

		-- ===== linha de mira (parábola) =====
		local aimFolder, aimSegs, aimEnd
		local function destroyAim()
			if aimFolder then aimFolder:Destroy() end
			aimFolder, aimSegs, aimEnd = nil, nil, nil
		end
		local function createAim()
			destroyAim()
			aimFolder = Instance.new("Folder")
			aimFolder.Name = "AngryBirdMira"
			aimFolder.Parent = workspace
			aimSegs = {}
			local function newPart(shape, size)
				local p = Instance.new("Part")
				p.Anchored = true
				p.CanCollide = false
				p.CanQuery = false
				p.CanTouch = false
				p.CastShadow = false
				p.Material = Enum.Material.Neon
				p.Shape = shape
				p.Size = size
				p.Transparency = 1
				p.Parent = aimFolder
				return p
			end
			for i = 1, AIM_POINTS do
				aimSegs[i] = newPart(Enum.PartType.Block, Vector3.new(0.18, 0.18, 1))
			end
			aimEnd = newPart(Enum.PartType.Ball, Vector3.new(0.9, 0.9, 0.9))
		end
		local function hideAim()
			if not aimFolder then return end
			for i = 1, AIM_POINTS do aimSegs[i].Transparency = 1 end
			aimEnd.Transparency = 1
		end
		local function drawAim(start, v0, g, color)
			if not aimFolder then return end
			rayParams.FilterDescendantsInstances = myParts()
			local grav = Vector3.new(0, -g, 0)
			local dt = stepDt(v0, g)
			local prev = start
			local used = 0
			for i = 1, AIM_POINTS do
				local t = i * dt
				local pt = start + v0 * t + 0.5 * grav * t * t
				used = i
				local delta = pt - prev
				local finish = pt
				local stop = false
				if delta.Magnitude > 0.01 then
					local hit = workspace:Raycast(prev, delta, rayParams)
					if hit then finish, stop = hit.Position, true end
				end
				local seg = aimSegs[i]
				local l = (finish - prev).Magnitude
				if l > 0.01 then
					seg.Size = Vector3.new(0.18, 0.18, l)
					seg.CFrame = CFrame.lookAt((prev + finish) / 2, finish)
					seg.Color = color
					seg.Transparency = 0.15
				else
					seg.Transparency = 1
				end
				prev = finish
				if stop then break end
			end
			for i = used + 1, AIM_POINTS do aimSegs[i].Transparency = 1 end
			aimEnd.CFrame = CFrame.new(prev)
			aimEnd.Color = color
			aimEnd.Transparency = 0.1
		end

		-- ===== planejamento: caminho livre até o destino =====
		local function castSeg(prev, delta)
			if hasSphere then
				return workspace:Spherecast(prev, 1.2, delta, rayParams)
			end
			return workspace:Raycast(prev, delta, rayParams)
		end
		-- a trajetória chega ao alvo sem bater em nada antes? (bater perto do alvo conta como chegar)
		local function pathClear(start, v0, g, target, tmax)
			local grav = Vector3.new(0, -g, 0)
			local n = 30
			local dt = tmax / n
			local prev = start
			for i = 1, n do
				local t = i * dt
				local pt = start + v0 * t + 0.5 * grav * t * t
				local delta = pt - prev
				if delta.Magnitude > 0.05 then
					local hit = castSeg(prev, delta)
					if hit then
						if (hit.Position - target).Magnitude < 5 then return true end
						if (hit.Position - start).Magnitude >= 6 then return false end
					end
				end
				prev = pt
			end
			return true
		end
		-- { ok = alcança?, clear = caminho livre?, v0, speed }. Mantém a força escolhida se der; se o caminho estiver
		-- bloqueado, tenta o arco mais alto e, depois, forças maiores (até o máximo), como na figura da direita
		local function computePlan(start, target, g, f)
			local diff = target - start
			local flat = Vector3.new(diff.X, 0, diff.Z)
			local dx, dy = flat.Magnitude, diff.Y
			local fd = aimDir()
			local flatDir = dx > 0.1 and flat.Unit or Vector3.new(fd.X, 0, fd.Z).Unit
			local dxs = math.max(dx, 0.5)
			local function angles(v)
				local disc = v ^ 4 - g * (g * dxs * dxs + 2 * dy * v * v)
				if disc < 0 then return nil end
				local sq = math.sqrt(disc)
				return math.atan((v * v - sq) / (g * dxs)), math.atan((v * v + sq) / (g * dxs))
			end
			if not angles(f) then return { ok = false } end
			local best = nil
			for _, mult in ipairs({ 1, 1.2, 1.5, 2.0 }) do
				local v = math.min(f * mult, FORCE_MAX)
				local a1, a2 = angles(v)
				if a1 then
					for _, ang in ipairs({ a1, a2 }) do
						local v0 = (flatDir * math.cos(ang) + Vector3.new(0, 1, 0) * math.sin(ang)) * v
						local hs = math.max(v * math.cos(ang), 0.5)
						local tmax = math.clamp(dxs / hs, 0.2, 120)
						if pathClear(start, v0, g, target, tmax) then
							return { ok = true, clear = true, v0 = v0, speed = v }
						end
						if not best then best = { ok = true, clear = false, v0 = v0, speed = v } end
					end
				end
				if v >= FORCE_MAX then break end
			end
			return best or { ok = false }
		end
		local planCache = { key = "", t = 0, plan = nil }
		local function getPlan(start, target, g, fresh)
			local key = string.format("%d,%d,%d|%d,%d,%d|%.1f|%.1f",
				math.floor(start.X), math.floor(start.Y), math.floor(start.Z),
				math.floor(target.X), math.floor(target.Y), math.floor(target.Z), g, force)
			if not fresh then
				if planCache.key == key then return planCache.plan end
				if planCache.plan and os.clock() - planCache.t < 0.12 then return planCache.plan end
			end
			planCache.key, planCache.t = key, os.clock()
			rayParams.FilterDescendantsInstances = myParts()
			planCache.plan = computePlan(start, target, g, math.max(force, 1))
			return planCache.plan
		end

		-- ===== janela (mini menu independente, estreito) =====
		local FUN_W = math.min(200, viewport.X - 16)
		local FUN_H = math.min(300, viewport.Y - 24)
		local HEADER_H = 32
		local BODY_H = 320
		local funMenu = mkWindowFrame(gui)
		funMenu.Name = "AngryBird"
		funMenu.Size = UDim2.fromOffset(FUN_W, FUN_H)
		funMenu.Position = UDim2.fromOffset(math.max(10, viewport.X - FUN_W - 70), math.max(10, (viewport.Y - FUN_H) / 2))
		funMenu.Visible = false
		local funScale = Instance.new("UIScale")
		funScale.Parent = funMenu

		local funTitle = mkLabel(funMenu, "Angry Bird", 14, "text")
		funTitle.Font = FONT_BOLD
		funTitle.Position = UDim2.fromOffset(10, 8)
		funTitle.Size = UDim2.new(1, -56, 0, 18)
		local minBtn = new3DButton(funMenu, "-", UDim2.new(1, -40, 0, 3), UDim2.fromOffset(32, 26), "Off")
		minBtn.face.TextSize = 16

		-- arrastar o mini menu pela barra do título
		local dragBar = Instance.new("Frame")
		dragBar.BackgroundTransparency = 1
		dragBar.Size = UDim2.new(1, -46, 0, HEADER_H)
		dragBar.Active = true
		dragBar.Parent = funMenu
		local fdrag, fstart, fpos = false, Vector2.zero, UDim2.new()
		dragBar.InputBegan:Connect(function(input)
			if isPress(input) then
				fdrag, fstart, fpos = true, input.Position, funMenu.Position
			end
		end)

		-- corpo rolável (os controles ficam aqui; some quando o mini menu é minimizado)
		local body = mkScroll(funMenu)
		body.Position = UDim2.fromOffset(0, HEADER_H)
		body.Size = UDim2.new(1, 0, 1, -HEADER_H)
		body.AutomaticCanvasSize = Enum.AutomaticSize.None
		body.CanvasSize = UDim2.new(0, 0, 0, BODY_H)

		local minimized = false
		minBtn.face.Activated:Connect(function()
			minimized = not minimized
			body.Visible = not minimized
			minBtn.face.Text = minimized and "+" or "-"
			funMenu.Size = UDim2.fromOffset(FUN_W, minimized and HEADER_H or FUN_H)
		end)

		-- gravidade: rótulo, barra, botão N e caixa de texto
		local gravLabel = mkLabel(body, "", 12, "textDim")
		gravLabel.Position = UDim2.fromOffset(10, 0)
		gravLabel.Size = UDim2.new(1, -20, 0, 16)

		local gravTrack = mkPanel(body, "field", 8)
		gravTrack.Position = UDim2.fromOffset(10, 20)
		gravTrack.Size = UDim2.new(1, -100, 0, 22)
		gravTrack.Active = true
		local gravBar = Instance.new("Frame")
		gravBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		gravBar.BackgroundTransparency = 0.7
		gravBar.BorderSizePixel = 0
		gravBar.Size = UDim2.new(1, -6, 1, -6)
		gravBar.Position = UDim2.fromOffset(3, 3)
		gravBar.Parent = gravTrack
		Instance.new("UICorner", gravBar).CornerRadius = UDim.new(1, 0)
		local gravKnob = Instance.new("Frame")
		gravKnob.AnchorPoint = Vector2.new(0.5, 0.5)
		gravKnob.Size = UDim2.fromOffset(18, 18)
		gravKnob.BackgroundColor3 = T.faceHelp
		gravKnob.BorderSizePixel = 0
		gravKnob.Active = true
		gravKnob.Parent = gravTrack
		Instance.new("UICorner", gravKnob).CornerRadius = UDim.new(1, 0)

		local normalBtn = new3DButton(body, "N", UDim2.new(1, -86, 0, 16), UDim2.fromOffset(34, 30), "Off")
		local gravLockBtn = new3DButton(body, "🔒", UDim2.new(1, -46, 0, 16), UDim2.fromOffset(36, 30), "Off")

		local sensBtn = new3DButton(body, "sens.: alta", UDim2.fromOffset(10, 52), UDim2.new(1, -20, 0, 30), "Off")

		local function boxLabel(text, position)
			local l = mkLabel(body, text, 11, "textDim")
			l.Position = position
			l.Size = UDim2.new(0.5, -13, 0, 14)
			return l
		end
		boxLabel("gravidade", UDim2.fromOffset(10, 90))
		boxLabel("força", UDim2.new(0.5, 3, 0, 90))

		local gravBox, forceBox
		local function numBox(position, onSubmit, size)
			local box = Instance.new("TextBox")
			box.Position = position
			box.Size = size or UDim2.new(0.5, -13, 0, 26)
			box.BorderSizePixel = 0
			box.Font = FONT
			box.TextSize = 13
			box.ClearTextOnFocus = true
			box.Text = ""
			box.Parent = body
			Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)
			onTheme(function()
				box.BackgroundColor3 = T.field
				box.TextColor3 = T.text
			end)
			box.FocusLost:Connect(function()
				local s = string.gsub(box.Text, ",", ".")
				onSubmit(tonumber(s))
			end)
			return box
		end

		local function refreshGravUI()
			local g = workspace.Gravity
			local normal = math.abs(g - originalGravity) < 0.5
			if normal then
				gravLabel.Text = string.format("Gravidade: normal (%d)", math.floor(g + 0.5))
			else
				gravLabel.Text = string.format("Gravidade: %.1f", g)
			end
			local a = math.clamp((g - GRAV_MIN) / (GRAV_MAX - GRAV_MIN), 0, 1)
			gravKnob.Position = UDim2.new(a, 0, 0.5, 0)
			gravKnob.BackgroundColor3 = (normal or g > GRAV_MAX) and T.faceOff or T.faceHelp
			if not gravBox:IsFocused() then
				gravBox.Text = normal and "normal" or string.format("%.1f", g)
			end
		end
		local function setGravity(g)
			workspace.Gravity = math.clamp(g, GRAV_MIN, GRAV_TYPE_MAX)
			refreshGravUI()
		end
		local function resetGravity()
			workspace.Gravity = originalGravity
			refreshGravUI()
		end

		local setForceKnobY, updateAim -- definidas mais abaixo
		local function refreshForceBox()
			if forceBox and not forceBox:IsFocused() then
				forceBox.Text = tostring(math.floor(force + 0.5))
			end
		end

		gravBox = numBox(UDim2.fromOffset(10, 106), function(n)
			if n then setGravity(n) else refreshGravUI() end
		end)
		forceBox = numBox(UDim2.new(0.5, 3, 0, 106), function(n)
			if n then
				force = math.clamp(n, 0, FORCE_MAX)
				setForceKnobY(force / FORCE_MAX)
				updateAim()
			end
			refreshForceBox()
		end, UDim2.new(0.5, -53, 0, 26))
		local forceLockBtn = new3DButton(body, "🔒", UDim2.new(1, -46, 0, 104), UDim2.fromOffset(36, 30), "Off")

		-- arrastar a barra de gravidade, com 3 níveis de sensibilidade (fina e média são relativas ao arrasto)
		local gravDragging, gravDragX, gravDragVal = false, 0, 0
		local function gravDragMove(x)
			local s = SENS[sensIdx]
			if s.f == nil then
				local a = math.clamp((x - gravTrack.AbsolutePosition.X) / gravTrack.AbsoluteSize.X, 0, 1)
				setGravity(GRAV_MIN + a * (GRAV_MAX - GRAV_MIN))
			else
				local per = (GRAV_MAX - GRAV_MIN) / gravTrack.AbsoluteSize.X
				setGravity(math.clamp(gravDragVal + (x - gravDragX) * per * s.f, GRAV_MIN, GRAV_MAX))
			end
		end
		local function gravDragStart(input)
			if isPress(input) then
				gravDragging = true
				gravDragX = input.Position.X
				gravDragVal = math.clamp(workspace.Gravity, GRAV_MIN, GRAV_MAX)
				body.ScrollingEnabled = false
				if SENS[sensIdx].f == nil then gravDragMove(input.Position.X) end
			end
		end
		gravTrack.InputBegan:Connect(gravDragStart)
		gravKnob.InputBegan:Connect(gravDragStart)

		normalBtn.face.Activated:Connect(resetGravity)
		gravLockBtn.face.Activated:Connect(function()
			gravLocked = not gravLocked
			gravLockBtn.setOn(gravLocked)
		end)
		forceLockBtn.face.Activated:Connect(function()
			forceLocked = not forceLocked
			forceLockBtn.setOn(forceLocked)
		end)
		sensBtn.face.Activated:Connect(function()
			sensIdx = sensIdx % #SENS + 1
			sensBtn.face.Text = "sens.: " .. SENS[sensIdx].name
		end)

		-- ===== airbag (para ficar em pé no ar, use o botão de pular do Roblox) =====
		local airbagBtn = new3DButton(body, "airbag", UDim2.fromOffset(10, 140), UDim2.new(1, -20, 0, 30), "Off")

		-- levanta o personagem de pé (sai do ragdoll) e cancela o voo em andamento
		local function standUp()
			launchToken += 1
			flying = false
			local hum, hrp = getHum(), getRoot()
			if hum and hrp then
				local look = hrp.CFrame.LookVector
				local yaw = math.atan2(-look.X, -look.Z)
				hrp.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 2.5, 0)) * CFrame.Angles(0, yaw, 0)
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
				hum.PlatformStand = false
				hum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
			if apfPaused then
				apfPaused = false
				toggles["Anti Part Fling"](true)
			end
		end

		-- ao pousar: a gravidade volta ao normal, a menos que esteja travada
		local function afterLanding()
			if not gravLocked then resetGravity() end
		end
		-- levanta de pé (botão de pular) e, quando tocar o chão, trata o pouso
		local function standUpAndWatch()
			standUp()
			local token = launchToken
			task.spawn(function()
				local t0 = os.clock()
				while token == launchToken and on do
					task.wait(0.1)
					local hum = getHum()
					if not hum or hum.Health <= 0 then return end
					if os.clock() - t0 > 0.3 and hum.FloorMaterial ~= Enum.Material.Air then
						if token == launchToken then afterLanding() end
						return
					end
				end
			end)
		end
		airbagBtn.face.Activated:Connect(function()
			airbagOn = not airbagOn
			airbagBtn.setOn(airbagOn)
		end)

		-- ===== destino, lançar e sugestão =====
		local destBtn = new3DButton(body, "escolher destino", UDim2.fromOffset(10, 176), UDim2.new(1, -20, 0, 30), "Off")
		destBtn.face.TextTruncate = Enum.TextTruncate.AtEnd
		local launchBtn = new3DButton(body, "lançar", UDim2.fromOffset(10, 212), UDim2.new(1, -20, 0, 30), "Net")

		local statusLabel = mkLabel(body, "", 11, "textDim")
		statusLabel.Position = UDim2.fromOffset(10, 248)
		statusLabel.Size = UDim2.new(1, -20, 0, 52)

		local suggestFrame = Instance.new("Frame")
		suggestFrame.BackgroundTransparency = 1
		suggestFrame.Position = UDim2.fromOffset(10, 248)
		suggestFrame.Size = UDim2.new(1, -20, 0, 70)
		suggestFrame.Visible = false
		suggestFrame.Parent = body
		local suggestText = mkLabel(suggestFrame, "", 11, "warn")
		suggestText.Size = UDim2.new(1, 0, 0, 40)
		local suggestYes = new3DButton(suggestFrame, "sim", UDim2.fromOffset(0, 42), UDim2.new(0.5, -3, 0, 26), "Net")
		local suggestNo = new3DButton(suggestFrame, "não", UDim2.new(0.5, 3, 0, 42), UDim2.new(0.5, -3, 0, 26), "Off")

		local suggestedForce, suggestedGrav = nil, nil
		local function hideSuggest()
			suggestFrame.Visible = false
			statusLabel.Visible = true
		end
		local function showSuggest(fSug, gSug)
			suggestedForce, suggestedGrav = fSug, gSug
			statusLabel.Visible = false
			suggestFrame.Visible = true
			if gSug then
				suggestText.Text = string.format("Não alcança. Sugestão: força %d e gravidade %d. Usar?", math.floor(fSug), math.floor(gSug))
			else
				suggestText.Text = string.format("Não alcança. Sugestão: força %d. Usar?", math.floor(fSug))
			end
		end
		suggestYes.face.Activated:Connect(function()
			if suggestedGrav then setGravity(suggestedGrav) end
			if suggestedForce then
				force = math.clamp(suggestedForce, 0, FORCE_MAX)
				setForceKnobY(force / FORCE_MAX) -- a barra de força acompanha a sugestão
				refreshForceBox()
			end
			hideSuggest()
		end)
		suggestNo.face.Activated:Connect(hideSuggest)

		-- ===== barra de força (lado direito da tela, estilo taco de sinuca) =====
		local forceTrack = Instance.new("Frame")
		forceTrack.AnchorPoint = Vector2.new(1, 0.5)
		forceTrack.Position = UDim2.new(1, -18, 0.5, 0)
		forceTrack.Size = UDim2.fromOffset(10, FORCE_TRACK_H)
		forceTrack.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		forceTrack.BackgroundTransparency = 0.75
		forceTrack.BorderSizePixel = 0
		forceTrack.Visible = false
		forceTrack.Parent = gui
		Instance.new("UICorner", forceTrack).CornerRadius = UDim.new(1, 0)
		local forceKnob = Instance.new("Frame")
		forceKnob.AnchorPoint = Vector2.new(0.5, 0.5)
		forceKnob.Size = UDim2.fromOffset(34, 34)
		forceKnob.Position = UDim2.new(0.5, 0, 0, 0)
		forceKnob.BackgroundColor3 = Color3.fromRGB(255, 160, 60)
		forceKnob.BorderSizePixel = 0
		forceKnob.Active = true
		forceKnob.Parent = forceTrack
		Instance.new("UICorner", forceKnob).CornerRadius = UDim.new(1, 0)

		function setForceKnobY(a)
			forceKnob.Position = UDim2.new(0.5, 0, a, 0)
		end

		-- ===== ragdoll (estilo "trip") + arremesso + pouso =====
		-- toca em alguma superfície? (peças próximas, chão logo abaixo ou algo logo à frente)
		local function touching(hrp)
			rayParams.FilterDescendantsInstances = myParts()
			overlap.FilterDescendantsInstances = myParts()
			for _, p in ipairs(workspace:GetPartBoundsInRadius(hrp.Position, 3.6, overlap)) do
				if p.CanCollide then return true end
			end
			if workspace:Raycast(hrp.Position, Vector3.new(0, -4.2, 0), rayParams) then return true end
			local v = hrp.AssemblyLinearVelocity
			if v.Magnitude > 2 and workspace:Raycast(hrp.Position, v.Unit * 3.6, rayParams) then return true end
			return false
		end

		-- airbag: perto de uma superfície a velocidade cai aos poucos, para o impacto ser leve
		local function airbagBrake(hrp, dt)
			local vel = hrp.AssemblyLinearVelocity
			local speed = vel.Magnitude
			if speed <= 6 then return end
			local zone = math.clamp(speed * 0.7, 14, 70)
			local dirv = vel.Unit
			rayParams.FilterDescendantsInstances = myParts()
			local d = zone
			local ahead = workspace:Raycast(hrp.Position, dirv * zone, rayParams)
			if ahead then d = math.min(d, (ahead.Position - hrp.Position).Magnitude) end
			if vel.Y < 0 then
				local down = workspace:Raycast(hrp.Position, Vector3.new(0, -zone, 0), rayParams)
				if down then d = math.min(d, down.Distance) end
			end
			if d < zone then
				local target = math.max(5, d * 1.3) -- a velocidade alvo diminui com a distância
				if speed > target then
					hrp.AssemblyLinearVelocity = dirv * (speed + (target - speed) * math.clamp(dt * 8, 0, 1))
				end
			end
		end

		local function doLaunch(v0)
			local hum, hrp = getHum(), getRoot()
			if not (hum and hrp) then return end

			-- o Anti Part Fling tem teto de altura e freia quedas: pausa durante o voo (só na primeira vez,
			-- assim dá para arremessar de novo ainda no ar sem perder o aviso de religar)
			if not flying then
				apfPaused = apfActive
				if apfActive then toggles["Anti Part Fling"](false) end
			end

			hum.PlatformStand = true
			hrp.AssemblyLinearVelocity = v0
			hrp.AssemblyAngularVelocity = Vector3.new(math.random(-10, 10), math.random(-10, 10), math.random(-10, 10))
			flying = true

			launchToken += 1
			local token = launchToken
			task.spawn(function()
				local t0 = os.clock()
				local airborneSeen = false
				-- fica em ragdoll até tocar uma superfície (sem limite de tempo: com gravidade baixa o voo pode demorar)
				while token == launchToken and hrp.Parent and hum.Health > 0 do
					local dt = RunService.Heartbeat:Wait()
					if token ~= launchToken then return end
					hum.PlatformStand = true
					if hum.Jump and os.clock() - t0 > 0.3 then
						standUpAndWatch() -- botão de pular: levanta de pé
						return
					end
					if airbagOn then airbagBrake(hrp, dt) end
					if touching(hrp) then
						if airborneSeen then break end
					elseif os.clock() - t0 > 0.15 then
						airborneSeen = true -- já saiu do chão: o próximo contato é o pouso
					end
				end
				if token ~= launchToken then return end
				if hum.Health > 0 and hrp.Parent then
					standUp()      -- pousou: levanta de pé
					afterLanding() -- e a gravidade volta ao normal (se não estiver travada)
				end
			end)
		end

		-- ao morrer, a gravidade volta ao normal
		local function onDied()
			launchToken += 1
			flying = false
			resetGravity()
			if apfPaused then
				apfPaused = false
				toggles["Anti Part Fling"](true)
			end
		end
		local function hookHumanoid()
			if diedConn then diedConn:Disconnect() diedConn = nil end
			local hum = getHum()
			if hum then diedConn = hum.Died:Connect(onDied) end
		end
		table.insert(connList, player.CharacterAdded:Connect(function(char)
			char:WaitForChild("Humanoid", 10)
			if on then hookHumanoid() end
		end))
		table.insert(connList, UIS.JumpRequest:Connect(function()
			if on and flying then standUpAndWatch() end
		end))

		-- ===== linha de mira e estado =====
		function updateAim()
			local hrp = getRoot()
			if not hrp or not aimFolder then return end
			local g = workspace.Gravity
			local start = hrp.Position
			statusExtra = nil

			if destinoMode and destinoPoint then
				local plan = getPlan(start, destinoPoint, g)
				if plan.ok then
					if plan.speed > force + 0.5 then
						-- o planejador subiu a força para passar por cima do que está no meio
						force = plan.speed
						setForceKnobY(force / FORCE_MAX)
						refreshForceBox()
					end
					if plan.clear then
						drawAim(start, plan.v0, g, BLUE)
					else
						drawAim(start, plan.v0, g, ORANGE)
						statusExtra = "Caminho bloqueado: melhor tentativa (laranja)."
					end
					hideSuggest()
				else
					local diff = destinoPoint - start
					local dx, dy = Vector3.new(diff.X, 0, diff.Z).Magnitude, diff.Y
					drawAim(start, aimDir() * math.max(force, 1), g, RED)
					local fSug = minForce(g, dx, dy)
					if fSug <= FORCE_MAX then
						showSuggest(fSug, nil)
					else
						local gSug = maxGravity(FORCE_MAX, dx, dy)
						showSuggest(FORCE_MAX, gSug and math.clamp(gSug, GRAV_MIN, GRAV_TYPE_MAX) or GRAV_MAX)
					end
				end
			elseif force >= 2 and not destinoMode then
				drawAim(start, aimDir() * force, g, BLUE)
			else
				hideAim()
			end

			if statusLabel.Visible then
				statusLabel.Text = statusExtra or string.format("Força: %d | %s", math.floor(force + 0.5),
					destinoMode and (destinoPoint and "destino escolhido" or "toque no cenário para escolher o destino")
					or "puxe a barra da direita e solte (ou digite a força e use lançar)")
			end
		end

		local function forceFromY(y)
			local a = math.clamp((y - forceTrack.AbsolutePosition.Y) / forceTrack.AbsoluteSize.Y, 0, 1)
			force = a * FORCE_MAX
			setForceKnobY(a)
			refreshForceBox()
			updateAim()
		end
		local forceDragging = false
		local function forceDragStart(input)
			if isPress(input) then
				forceDragging = true
				forceFromY(input.Position.Y)
			end
		end
		forceTrack.InputBegan:Connect(forceDragStart)
		forceKnob.InputBegan:Connect(forceDragStart)

		-- lança agora: no modo destino segue o plano; no modo livre vai na direção da câmera
		local function launchNow()
			local hrp = getRoot()
			if not hrp then return end
			if force <= 2 then
				flashText(launchBtn.face, "defina a força", "bad")
				return
			end
			if destinoMode then
				if not destinoPoint then
					flashText(launchBtn.face, "escolha o destino", "bad")
					return
				end
				local plan = getPlan(hrp.Position, destinoPoint, workspace.Gravity, true)
				if not plan.ok then
					flashText(launchBtn.face, "fora de alcance", "bad")
					return
				end
				doLaunch(plan.v0)
				destinoPoint = nil
			else
				doLaunch(aimDir() * force)
			end
			if not forceLocked then
				force = 0
				setForceKnobY(0)
				refreshForceBox()
			end
		end
		launchBtn.face.Activated:Connect(launchNow)

		table.insert(connList, UIS.InputChanged:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
			if fdrag then
				local d = input.Position - fstart
				local screen = gui.AbsoluteSize
				local nx = math.clamp(fpos.X.Offset + d.X, 0, math.max(0, screen.X - FUN_W))
				local ny = math.clamp(fpos.Y.Offset + d.Y, 0, math.max(0, screen.Y - (minimized and HEADER_H or FUN_H)))
				funMenu.Position = UDim2.fromOffset(nx, ny)
			end
			if gravDragging then gravDragMove(input.Position.X) end
			if forceDragging then forceFromY(input.Position.Y) end
		end))
		table.insert(connList, UIS.InputEnded:Connect(function(input)
			if not isPress(input) then return end
			fdrag = false
			if gravDragging then
				gravDragging = false
				body.ScrollingEnabled = true
			end
			if forceDragging then
				forceDragging = false
				if not destinoMode then
					-- modo livre: soltar a barra já arremessa, na direção da câmera, com ragdoll
					if force > 2 then doLaunch(aimDir() * force) end
					if not forceLocked then
						force = 0
						refreshForceBox()
						tween(forceKnob, 0.25, { Position = UDim2.new(0.5, 0, 0, 0) }, Enum.EasingStyle.Back)
					end
				else
					updateAim() -- modo destino: só guarda a força, não arremessa
				end
			end
		end))

		-- toque no cenário escolhe o destino (só com "escolher destino" ligado)
		table.insert(connList, UIS.InputBegan:Connect(function(input, gp)
			if gp or not on or not destinoMode or not isPress(input) then return end
			local cam = workspace.CurrentCamera
			local ray = cam:ScreenPointToRay(input.Position.X, input.Position.Y)
			rayParams.FilterDescendantsInstances = myParts()
			local hit = workspace:Raycast(ray.Origin, ray.Direction * 2000, rayParams)
			if hit then
				-- mira onde o personagem ficaria: um pouco acima e para fora da superfície tocada
				destinoPoint = hit.Position + hit.Normal * 1.2 + Vector3.new(0, 2.5, 0)
				updateAim()
			end
		end))

		destBtn.face.Activated:Connect(function()
			destinoMode = not destinoMode
			destBtn.setOn(destinoMode)
			if not destinoMode then
				destinoPoint = nil
				hideSuggest()
			end
		end)

		table.insert(connList, RunService.Heartbeat:Connect(function()
			if on then updateAim() end
		end))

		angryBirdToggle = function(enable)
			on = enable
			funMenu.Visible = enable
			forceTrack.Visible = enable
			if enable then
				funScale.Scale = 0.85
				tween(funScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
				createAim()
				refreshGravUI()
				refreshForceBox()
				setForceKnobY(0)
				hookHumanoid()
			else
				if flying then standUp() end
				destroyAim()
				destinoMode, destinoPoint, force = false, nil, 0
				gravLocked, forceLocked = false, false
				gravLockBtn.setOn(false)
				forceLockBtn.setOn(false)
				destBtn.setOn(false)
				hideSuggest()
				resetGravity() -- sem o mini menu, a gravidade volta ao normal
				if diedConn then diedConn:Disconnect() diedConn = nil end
			end
		end

		conns.funCleanup = { Disconnect = function()
			angryBirdToggle(false)
			for _, c in ipairs(connList) do c:Disconnect() end
			workspace.Gravity = originalGravity
			funMenu:Destroy()
			forceTrack:Destroy()
		end }
	end
	build()
end

do
	local page = pages.fun
	addToggle(page, "AngryBird", "angry bird", "Abre um mini menu: gravidade, airbag e, do lado direito da tela, a barra de força para arremessar o personagem (estilo estilingue/taco de sinuca).", angryBirdToggle)
