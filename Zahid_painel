-- ===== ANIMAÇÃO: FUNÇÕES AUXILIARES =====
local function tween(obj, time, props, style, dir)
	local t = TweenService:Create(
		obj,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

-- ===== BOTÃO 3D =====
-- dois retângulos arredondados: o corpo (escuro) fica parado e a face (clara) desce por cima dele ao apertar
local DEPTH = 4 -- espessura do corpo que aparece embaixo da face
local pressedFaces = {}

-- ao soltar o dedo/mouse em qualquer lugar, todas as faces apertadas voltam para cima
UIS.InputEnded:Connect(function(input)
	if not isPress(input) then return end
	for face in pairs(pressedFaces) do
		pressedFaces[face] = nil
		tween(face, 0.14, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
	end
end)

local themed3D = {} -- todos os botões 3D, para trocar o tema depois

-- descobre o "papel" da cor do botão (Off, Tp, Help, Net) no tema atual
local function roleOf(faceColor)
	for _, role in ipairs({ "Off", "Tp", "Help", "Net" }) do
		if T["face" .. role] == faceColor then return role end
	end
	return "Off"
end

local function new3DButton(parent, text, position, size, faceColor, baseColor)
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Position = position
	holder.Size = size
	holder.Parent = parent

	local faceH = size.Y.Offset - DEPTH

	-- corpo (mais escuro, parado)
	local base = Instance.new("Frame")
	base.Size = UDim2.new(1, 0, 0, faceH)
	base.Position = UDim2.fromOffset(0, DEPTH)
	base.BackgroundColor3 = baseColor
	base.BorderSizePixel = 0
	base.Parent = holder
	Instance.new("UICorner", base).CornerRadius = UDim.new(0, 10)

	-- face (mais clara, é o botão de verdade)
	local face = Instance.new("TextButton")
	face.Size = UDim2.new(1, 0, 0, faceH)
	face.Position = UDim2.fromOffset(0, 0)
	face.BackgroundColor3 = faceColor
	face.BorderSizePixel = 0
	face.AutoButtonColor = false
	face.Font = T.font
	face.TextColor3 = T.text
	face.TextSize = 16
	face.Text = text
	face.Parent = holder
	Instance.new("UICorner", face).CornerRadius = UDim.new(0, 10)

	face.InputBegan:Connect(function(input)
		if isPress(input) then
			pressedFaces[face] = true
			tween(face, 0.06, { Position = UDim2.fromOffset(0, DEPTH) })
		end
	end)

	local obj = { holder = holder, base = base, face = face, role = roleOf(faceColor), isOn = false }

	-- limpa da lista os botões que já foram destruídos (itens antigos da lista de jogadores)
	if #themed3D > 120 then
		for n = #themed3D, 1, -1 do
			if not themed3D[n].holder.Parent then table.remove(themed3D, n) end
		end
	end
	table.insert(themed3D, obj)

	-- liga/desliga: muda a cor da face e do corpo
	function obj.setOn(on)
		obj.isOn = on
		tween(face, 0.2, {
			BackgroundColor3 = on and T.faceOn or T["face" .. obj.role],
			TextColor3 = on and T.textOn or T.text,
		})
		tween(base, 0.2, { BackgroundColor3 = on and T.baseOn or T["base" .. obj.role] })
	end

	-- aparece aos poucos (usado nos itens da lista de jogadores)
	function obj.hide()
		face.BackgroundTransparency = 1
		base.BackgroundTransparency = 1
		face.TextTransparency = 1
	end

	function obj.show()
		tween(face, 0.25, { BackgroundTransparency = 0, TextTransparency = 0 })
		tween(base, 0.25, { BackgroundTransparency = 0 })
	end

	return obj
end

-- ===== INTRO: BEIJO 💋 =====
local function playIntro(onDone)
	local introGui = Instance.new("ScreenGui")
	introGui.Name = "KissIntro"
	introGui.IgnoreGuiInset = true
	introGui.ResetOnSpawn = false
	introGui.DisplayOrder = 100
	introGui.Parent = player:WaitForChild("PlayerGui")

	local CENTER = UDim2.fromScale(0.5, 0.5)
	local BIG = 3 -- tamanho final do beijo (multiplicador)

	local function newEmoji(emoji, size)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Font = Enum.Font.GothamMedium -- fonte padrão para preservar os emojis
		l.Text = emoji
		l.TextSize = size
		l.Size = UDim2.fromOffset(size + 20, size + 20)
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.Position = CENTER
		l.Parent = introGui
		return l
	end

	local kiss = newEmoji("💋", 90)
	kiss.ZIndex = 2
	local kissScale = Instance.new("UIScale")
	kissScale.Scale = 0.02
	kissScale.Parent = kiss

	-- 1) cresce do minúsculo até ficar grande
	tween(kissScale, 1.2, { Scale = BIG }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut).Completed:Wait()

	-- 2) treme, instável, como se fosse explodir
	local t0 = os.clock()
	local SHAKE_TIME = 0.9
	while os.clock() - t0 < SHAKE_TIME do
		local k = (os.clock() - t0) / SHAKE_TIME
		local amp = 3 + k * 14
		local function r() return (math.random() * 2 - 1) * amp end
		kiss.Position = UDim2.new(0.5, r(), 0.5, r())
		kiss.Rotation = r() * 0.8
		kissScale.Scale = BIG + (math.random() * 2 - 1) * 0.12 * (k + 0.3)
		RunService.RenderStepped:Wait()
	end
	kiss.Position = CENTER
	kiss.Rotation = 0
	kissScale.Scale = BIG

	-- 3) deixa a marca de beijo (mesmo emoji, transparente)
	local mark = kiss:Clone()
	mark.ZIndex = 1
	mark.Rotation = -10
	mark.TextTransparency = 0.6
	mark.Position = CENTER
	mark:FindFirstChildOfClass("UIScale").Scale = BIG
	mark.Parent = introGui

	-- 4) explosão de corações COM FÍSICA (gravidade + quicam nas bordas da tela)
	local EMOJIS = { "❤️", "💖", "💘", "💕", "💝", "🔥", "🌹" }
	local HEART_COUNT = 110
	local GRAVITY = 1500      -- px/s² (maior = cai mais rápido)
	local BOUNCE_WALL = 0.7   -- 1 = quica sem perder força
	local BOUNCE_FLOOR = 0.55
	local TOTAL_TIME = 3    -- segundos até sumir tudo
	local FADE_TIME = 0.6

	local screen = introGui.AbsoluteSize
	local hearts = {}
	for _ = 1, HEART_COUNT do
		local size = math.random(50, 60)
		local label = newEmoji(EMOJIS[math.random(#EMOJIS)], size)
		label.ZIndex = 3
		local angle = math.random() * math.pi * 2
		local speed = math.random(500, 1500)
		table.insert(hearts, {
			label = label,
			r = size / 2,
			x = screen.X / 2,
			y = screen.Y / 2,
			vx = math.cos(angle) * speed,
			vy = math.sin(angle) * speed - 400, -- leve impulso para cima
			rot = math.random(-30, 30),
			vrot = math.random(-500, 500),
		})
	end

	local function stepHearts(dt)
		local W, H = introGui.AbsoluteSize.X, introGui.AbsoluteSize.Y
		local RESTITUTION = 0.6 -- quique entre corações (1 = sem perder força)

		-- 1) movimento + paredes, teto e chão
		for _, p in ipairs(hearts) do
			p.vy += GRAVITY * dt
			p.x += p.vx * dt
			p.y += p.vy * dt
			p.rot += p.vrot * dt

			if p.x < p.r then
				p.x = p.r
				p.vx = -p.vx * BOUNCE_WALL
				p.vrot = -p.vrot * 0.8
			elseif p.x > W - p.r then
				p.x = W - p.r
				p.vx = -p.vx * BOUNCE_WALL
				p.vrot = -p.vrot * 0.8
			end

			if p.y < p.r then
				p.y = p.r
				p.vy = -p.vy * BOUNCE_WALL
			end

			if p.y > H - p.r then
				p.y = H - p.r
				p.vy = -p.vy * BOUNCE_FLOOR
				if math.abs(p.vy) < 60 then p.vy = 0 end
				local friction = 1 - math.min(1, 6 * dt)
				p.vx *= friction
				p.vrot *= friction
			end
		end

		-- 2) colisão entre os corações
		for i = 1, #hearts - 1 do
			local a = hearts[i]
			for j = i + 1, #hearts do
				local b = hearts[j]
				local dx, dy = b.x - a.x, b.y - a.y
				local minDist = a.r + b.r
				local distSq = dx * dx + dy * dy
				if distSq < minDist * minDist and distSq > 0.0001 then
					local dist = math.sqrt(distSq)
					local nx, ny = dx / dist, dy / dist

					-- separa os dois
					local overlap = (minDist - dist) / 2
					a.x -= nx * overlap
					a.y -= ny * overlap
					b.x += nx * overlap
					b.y += ny * overlap

					-- troca de velocidade na direção do choque
					local vn = (b.vx - a.vx) * nx + (b.vy - a.vy) * ny
					if vn < 0 then
						local impulse = -(1 + RESTITUTION) * vn / 2
						a.vx -= impulse * nx
						a.vy -= impulse * ny
						b.vx += impulse * nx
						b.vy += impulse * ny
					end
				end
			end
		end

		-- 3) mantém dentro da tela e atualiza a posição na tela
		for _, p in ipairs(hearts) do
			p.x = math.clamp(p.x, p.r, W - p.r)
			p.y = math.clamp(p.y, p.r, H - p.r)
			p.label.Position = UDim2.fromOffset(p.x, p.y)
			p.label.Rotation = p.rot
		end
	end

	-- 5) o beijo original volta a ficar minúsculo, "de onde veio"
	tween(kissScale, 0.6, { Scale = 0.02 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		.Completed:Connect(function() kiss:Destroy() end)

	-- 6) simula a física e, ao fim do tempo, some tudo
	local startTime = os.clock()
	local fading = false
	while true do
		local dt = math.min(RunService.Heartbeat:Wait(), 1 / 30)
		local elapsed = os.clock() - startTime
		stepHearts(dt)

		if not fading and elapsed >= TOTAL_TIME - FADE_TIME then
			fading = true
			tween(mark, FADE_TIME, { TextTransparency = 1 })
			for _, p in ipairs(hearts) do
				tween(p.label, FADE_TIME, { TextTransparency = 1 })
			end
		end
		if elapsed >= TOTAL_TIME then break end
	end

	introGui:Destroy()
	onDone()
end

