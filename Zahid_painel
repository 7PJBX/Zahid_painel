-- ===== TELECINESE (mini menu independente: pegar, mira, up/down, jogar) =====
-- Com o botão "telecinese" ligado, o mini menu abre ao lado do menu principal e continua aberto mesmo
-- que você feche o menu principal. Toque numa parte do mapa para selecionar:
--   borda VERMELHA = parte ancorada | borda AZUL = parte não ancorada.
-- pegar: traz a parte selecionada até você (de qualquer distância) e a deixa flutuando atrás e acima de você.
-- mira : mostra a linha da trajetória do arremesso (vai para onde a câmera aponta); up/down ajustam a mira.
-- jogar: arremessa a parte segurada com a força definida em "power".
do
	local power = 20.7263        -- força do arremesso (velocidade inicial em studs por segundo). Maior = mais longe
	local AIM_STEP_DEG = 3       -- quanto cada toque em up/down muda a mira (graus)
	local AIM_LIMIT_DEG = 80     -- limite da mira para cima e para baixo (graus)
	local HOLD_BACK = 4          -- distância atrás de você (studs, somada ao tamanho da parte)
	local HOLD_UP = 4            -- altura acima de você (studs, somada ao tamanho da parte)
	local PULL_SPEED_MAX = 400   -- velocidade máxima com que a parte vem até você
	local TAP_TOLERANCE = 12     -- pixels que o dedo pode mexer e ainda contar como "toque"
	local RAY_LENGTH = 5000      -- alcance do toque para selecionar (studs)
	local AIM_POINTS = 40        -- quantos trechos tem a linha da mira
	local AIM_TIME_STEP = 0.06   -- tempo de voo (s) de cada trecho da linha da mira
	local RED = Color3.fromRGB(255, 60, 60)
	local BLUE = Color3.fromRGB(70, 140, 255)
	local NOTICE_RED = Color3.fromRGB(255, 110, 110)
	local MINI_W, MINI_H = PANEL_W, 246

	local on = false
	local selected, highlight
	local held              -- { part, att, ap, ao, rel, offset, saved } enquanto estou segurando uma parte
	local aimOn = false
	local aimPitch = 0      -- ajuste da mira (graus): positivo = para cima
	local aimFolder, aimSegs, aimEnd
	local claimUntil = 0
	local press
	local pointer = Vector2.zero
	local connList = {}
	local menu, status, info, aimBtn
	local noticeUntil = 0

	local function getRoot()
		return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	end

	local function isAnchored(part)
		if part.Anchored then return true end
		local root = part.AssemblyRootPart
		return root ~= nil and root.Anchored
	end

	-- o toque está em cima do meu menu?
	local function overMenu(pos)
		local pg = player:FindFirstChildOfClass("PlayerGui")
		local ui = pg and pg:FindFirstChild("MiniMenu")
		if not ui then return false end
		for _, obj in ipairs(pg:GetGuiObjectsAtPosition(pos.X, pos.Y)) do
			if obj:IsDescendantOf(ui) then return true end
		end
		return false
	end

	local function belongsToPlayer(inst)
		local m = inst
		while m and m ~= workspace do
			if m:IsA("Model") and Players:GetPlayerFromCharacter(m) then return true end
			m = m.Parent
		end
		return false
	end

	-- qual parte do mapa está sob o dedo
	local function pick(pos)
		local cam = workspace.CurrentCamera
		local ray = cam:ScreenPointToRay(pos.X, pos.Y)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local ignore = {}
		if player.Character then table.insert(ignore, player.Character) end
		if floatPart then table.insert(ignore, floatPart) end
		params.FilterDescendantsInstances = ignore
		local result = workspace:Raycast(ray.Origin, ray.Direction * RAY_LENGTH, params)
		local inst = result and result.Instance
		if not inst or not inst:IsA("BasePart") or inst:IsA("Terrain") then return nil end
		if belongsToPlayer(inst) then return nil end
		return inst
	end

	local function clearSelection()
		if highlight then highlight:Destroy() highlight = nil end
		selected = nil
	end

	local function selectPart(part)
		clearSelection()
		selected = part
		local hl = Instance.new("Highlight")
		hl.Adornee = part
		hl.FillTransparency = 1
		hl.OutlineTransparency = 0
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.OutlineColor = isAnchored(part) and RED or BLUE
		hl.Parent = part
		highlight = hl
	end

	-- pisca o preenchimento da seleção (aviso rápido)
	local function flash(color)
		local hl = highlight
		if not hl then return end
		hl.FillColor = color
		hl.FillTransparency = 0.5
		task.delay(0.25, function()
			if hl.Parent then hl.FillTransparency = 1 end
		end)
	end

	-- aviso no texto do mini menu (vermelho, some sozinho)
	local function notice(text)
		status.Text = text
		status.TextColor3 = NOTICE_RED
		noticeUntil = os.clock() + 1.8
	end

	-- fica com a física das partes soltas, mesmo longe (precisa repetir a cada frame)
	local function claimPhysics()
		pcall(function() player.MaximumSimulationRadius = 1e9 end)
		if sethiddenproperty then pcall(sethiddenproperty, player, "SimulationRadius", 1e9) end
	end

	-- onde a parte fica em relação a mim: atrás (+Z) e acima, mais longe se a parte for grande
	local function holdOffset(part)
		local r = part and (part.Size.Magnitude / 2) or 1
		return Vector3.new(0, HOLD_UP + r * 0.5, HOLD_BACK + r)
	end

	-- ===== segurar a parte =====
	local function buildHold(h)
		local part = h.part
		if h.ap then h.ap:Destroy() end
		if h.ao then h.ao:Destroy() end
		if h.att then h.att:Destroy() end

		local att = Instance.new("Attachment")
		att.Parent = part

		local ap = Instance.new("AlignPosition")
		ap.Mode = Enum.PositionAlignmentMode.OneAttachment
		ap.Attachment0 = att
		ap.RigidityEnabled = false
		ap.MaxForce = math.huge
		ap.MaxVelocity = PULL_SPEED_MAX
		ap.Responsiveness = 30
		ap.Position = part.Position
		ap.Parent = part

		local ao = Instance.new("AlignOrientation")
		ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
		ao.Attachment0 = att
		ao.MaxTorque = math.huge
		ao.Responsiveness = 20
		ao.CFrame = part.CFrame.Rotation
		ao.Parent = part

		h.att, h.ap, h.ao = att, ap, ao
	end

	local function releaseHeld()
		local h = held
		held = nil
		if not h then return end
		if h.ap then h.ap:Destroy() end
		if h.ao then h.ao:Destroy() end
		if h.att then h.att:Destroy() end
		for q, cc in pairs(h.saved) do
			if q.Parent then q.CanCollide = cc end
		end
	end

	local function grabPart()
		if held then
			notice("Você já está com uma parte.")
			return
		end
		local part = selected
		if not part or not part.Parent then
			notice("Selecione uma parte primeiro.")
			return
		end
		if isAnchored(part) then
			flash(RED)
			notice("Parte ancorada: não dá para pegar.")
			return
		end
		local hrp = getRoot()
		if not hrp then return end
		claimPhysics()

		-- sem colisão enquanto a parte vem até mim e fica atrás de mim (volta ao normal ao jogar)
		local saved = { [part] = part.CanCollide }
		for _, q in ipairs(part:GetConnectedParts(true)) do saved[q] = q.CanCollide end
		for q in pairs(saved) do q.CanCollide = false end

		local h = {
			part = part,
			offset = holdOffset(part),
			rel = hrp.CFrame.Rotation:Inverse() * part.CFrame.Rotation, -- mantém a rotação em relação a mim
			saved = saved,
		}
		buildHold(h)
		held = h

		-- se a parte não chegar perto de mim, avisa (provavelmente o servidor controla a física dela)
		local delaySec = (part.Position - hrp.Position).Magnitude / PULL_SPEED_MAX + 2.5
		task.delay(delaySec, function()
			if held ~= h then return end
			local hr = getRoot()
			if hr and h.part.Parent and (h.part.Position - hr.Position).Magnitude > 40 then
				notice("A parte não obedeceu (o servidor controla a física dela).")
			end
		end)
	end

	-- direção da câmera com o ajuste da mira (up/down)
	local function aimDirection()
		local cam = workspace.CurrentCamera
		local rot = CFrame.fromAxisAngle(cam.CFrame.RightVector, math.rad(aimPitch))
		return rot:VectorToWorldSpace(cam.CFrame.LookVector)
	end

	local function throwPart()
		local h = held
		if not h then
			notice("Pegue uma parte primeiro.")
			return
		end
		local part = h.part
		local dir = aimDirection()
		releaseHeld()
		part.AssemblyAngularVelocity = Vector3.zero
		part.AssemblyLinearVelocity = dir * power
		claimUntil = os.clock() + 4 -- continua com a física dela durante o voo
	end

	-- ===== linha da trajetória (mira) =====
	local function destroyAim()
		if aimFolder then aimFolder:Destroy() end
		aimFolder, aimSegs, aimEnd = nil, nil, nil
	end

	local function createAim()
		destroyAim()
		aimFolder = Instance.new("Folder")
		aimFolder.Name = "TelecineseMira"
		aimFolder.Parent = workspace
		aimSegs = {}
		local function newPart(shape, size)
			local p = Instance.new("Part")
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Material = Enum.Material.Neon
			p.Color = Color3.fromRGB(80, 210, 255)
			p.Shape = shape
			p.Size = size
			p.Transparency = 1
			p.Parent = aimFolder
			return p
		end
		for i = 1, AIM_POINTS do
			aimSegs[i] = newPart(Enum.PartType.Block, Vector3.new(0.18, 0.18, 1))
		end
		aimEnd = newPart(Enum.PartType.Ball, Vector3.new(0.9, 0.9, 0.9))
	end

	local function updateAim()
		if not aimOn or not aimFolder then return end
		local hrp = getRoot()
		local cam = workspace.CurrentCamera
		if not hrp or not cam then return end

		-- começa onde a parte está (ou onde ela ficaria ao ser pega)
		local start
		if held then
			start = held.part.Position
		else
			start = hrp.CFrame:PointToWorldSpace(holdOffset(selected))
		end

		local v0 = aimDirection() * power
		local g = Vector3.new(0, -workspace.Gravity, 0)

		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local ignore = {}
		if player.Character then table.insert(ignore, player.Character) end
		if held then
			for q in pairs(held.saved) do table.insert(ignore, q) end
		end
		if floatPart then table.insert(ignore, floatPart) end
		params.FilterDescendantsInstances = ignore

		local prev = start
		local used = 0
		for i = 1, AIM_POINTS do
			local t = i * AIM_TIME_STEP
			local pt = start + v0 * t + 0.5 * g * t * t
			local seg = aimSegs[i]
			used = i

			local delta = pt - prev
			local finish = pt
			local stop = false
			if delta.Magnitude > 0.01 then
				local hit = workspace:Raycast(prev, delta, params)
				if hit then
					finish = hit.Position
					stop = true
				end
			end

			local l = (finish - prev).Magnitude
			if l > 0.01 then
				seg.Size = Vector3.new(0.18, 0.18, l)
				seg.CFrame = CFrame.lookAt((prev + finish) / 2, finish)
				seg.Transparency = 0.15
			else
				seg.Transparency = 1
			end
			prev = finish
			if stop then break end
		end
		for i = used + 1, AIM_POINTS do aimSegs[i].Transparency = 1 end

		aimEnd.CFrame = CFrame.new(prev)
		aimEnd.Transparency = 0.1
	end

	-- ===== a cada frame =====
	local function step()
		if selected then
			if not selected.Parent then
				releaseHeld()
				clearSelection()
			elseif highlight then
				highlight.OutlineColor = isAnchored(selected) and RED or BLUE
			end
		end

		local h = held
		if h then
			claimPhysics()
			local part = h.part
			if not part.Parent then
				releaseHeld()
				return
			end
			-- se algo removeu os controles da parte, recria
			if h.att.Parent ~= part or h.ap.Parent ~= part or h.ao.Parent ~= part then
				buildHold(h)
			end
			local hrp = getRoot()
			if hrp then
				-- fica atrás e acima de mim, acompanhando meus movimentos e minha rotação
				local target = hrp.CFrame:PointToWorldSpace(h.offset)
				h.ap.Position = target
				h.ap.MaxVelocity = math.clamp((part.Position - target).Magnitude * 3, 100, PULL_SPEED_MAX)
				h.ao.CFrame = hrp.CFrame.Rotation * h.rel
			end
		elseif os.clock() < claimUntil then
			claimPhysics()
		end
	end

	-- ===== seleção por toque =====
	local function onBegan(input, processed)
		if not isPress(input) then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 and processed then return end
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		if overMenu(pos) then return end
		pointer = pos
		press = { pos = pos, input = input }
	end

	local function onChanged(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			pointer = Vector2.new(input.Position.X, input.Position.Y)
		elseif input.UserInputType == Enum.UserInputType.Touch then
			if press and press.input == input then
				pointer = Vector2.new(input.Position.X, input.Position.Y)
			end
		end
	end

	local function onEnded(input)
		if not isPress(input) then return end
		if input.UserInputType == Enum.UserInputType.Touch then
			if press and press.input ~= input then return end -- outro dedo
		end
		local p = press
		press = nil
		if not p then return end
		if (pointer - p.pos).Magnitude > TAP_TOLERANCE then return end -- arrastou (mexeu a câmera)
		if held then return end -- segurando uma parte: a seleção fica travada até jogar

		local part = pick(p.pos)
		if part then
			if selected == part then clearSelection() else selectPart(part) end
		else
			clearSelection()
		end
	end

	-- ===== mini menu =====
	menu = Instance.new("Frame")
	menu.Size = UDim2.fromOffset(MINI_W, MINI_H)
	menu.Position = UDim2.fromOffset(PANEL_W + 6, BUBBLE_H + 8)
	menu.Active = true
	menu.Visible = false
	menu.Parent = bubble
	Instance.new("UICorner", menu).CornerRadius = UDim.new(0, 14)
	addGradient(menu)

	local labels = {}
	local function miniLabel(y, h)
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, -16, 0, h)
		l.Position = UDim2.fromOffset(8, y)
		l.BackgroundTransparency = 1
		l.Font = T.font
		l.TextSize = 13
		l.TextWrapped = true
		l.TextTruncate = Enum.TextTruncate.AtEnd
		l.TextColor3 = T.text
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.TextYAlignment = Enum.TextYAlignment.Top
		l.Text = ""
		l.Parent = menu
		table.insert(labels, l)
		return l
	end

	status = miniLabel(6, 40)
	info = miniLabel(208, 32)

	local function fullButton(text, y)
		return new3DButton(menu, text, UDim2.fromOffset(8, y), UDim2.new(1, -16, 0, ROW_H), T.faceOff, T.baseOff)
	end
	local halfW = (MINI_W - 16 - 8) / 2

	local grabBtn = fullButton("pegar", 48)
	grabBtn.face.Activated:Connect(grabPart)

	aimBtn = fullButton("mira", 88)
	aimBtn.face.Activated:Connect(function()
		aimOn = not aimOn
		aimBtn.setOn(aimOn)
		if aimOn then createAim() else destroyAim() end
	end)

	-- up/down: um toque ajusta um passo; segurando, repete
	local function bindHold(button, fn)
		local down = false
		button.InputBegan:Connect(function(input)
			if not isPress(input) then return end
			down = true
			fn()
			task.spawn(function()
				task.wait(0.35)
				while down and button.Parent do
					fn()
					task.wait(0.07)
				end
			end)
		end)
		local function stop(input)
			if isPress(input) then down = false end
		end
		button.InputEnded:Connect(stop)
		UIS.InputEnded:Connect(stop)
	end

	local upBtn = new3DButton(menu, "up", UDim2.fromOffset(8, 128), UDim2.fromOffset(halfW, ROW_H), T.faceOff, T.baseOff)
	bindHold(upBtn.face, function()
		aimPitch = math.min(AIM_LIMIT_DEG, aimPitch + AIM_STEP_DEG)
	end)
	local downBtn = new3DButton(menu, "down", UDim2.fromOffset(8 + halfW + 8, 128), UDim2.fromOffset(halfW, ROW_H), T.faceOff, T.baseOff)
	bindHold(downBtn.face, function()
		aimPitch = math.max(-AIM_LIMIT_DEG, aimPitch - AIM_STEP_DEG)
	end)

	local throwBtn = fullButton("jogar", 168)
	throwBtn.face.Activated:Connect(throwPart)

	local function statusText()
		if held then return "Segurando: " .. held.part.Name .. ". Mire e jogue." end
		if selected then
			if isAnchored(selected) then return "Parte ancorada: não dá para pegar." end
			return "Selecionada: " .. selected.Name .. ". Toque em pegar."
		end
		return "Toque numa parte para selecionar."
	end

	-- posição: ao lado do menu principal (o lado livre, se a lista de jogadores estiver aberta);
	-- com o menu principal fechado, fica logo abaixo do botão
	local function placeMenu()
		local x = 0
		if panel.Visible then
			local screenW = gui.AbsoluteSize.X
			local bx = bubble.AbsolutePosition.X
			local rightFits = bx + PANEL_W + 6 + MINI_W <= screenW
			local leftFits = bx - MINI_W - 6 >= 0
			local listOnRight = list.Visible and list.Position.X.Offset > 0
			if rightFits and not listOnRight then
				x = PANEL_W + 6
			elseif leftFits then
				x = -MINI_W - 6
			else
				x = PANEL_W + 6
			end
		end
		menu.Position = UDim2.fromOffset(x, BUBBLE_H + 8)
	end

	local lastStatus
	RunService.Heartbeat:Connect(function()
		if not menu.Visible then return end
		placeMenu()
		if os.clock() >= noticeUntil then
			local s = statusText()
			if s ~= lastStatus or status.TextColor3 == NOTICE_RED then
				lastStatus = s
				status.Text = s
				status.TextColor3 = T.text
			end
		end
		info.Text = string.format("Power: %.4f\nMira: %+d graus", power, math.floor(aimPitch + 0.5))
	end)

	-- ===== botão "telecinese" no menu principal =====
	local function setTele(enable)
		if enable == on then return end
		on = enable
		menu.Visible = enable
		if enable then
			for _, l in ipairs(labels) do
				l.Font = T.font
				if l ~= status then l.TextColor3 = T.text end
			end
			lastStatus = nil
			table.insert(connList, UIS.InputBegan:Connect(onBegan))
			table.insert(connList, UIS.InputChanged:Connect(onChanged))
			table.insert(connList, UIS.InputEnded:Connect(onEnded))
			table.insert(connList, RunService.Heartbeat:Connect(step))
			table.insert(connList, RunService.RenderStepped:Connect(updateAim))
		else
			for _, c in ipairs(connList) do c:Disconnect() end
			table.clear(connList)
			releaseHeld()
			clearSelection()
			press = nil
			aimOn = false
			aimBtn.setOn(false)
			destroyAim()
		end
	end

	partsBtn.face.Text = "telecinese"
	partsBtn.face.Activated:Connect(function()
		setTele(not on)
		partsBtn.setOn(on)
	end)
end

-- ===== ABRIR / FECHAR O PAINEL (com animação) =====
local panelOpen = false
local function setPanel(open)
	panelOpen = open
	if not IS_ROMANTIC then
		tween(bubble, 0.25, { BackgroundColor3 = open and T.bubbleBgOpen or T.bubbleBg })
	end
	if open then
		panel.Visible = true
		panelScale.Scale = 0.6
		tween(panelScale, 0.28, { Scale = 1 }, Enum.EasingStyle.Back)
	else
		if listOpen then setList(false) end
		local t = tween(panelScale, 0.15, { Scale = 0.6 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		t.Completed:Connect(function()
			if not panelOpen then panel.Visible = false end
		end)
	end
end

-- ===== TROCA PARA A VERSÃO DARK (o coração vermelho vira preto) =====
local HOLD_TIME = 1 -- segundos segurando o coração
local themeSwitching = false

local function applyDarkTheme()
	T = THEMES.dark
	IS_ROMANTIC = false

	-- botões 3D: trocam para as cores equivalentes do tema dark (mantendo ligado/desligado)
	for _, obj in ipairs(themed3D) do
		if obj.holder.Parent then
			obj.face.Font = T.font
			tween(obj.face, 0.35, {
				BackgroundColor3 = obj.isOn and T.faceOn or T["face" .. obj.role],
				TextColor3 = obj.isOn and T.textOn or T.text,
			})
			tween(obj.base, 0.35, { BackgroundColor3 = obj.isOn and T.baseOn or T["base" .. obj.role] })
		end
	end

	-- degradê do painel e da lista, e barras de rolagem
	for _, g in ipairs(gradients) do
		if g.Parent then
			g.Color = ColorSequence.new(T.panelTop, T.panelBottom)
		end
	end
	content.ScrollBarImageColor3 = T.scroll
	list.ScrollBarImageColor3 = T.scroll

	-- o coração vira o retângulo "Zahid painel" em fonte emo
	BUBBLE_H = 34
	bubble.Size = UDim2.fromOffset(120, 34)
	bubble.Text = "Zahid painel"
	bubble.Font = EMO_FONT
	bubble.TextColor3 = T.text
	bubble.BackgroundColor3 = T.bubbleBg
	bubble.BackgroundTransparency = 0
	Instance.new("UICorner", bubble).CornerRadius = UDim.new(0, 10)
	local bubbleLimit = Instance.new("UITextSizeConstraint")
	bubbleLimit.MaxTextSize = 20
	bubbleLimit.Parent = bubble
	panel.Position = UDim2.fromOffset(0, BUBBLE_H + 8)
