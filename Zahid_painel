-- ===== SONS DOS BOTÕES (pop, retro e gota) =====
local playSfx, loadSfx
do
-- Usa sons que já vêm no cliente do Roblox; cada som é feito de "camadas" (um arquivo tocado com altura que muda).
-- Para cada camada o código testa os caminhos da lista e usa o primeiro que existir.
--   pop   = estourar uma bolinha: um "estalo" curto + um "bloop" de altura descendo
--   retro = o click clássico (antigo) do Roblox
--   gota  = uma única gota caindo na água: um "plin" curto de altura subindo, que some rápido
local SFX_DEFS = {
	pop = {
		{ cand = { "rbxasset://sounds/snap.mp3", "rbxasset://sounds/clickfast.mp3" }, s0 = 1.7, s1 = 1.7, vol = 0.55, dur = 0.14 },
		{ cand = { "rbxasset://sounds/electronicpingshort.mp3" }, s0 = 2.8, s1 = 0.9, vol = 0.32, dur = 0.12 },
	},
	retro = {
		{ cand = { "rbxasset://sounds/button.mp3", "rbxasset://sounds/switch.mp3", "rbxasset://sounds/SWITCH3.mp3" }, s0 = 1.0, s1 = 1.0, vol = 0.6, dur = 0.4 },
	},
	gota = {
		{ cand = { "rbxasset://sounds/electronicpingshort.mp3" }, s0 = 1.25, s1 = 2.4, vol = 0.4, dur = 0.2 },
	},
}
local SFX_ORDER = { "pop", "retro", "gota" }
local sfxReady = {}    -- [nome] = lista de camadas prontas { sound, s0, s1, vol, dur, token }

function playSfx(name)
	if not config.sound then return end
	local layers = sfxReady[name or config.soundName]
	if not layers then return end
	for _, ly in ipairs(layers) do
		local s = ly.sound
		if s.Parent then
			ly.token += 1
			local mine = ly.token
			s.PlaybackSpeed = ly.s0
			s.Volume = ly.vol
			s.TimePosition = 0
			s:Play()
			if ly.s1 ~= ly.s0 then
				tween(s, ly.dur * 0.7, { PlaybackSpeed = ly.s1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			end
			tween(s, ly.dur, { Volume = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(ly.dur + 0.02, function()
				if ly.token == mine then s:Stop() end
			end)
		end
	end
end

-- carrega os sons em segundo plano (sem travar a abertura do menu)
function loadSfx(parent)
	task.spawn(function()
		for _, name in ipairs(SFX_ORDER) do
			local ready = {}
			for _, def in ipairs(SFX_DEFS[name]) do
				for _, path in ipairs(def.cand) do
					local s = Instance.new("Sound")
					s.SoundId = path
					s.Volume = 0
					s.Parent = parent
					local t0 = os.clock()
					while not s.IsLoaded and os.clock() - t0 < 2 do task.wait(0.05) end
					if s.IsLoaded and s.TimeLength > 0 then
						table.insert(ready, { sound = s, s0 = def.s0, s1 = def.s1, vol = def.vol, dur = def.dur, token = 0 })
						break
					end
					s:Destroy()
				end
			end
			if #ready > 0 then sfxReady[name] = ready end
		end
	end)
end
end

-- ===== BOTÃO 3D =====
-- dois retângulos arredondados: o corpo (escuro) fica parado e a face desce por cima dele ao apertar.
-- role escolhe as cores: "Off", "Tp", "Help", "Net" ou "Danger" (as cores seguem o tema)
local pressedFaces = {}

-- ao soltar o dedo/mouse em qualquer lugar, todas as faces apertadas voltam para cima (efeito mola)
UIS.InputEnded:Connect(function(input)
	if not isPress(input) then return end
	for face in pairs(pressedFaces) do
		pressedFaces[face] = nil
		tween(face, 0.14, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
	end
end)

local function new3DButton(parent, text, position, size, role)
	role = role or "Off"
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Position = position
	holder.Size = size
	holder.Parent = parent

	local faceH = size.Y.Offset - DEPTH

	local base = Instance.new("Frame")
	base.Size = UDim2.new(1, 0, 0, faceH)
	base.Position = UDim2.fromOffset(0, DEPTH)
	base.BackgroundColor3 = T["base" .. role]
	base.BorderSizePixel = 0
	base.Parent = holder
	Instance.new("UICorner", base).CornerRadius = UDim.new(0, 10)

	local face = Instance.new("TextButton")
	face.Size = UDim2.new(1, 0, 0, faceH)
	face.Position = UDim2.fromOffset(0, 0)
	face.BackgroundColor3 = T["face" .. role]
	face.BorderSizePixel = 0
	face.AutoButtonColor = false
	face.Font = FONT
	face.TextColor3 = T.text
	face.TextSize = 14
	face.TextTruncate = Enum.TextTruncate.AtEnd
	face.Text = text
	face.Parent = holder
	Instance.new("UICorner", face).CornerRadius = UDim.new(0, 10)

	local obj = { holder = holder, base = base, face = face, role = role, isOn = false }

	face.InputBegan:Connect(function(input)
		if isPress(input) then
			pressedFaces[face] = true
			tween(face, 0.06, { Position = UDim2.fromOffset(0, DEPTH) })
			playSfx()
		end
	end)

	-- aceso/apagado
	function obj.setOn(on)
		obj.isOn = on
		tween(face, 0.2, { BackgroundColor3 = on and T.faceOn or T["face" .. role], TextColor3 = on and T.textOn or T.text })
		tween(base, 0.2, { BackgroundColor3 = on and T.baseOn or T["base" .. role] })
	end

	-- repinta com as cores do tema atual (sem animação)
	function obj.applyTheme()
		face.BackgroundColor3 = obj.isOn and T.faceOn or T["face" .. role]
		face.TextColor3 = obj.isOn and T.textOn or T.text
		base.BackgroundColor3 = obj.isOn and T.baseOn or T["base" .. role]
	end

	if #buttons3D > 160 then
		for i = #buttons3D, 1, -1 do
			if not buttons3D[i].holder.Parent then table.remove(buttons3D, i) end
		end
	end
	table.insert(buttons3D, obj)
	return obj
end

