-- ===== ANTI PART FLING (refeito do zero) =====
-- Ligado: procura partes soltas do mapa que ficam muito rápidas por mais de 0.2 segundo seguido; ao passar disso, tira a
-- colisão delas e deixa 95% transparentes. Elas só voltam ao normal depois de ficarem paradas por 3 segundos. Também tira a colisão das minhas partes, por precaução. Uma informação pequena
-- na tela mostra "detectando" e, depois dos 2 segundos, quantas partes foram detectadas e removidas.
-- (usa CORE_PARTS, definido no bloco do AntiFling, para devolver a colisão ao desligar)
local apfActive = false
local antiPartFling
do

	local FAST_LIN = 20       -- studs/s
	local FAST_ANG = 2        -- rad/s
	local FAST_SECONDS = 0.2     -- tempo seguido acima do limite antes de remover a colisão
	local SCAN_RADIUS = 400    -- só olha as partes até essa distância de mim
	local SCAN_EVERY = 0.05     -- segundos entre uma varredura e outra
	local RESULT_SECONDS = 5   -- quanto tempo o resultado fica na tela
	local STILL_SECONDS = 3    -- tempo parada para voltar ao normal
	local STILL_LIN = 1        -- abaixo disso (studs/s) a parte conta como parada
	local STILL_ANG = 0.5      -- abaixo disso (rad/s) a parte conta como parada

	local mine = {}            -- [minha parte] = CanCollide original
	local removed = {}         -- [parte] = { cc, tr } originais das partes já removidas
	local since = {}           -- [parte] = quando começou a ficar rápida
	local stillSince = {}      -- [parte] = quando começou a ficar parada (das já removidas)
	local detectedSet = {}     -- partes já detectadas nesta ativação
	local detectedN, removedN = 0, 0
	local lastScan, resultUntil = 0, 0
	local hudGui, hudLabel

	local scanParams = OverlapParams.new()
	scanParams.FilterType = Enum.RaycastFilterType.Exclude
	scanParams.MaxParts = 1500

	local function hudText(text)
		if hudLabel and hudLabel.Text ~= text then hudLabel.Text = text end
	end
	local function createHud()
		if hudGui then hudGui:Destroy() end
		hudGui = Instance.new("ScreenGui")
		hudGui.Name = "AntiPartFlingInfo"
		hudGui.ResetOnSpawn = false
		hudGui.DisplayOrder = 30
		hudGui.Parent = player:WaitForChild("PlayerGui")
		hudLabel = Instance.new("TextLabel")
		hudLabel.AnchorPoint = Vector2.new(0.5, 0)
		hudLabel.Position = UDim2.new(0.5, 0, 0, 4)
		hudLabel.Size = UDim2.fromOffset(250, 18)
		hudLabel.BackgroundColor3 = Color3.new(0, 0, 0)
		hudLabel.BackgroundTransparency = 0.55
		hudLabel.BorderSizePixel = 0
		hudLabel.Font = Enum.Font.GothamMedium
		hudLabel.TextSize = 11
		hudLabel.TextColor3 = Color3.fromRGB(235, 235, 240)
		hudLabel.Text = "Anti Part Fling: ativo"
		hudLabel.Active = false
		hudLabel.Parent = hudGui
		Instance.new("UICorner", hudLabel).CornerRadius = UDim.new(0, 8)
	end

	local function restoreAll()
		for part, cc in pairs(mine) do
			if part.Parent then part.CanCollide = cc end
			mine[part] = nil
		end
		local char = player.Character
		if char then
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") and CORE_PARTS[part.Name] then
					part.CanCollide = true
				end
			end
		end
		for part, o in pairs(removed) do
			if part.Parent then
				part.CanCollide = o.cc
				part.Transparency = o.tr
			end
			removed[part] = nil
		end
		since, detectedSet, stillSince = {}, {}, {}
		detectedN, removedN = 0, 0
		if hudGui then hudGui:Destroy() hudGui, hudLabel = nil, nil end
	end

	-- varre o mapa atrás de partes soltas muito rápidas
	local function scan(now)
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		local ex = { char }
		-- personagens dos outros jogadores (corpo, roupas e acessórios) não entram na detecção
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p.Character then ex[#ex + 1] = p.Character end
		end
		if floatPart then ex[#ex + 1] = floatPart end
		scanParams.FilterDescendantsInstances = ex
		local seen = {}
		local candidates = 0
		local removedNow = false
		for _, part in ipairs(workspace:GetPartBoundsInRadius(hrp.Position, SCAN_RADIUS, scanParams)) do
			if not part.Anchored and not removed[part] then
				if part.AssemblyLinearVelocity.Magnitude > FAST_LIN or part.AssemblyAngularVelocity.Magnitude > FAST_ANG then
					seen[part] = true
					if not detectedSet[part] then
						detectedSet[part] = true
						detectedN += 1
					end
					local t0 = since[part]
					if not t0 then
						since[part] = now
						candidates += 1
					elseif now - t0 > FAST_SECONDS then
						removed[part] = { cc = part.CanCollide, tr = part.Transparency }
						part.CanCollide = false
						part.Transparency = math.max(part.Transparency, 0.95)
						since[part] = nil
						removedN += 1
						removedNow = true
					else
						candidates += 1
					end
				end
			end
		end
		-- partes removidas: só voltam ao normal depois de ficarem paradas por STILL_SECONDS
		for part, o in pairs(removed) do
			if not part.Parent then
				removed[part] = nil
				stillSince[part] = nil
			else
				local moving = part.AssemblyLinearVelocity.Magnitude > STILL_LIN
					or part.AssemblyAngularVelocity.Magnitude > STILL_ANG
				if moving then
					stillSince[part] = nil
				else
					stillSince[part] = stillSince[part] or now
					if now - stillSince[part] >= STILL_SECONDS then
						part.CanCollide = o.cc
						part.Transparency = o.tr
						removed[part] = nil
						stillSince[part] = nil
					end
				end
			end
		end
		-- quem deixou de ser rápido (ou sumiu) zera a contagem
		for part in pairs(since) do
			if not seen[part] or not part.Parent then since[part] = nil end
		end
		if removedNow then resultUntil = now + RESULT_SECONDS end

		if candidates > 0 then
			hudText("Anti Part Fling: detectando... (" .. candidates .. ")")
		elseif now < resultUntil then
			hudText(string.format("Anti Part Fling: %d detectados | %d removidos", detectedN, removedN))
		else
			hudText("Anti Part Fling: ativo")
		end
	end

	antiPartFling = function(on)
		if conns.apf then conns.apf:Disconnect() conns.apf = nil end
		apfActive = on
		restoreAll()
		if not on then return end
		createHud()
		lastScan, resultUntil = 0, 0
		conns.apf = RunService.Stepped:Connect(function()
			-- minhas partes sem colisão (a física reativa a colisão a cada passo, por isso é todo quadro)
			local char = player.Character
			if char then
				for _, part in ipairs(char:GetDescendants()) do
					if part:IsA("BasePart") then
						if mine[part] == nil then mine[part] = part.CanCollide end
						part.CanCollide = false
					end
				end
			end
			local now = os.clock()
			if now - lastScan >= SCAN_EVERY then
				lastScan = now
				scan(now)
			end
		end)
	end
end

