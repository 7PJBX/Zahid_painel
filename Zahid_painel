-- ===== ABRIR / FECHAR O PAINEL (com animação) =====
local panelOpen = false
local function setPanel(open)
	panelOpen = open
	if open then
		panel.Visible = true
		panelScale.Scale = 0.6
		tween(panelScale, 0.28, { Scale = 1 }, Enum.EasingStyle.Back)
	else
		if listOpen then setList(false) end
		local t = tween(panelScale, 0.15, { Scale = 0.6 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		t.Completed:Connect(function()
			if not panelOpen then panel.Visible = false end
		end)
	end
end

-- ===== ARRASTAR O CORAÇÃO / CLICAR ABRE O MENU =====
local dragging, startPos, startInput, moved
bubble.InputBegan:Connect(function(input)
	if isPress(input) then
		dragging, moved = true, false
		startPos, startInput = bubble.Position, input.Position
	end
end)
UIS.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		local d = input.Position - startInput
		if d.Magnitude > 6 then moved = true end
		bubble.Position = UDim2.fromOffset(startPos.X.Offset + d.X, startPos.Y.Offset + d.Y)
	end
end)
UIS.InputEnded:Connect(function(input)
	if dragging and isPress(input) then
		dragging = false
		if not moved then
			setPanel(not panelOpen)
		end
	end
end)

-- ===== BOTÃO INICIAR (coração com a frase) =====
local function showStartButton()
	local startGui = Instance.new("ScreenGui")
	startGui.Name = "StartGui"
	startGui.IgnoreGuiInset = true
	startGui.ResetOnSpawn = false
	startGui.DisplayOrder = 100
	startGui.Parent = player:WaitForChild("PlayerGui")

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.fromOffset(110, 110)
	btn.AnchorPoint = Vector2.new(0.5, 0.5)
	btn.Position = UDim2.fromScale(0.5, 0.5)
	btn.BackgroundTransparency = 1
	btn.Text = ""
	btn.Parent = startGui

	local sc = Instance.new("UIScale")
	sc.Scale = 0.02
	sc.Parent = btn

	-- o coração
	local heart = Instance.new("TextLabel")
	heart.Size = UDim2.fromScale(1, 1)
	heart.BackgroundTransparency = 1
	heart.Text = "❤️"
	heart.Font = Enum.Font.GothamMedium
	heart.TextSize = 100
	heart.Parent = btn

	-- a frase por cima do coração (texto separado, por isso aceita outra fonte)
	local phrase = Instance.new("TextLabel")
	phrase.Size = UDim2.fromScale(0.7, 0.4)
	phrase.AnchorPoint = Vector2.new(0.5, 0.5)
	phrase.Position = UDim2.fromScale(0.5, 0.43) -- 0.5 = centro; menor = mais para cima
	phrase.BackgroundTransparency = 1
	phrase.Text = "te amo\nmi amore"
	phrase.Font = FONT
	phrase.TextScaled = true
	phrase.TextColor3 = Color3.new(1, 1, 1)
	phrase.TextStrokeColor3 = Color3.fromRGB(120, 0, 40)
	phrase.TextStrokeTransparency = 0.4
	phrase.Parent = btn

	-- aparece com um pop e fica "batendo" como um coração
	tween(sc, 0.5, { Scale = 1 }, Enum.EasingStyle.Back).Completed:Wait()
	local pulse = TweenService:Create(
		sc,
		TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Scale = 1.1 }
	)
	pulse:Play()

	-- espera o clique
	btn.Activated:Wait()
	pulse:Cancel()

	-- pop: cresce um pouco, fica minúsculo e some
	tween(sc, 0.15, { Scale = 1.3 }).Completed:Wait()
	tween(sc, 0.35, { Scale = 0.02 }, Enum.EasingStyle.Back, Enum.EasingDirection.In).Completed:Wait()
	startGui:Destroy()
end

