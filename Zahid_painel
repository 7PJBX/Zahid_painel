	local function header(text) return dynLabel(text, 13, "accent", true) end

	-- câmera do avatar (órbita: arrastar gira, +/- ou pinça dá zoom)
	local model, center, dist, minDist, maxDist = nil, Vector3.zero, 8, 3, 20
	local yaw, pitch = 0, 0
	local function updateCam()
		local rot = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
		local pos = center + rot:VectorToWorldSpace(Vector3.new(0, 0, dist))
		viewCam.CFrame = CFrame.lookAt(pos, center)
	end
	local function zoom(factor)
		dist = math.clamp(dist * factor, minDist, maxDist)
		updateCam()
	end
	zoomIn.face.Activated:Connect(function() zoom(0.85) end)
	zoomOut.face.Activated:Connect(function() zoom(1.18) end)

	local viewDrag, viewLast = nil, nil
	view.InputBegan:Connect(function(input)
