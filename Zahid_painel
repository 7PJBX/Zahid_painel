-- ===== ANTIFLING =====
local antiFlingSaved = {} -- [part] = CanCollide original
local CORE_PARTS = { HumanoidRootPart = true, Head = true, Torso = true, UpperTorso = true, LowerTorso = true }

-- devolve a colisão dos outros jogadores
local function restoreCollisions()
	-- 1) valor original guardado
	for part, original in pairs(antiFlingSaved) do
		if part.Parent then
			part.CanCollide = original
		end
		antiFlingSaved[part] = nil
	end
	-- 2) garante as partes principais de todos os outros jogadores
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			for _, part in ipairs(p.Character:GetDescendants()) do
				if part:IsA("BasePart") and CORE_PARTS[part.Name] then
					part.CanCollide = true
				end
			end
		end
	end
end

local function antiFling(on)
	if conns.antifling then conns.antifling:Disconnect() conns.antifling = nil end
	if conns.antiflingRestore then conns.antiflingRestore:Disconnect() conns.antiflingRestore = nil end

	if not on then
		restoreCollisions()
		-- reaplica por 1 segundo, caso algo mexa nessas parts logo depois
		local t0 = os.clock()
		conns.antiflingRestore = RunService.Stepped:Connect(function()
			if os.clock() - t0 > 1 then
				if conns.antiflingRestore then
					conns.antiflingRestore:Disconnect()
					conns.antiflingRestore = nil
				end
				return
			end
			restoreCollisions()
		end)
		return
	end

	conns.antifling = RunService.Stepped:Connect(function()
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p.Character then
				for _, part in ipairs(p.Character:GetDescendants()) do
					if part:IsA("BasePart") then
						if antiFlingSaved[part] == nil then
							antiFlingSaved[part] = part.CanCollide -- guarda o valor original
						end
						part.CanCollide = false
					end
				end
			end
		end
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if hrp and (hrp.AssemblyLinearVelocity.Magnitude > 150
			or hrp.AssemblyAngularVelocity.Magnitude > 50) then
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end
	end)
end

-- ===== TPTOOL (clica no chão e teleporta) =====
local tpEnabled = false
local function giveTpTool()
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack or backpack:FindFirstChild("TPTool") then return end
	local tool = Instance.new("Tool")
	tool.Name = "TPTool"
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.Activated:Connect(function()
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local mouse = player:GetMouse()
		if hrp and mouse.Hit then
			hrp.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0))
		end
	end)
	tool.Parent = backpack
end

local function removeTpTool()
	local bp = player:FindFirstChildOfClass("Backpack")
	if bp and bp:FindFirstChild("TPTool") then bp.TPTool:Destroy() end
	if player.Character and player.Character:FindFirstChild("TPTool") then
		player.Character.TPTool:Destroy()
	end
end

local function tpTool(on)
	tpEnabled = on
	if on then giveTpTool() else removeTpTool() end
end

player.CharacterAdded:Connect(function()
	if tpEnabled then
		task.wait(0.5)
		giveTpTool()
	end
end)

-- ===== FLY / VFLY =====
local FLY_SPEED = 60

local function stopFlight(key)
	if conns[key] then conns[key]:Disconnect() conns[key] = nil end
	local s = flyState[key]
	if s then
		if s.bv then s.bv:Destroy() end
		if s.bg then s.bg:Destroy() end
		if s.hum and not s.needSeat then s.hum.PlatformStand = false end
		flyState[key] = nil
	end
end

local function startFlight(key, needSeat)
	stopFlight(key)
	flyState[key] = { needSeat = needSeat }
	conns[key] = RunService.Heartbeat:Connect(function()
		local s = flyState[key]
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not s or not hum then return end

		local part
		if needSeat then
			part = hum.SeatPart
		else
			part = char:FindFirstChild("HumanoidRootPart")
		end

		-- sem alvo (ex.: VFly fora do veículo): limpa e espera
		if not part then
			if s.bv then s.bv:Destroy() s.bv = nil end
			if s.bg then s.bg:Destroy() s.bg = nil end
			s.target = nil
			return
		end

		-- alvo novo: cria os controladores de voo
		if part ~= s.target then
			if s.bv then s.bv:Destroy() end
			if s.bg then s.bg:Destroy() end
			s.target, s.hum = part, hum
			s.bv = Instance.new("BodyVelocity")
			s.bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
			s.bv.Velocity = Vector3.zero
			s.bv.Parent = part
			s.bg = Instance.new("BodyGyro")
			s.bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
			s.bg.P = 9e4
			s.bg.Parent = part
			if not needSeat then hum.PlatformStand = true end
		end

		local cam = workspace.CurrentCamera
		local rel = cam.CFrame:VectorToObjectSpace(hum.MoveDirection)
		local dir = cam.CFrame.LookVector * (-rel.Z) + cam.CFrame.RightVector * rel.X
		if UIS:IsKeyDown(Enum.KeyCode.Space) or UIS:IsKeyDown(Enum.KeyCode.E) then
			dir += Vector3.new(0, 1, 0)
		end
		if UIS:IsKeyDown(Enum.KeyCode.Q) then
			dir -= Vector3.new(0, 1, 0)
		end

		s.bv.Velocity = dir * FLY_SPEED
		s.bg.CFrame = cam.CFrame
	end)
end

local function fly(on)
	if on then startFlight("fly", false) else stopFlight("fly") end
end

local function vfly(on)
	if on then startFlight("vfly", true) else stopFlight("vfly") end
end

-- ===== FLOAT (plataforma invisível sob os pés; Q desce / E sobe) =====
local FLOAT_SPEED = 20
local floatPart, floatY
local floatUp, floatDown = false, false

local function floatToggle(on)
	if conns.float then conns.float:Disconnect() conns.float = nil end
	if floatPart then floatPart:Destroy() floatPart = nil end
	floatUp, floatDown = false, false
	if not on then return end

	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	floatPart = Instance.new("Part")
	floatPart.Name = "FloatPlatform"
	floatPart.Size = Vector3.new(6, 1, 6)
	floatPart.Anchored = true
	floatPart.CanCollide = true
	floatPart.CanQuery = false
	floatPart.Transparency = 1
	floatPart.Parent = workspace

	floatY = hrp.Position.Y - 3.5 -- topo da plataforma na altura dos pés

	conns.float = RunService.Heartbeat:Connect(function(dt)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root or not floatPart then return end

		local dy = 0
		if floatUp or UIS:IsKeyDown(Enum.KeyCode.E) then dy += 1 end
		if floatDown or UIS:IsKeyDown(Enum.KeyCode.Q) then dy -= 1 end
		floatY += dy * FLOAT_SPEED * dt

		floatPart.CFrame = CFrame.new(root.Position.X, floatY, root.Position.Z)
	end)
end

-- ===== NOCLIP (atravessa paredes e chão; usado pelo TP Ajuda) =====
local noclipSaved = {} -- [part] = CanCollide original

local function noclip(on)
	if conns.noclip then conns.noclip:Disconnect() conns.noclip = nil end

	if on then
		conns.noclip = RunService.Stepped:Connect(function()
			local char = player.Character
			if not char then return end
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					if noclipSaved[part] == nil then
						noclipSaved[part] = part.CanCollide -- guarda o valor original
					end
					part.CanCollide = false
				end
			end
		end)
		return
	end

	-- desligou: as colisões voltam
	for part, original in pairs(noclipSaved) do
		if part.Parent then
			part.CanCollide = original
		end
		noclipSaved[part] = nil
	end
	local char = player.Character
	if char then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and CORE_PARTS[part.Name] then
				part.CanCollide = true
			end
		end
	end
end

-- ===== RE (regenera o personagem e volta para o último lugar) =====
local reBusy = false
local function respawnHere(onDone)
	if reBusy then
		if onDone then onDone() end
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then
		if onDone then onDone() end
		return
	end

	reBusy = true
	local savedCF = hrp.CFrame
	local conn
	local function finish()
		if conn then conn:Disconnect() conn = nil end
		reBusy = false
		if onDone then onDone() end
	end

	conn = player.CharacterAdded:Connect(function(newChar)
		local newHrp = newChar:WaitForChild("HumanoidRootPart", 10)
		if newHrp then
			-- coloca duas vezes, para vencer o ponto de spawn do jogo
			task.wait()
			newHrp.CFrame = savedCF
			task.wait(0.15)
			newHrp.CFrame = savedCF
		end
		finish()
	end)

	hum.Health = 0 -- regenera o personagem

	-- segurança: se o personagem não voltar em 15s, libera o botão
	task.delay(15, function()
		if reBusy then finish() end
	end)
end

-- ===== FPS BOOST (sem mexer na distância de renderização) =====
-- Desliga sombras, efeitos pesados, partículas, reflexos e detalhes de malha,
-- simplifica materiais e destrava o limite de FPS (se o executor tiver setfpscap).
-- Não mexe no QualityLevel nem no alcance de renderização.
-- Tudo volta ao normal quando o botão é desligado.
local fpsSaved = {} -- [instância] = { [propriedade] = valor original }
local fpsToken = 0

local PART_FAST = { CastShadow = false, Reflectance = 0, Material = Enum.Material.SmoothPlastic }
local MESH_FAST = { RenderFidelity = Enum.RenderFidelity.Performance }
local EMIT_OFF = { Enabled = false }
local TERRAIN_FAST = { Decoration = false, WaterWaveSize = 0, WaterWaveSpeed = 0, WaterReflectance = 0 }
local LIGHT_FAST = { GlobalShadows = false }

local function getProp(inst, prop) return inst[prop] end
local function setProp(inst, prop, value) inst[prop] = value end

local function fpsApply(inst, props)
	local saved = fpsSaved[inst]
	if not saved then
		saved = {}
		fpsSaved[inst] = saved
	end
	for prop, value in pairs(props) do
		local ok, cur = pcall(getProp, inst, prop)
		if ok and cur ~= value then
			if saved[prop] == nil then saved[prop] = cur end -- guarda o original
			pcall(setProp, inst, prop, value)
		end
	end
end

local function fpsHandle(inst)
	if inst:IsA("Terrain") then
		fpsApply(inst, TERRAIN_FAST)
	elseif inst:IsA("BasePart") then
		-- não mexe nos personagens (jogadores e NPCs), para ninguém ficar com aparência estranha
		local model = inst:FindFirstAncestorOfClass("Model")
		if model and model:FindFirstChildOfClass("Humanoid") then return end
		fpsApply(inst, PART_FAST)
		if inst:IsA("MeshPart") then fpsApply(inst, MESH_FAST) end
	elseif inst:IsA("PostEffect") or inst:IsA("ParticleEmitter") or inst:IsA("Trail")
		or inst:IsA("Beam") or inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles") then
		fpsApply(inst, EMIT_OFF)
	end
end

local function fpsBoost(on)
	fpsToken += 1
	local token = fpsToken
	if conns.fpsWs then conns.fpsWs:Disconnect() conns.fpsWs = nil end
	if conns.fpsLt then conns.fpsLt:Disconnect() conns.fpsLt = nil end

	-- limite de FPS (só funciona em executores que têm setfpscap)
	pcall(function()
		if setfpscap then setfpscap(on and 999 or 60) end
	end)

	if not on then
		-- desligou: devolve tudo ao valor original, aos poucos para não travar
		local old = fpsSaved
		fpsSaved = {}
		task.spawn(function()
			local n = 0
			for inst, props in pairs(old) do
				if inst.Parent then
					for prop, value in pairs(props) do
						pcall(setProp, inst, prop, value)
					end
				end
				n += 1
				if n % 300 == 0 then task.wait() end
			end
		end)
		return
	end

	fpsApply(Lighting, LIGHT_FAST)

	-- o que aparecer depois (mapas com streaming, efeitos novos) também é otimizado
	conns.fpsWs = workspace.DescendantAdded:Connect(fpsHandle)
	conns.fpsLt = Lighting.DescendantAdded:Connect(fpsHandle)

	-- o que já existe é otimizado em lotes, sem congelar o jogo
	task.spawn(function()
		local n = 0
		for _, root in ipairs({ workspace, Lighting }) do
			for _, inst in ipairs(root:GetDescendants()) do
				if fpsToken ~= token then return end
				fpsHandle(inst)
				n += 1
				if n % 300 == 0 then task.wait() end
			end
		end
	end)
end

