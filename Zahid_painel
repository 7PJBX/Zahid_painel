	Players.PlayerAdded:Connect(function(p)
		queryFriend(p)
		if pickerOpen then refreshPicker() end
	end)
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then queryFriend(p) end
	end

	Players.PlayerRemoving:Connect(function(p)
		if p == selectedPlayer then
			selectedPlayer = nil
			selectBtn.face.Text = "Selecionar jogador"
			if spectating then stopSpectate() end
		end
		if pickerOpen then task.defer(refreshPicker) end
	end)

	-- ===== TP e ESPECTAR =====
	local tpBtn, specBtn = rowBtns(page, "tp", "espectar", "Tp", "Off")

	tpBtn.face.Activated:Connect(function()
		local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local targetChar = selectedPlayer and selectedPlayer.Character
		local targetHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
		if myHrp and targetHrp then
			myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 3)
		else
			flashText(tpBtn.face, "sem jogador", "bad")
		end
	end)

	-- espectar: a câmera vai até o jogador selecionado sem você sair do jogo; "parar de espectar" devolve a câmera
	local specConn, specTarget = nil, nil
	function stopSpectate()
		spectating = false
		specTarget = nil
		if specConn then specConn:Disconnect() specConn = nil end
		local cam = workspace.CurrentCamera
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if cam and hum then cam.CameraSubject = hum end
		specBtn.setOn(false)
		specBtn.face.Text = "espectar"
	end
	function startSpectate()
		local target = selectedPlayer
		if not target then
			flashText(specBtn.face, "sem jogador", "bad")
			return
		end
		if specConn then specConn:Disconnect() specConn = nil end
		spectating = true
		specTarget = target
		specBtn.setOn(true)
		specBtn.face.Text = "parar de espectar"
		specConn = RunService.RenderStepped:Connect(function()
			local cam = workspace.CurrentCamera
			local hum = specTarget and specTarget.Character and specTarget.Character:FindFirstChildOfClass("Humanoid")
			if not specTarget or not specTarget.Parent then
				stopSpectate() -- o jogador saiu
				return
			end
			if cam and hum and cam.CameraSubject ~= hum then cam.CameraSubject = hum end
		end)
	end
	specBtn.face.Activated:Connect(function()
		if spectating then stopSpectate() else startSpectate() end
	end)
	conns.spectate = { Disconnect = function() if spectating then stopSpectate() end end }

	-- ===== AJUDAR (deitado, só na vertical, segue o jogador selecionado) =====
	-- Ligado: fico em estado de "fly" (corpo duro e reto), SEMPRE deitado de barriga para cima, embaixo
	-- dos pés do jogador selecionado. Eu só me movo na vertical, com os botões subir/descer (e as teclas E/Q).
	-- Na horizontal eu sigo o jogador selecionado, para ele não cair. O botão "frear" pausa esse acompanhamento.
	-- Desligado (ou se eu morrer, ou se o jogador sair): levanto em pé onde estou.
	local LIE_OFFSET = 3.5       -- do centro dele até o meu centro deitado (aumente se ele afundar, diminua se ficar alto)
	local FOLLOW_GAIN = 25       -- quão rápido acompanho o jogador na horizontal (maior = mais colado)
	local FOLLOW_MAX = 60        -- velocidade máxima desse acompanhamento (studs por segundo)
	local FOLLOW_SNAP = 40       -- se ele ficar mais longe que isso (ex.: se teleportou), vou direto para baixo dele
	local FREAR_DELAY = 1        -- segundos segurando "frear" antes de ir para baixo do jogador
	local FREAR_OFFSET = 2       -- quantos studs abaixo do jogador eu vou quando o "frear" teleporta
	local helpState = nil        -- { bv, bg, hum, conn, yaw } enquanto o ajudar está ligado
	local helpApfPending = false -- o Anti Part Fling estava ligado e volta quando eu terminar

	local function targetRoot()
		local ch = selectedPlayer and selectedPlayer.Character
		return ch and ch:FindFirstChild("HumanoidRootPart")
	end

	local function myRoot()
		return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	end

	local helpBtn = fullBtn(page, "ajudar", "Help")

	local function stopHelp()
		if not helpOn then return end
		helpOn = false
		helpFrearHeld = false
		local s = helpState
		helpState = nil
		if s then
			if s.conn then s.conn:Disconnect() end
			if s.bv then s.bv:Destroy() end
			if s.bg then s.bg:Destroy() end
		end
		noclip(false)

		-- levanta: de pé de novo, onde estou
		local r = myRoot()
		if r and s then
			r.CFrame = CFrame.new(r.Position + Vector3.new(0, 2.5, 0)) * CFrame.Angles(0, s.yaw, 0)
			r.AssemblyLinearVelocity = Vector3.zero
			r.AssemblyAngularVelocity = Vector3.zero
		end
		if s and s.hum and s.hum.Parent then
			s.hum.PlatformStand = false
			s.hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end

		if helpApfPending then
			helpApfPending = false
			toggles["Anti Part Fling"](true)
		end
		helpBtn.setOn(false)
		helpBtn.face.Text = "ajudar"
	end

	local function startHelp()
		if helpOn then return end
		if not targetRoot() then
			flashText(helpBtn.face, "Selecione um jogador", "bad")
			return
		end

		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local mine = myRoot()
		if not hum or not mine then return end

		helpOn = true
		helpBtn.setOn(true)

		-- o ajudar tem o próprio voo: desliga fly, vfly e float (que usariam os mesmos botões)
		toggles.Fly(false)
		toggles.VFly(false)
		toggles.Float(false)
		-- o Anti Part Fling tem teto de altura e trava de posição: pausa agora e religa no fim
		if apfActive then
			helpApfPending = true
			toggles["Anti Part Fling"](false)
		end

		-- deitado de barriga para cima, mantendo para onde eu estava olhando
		local look = mine.CFrame.LookVector
		local yaw = math.atan2(-look.X, -look.Z)
		local lieRot = CFrame.Angles(0, yaw, 0) * CFrame.Angles(math.rad(90), 0, 0)

		-- estado de fly: corpo duro e reto
		hum.PlatformStand = true
		noclip(true)

		local bv = Instance.new("BodyVelocity")
		bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		bv.Velocity = Vector3.zero
		bv.Parent = mine

		local bg = Instance.new("BodyGyro")
		bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
		bg.P = 9e4
		bg.CFrame = lieRot -- sempre deitado
		bg.Parent = mine

		-- vai para baixo dos pés do jogador selecionado
		local tp = targetRoot().Position
		mine.CFrame = CFrame.new(tp.X, tp.Y - LIE_OFFSET, tp.Z) * lieRot
		mine.AssemblyLinearVelocity = Vector3.zero
		mine.AssemblyAngularVelocity = Vector3.zero

		helpState = { bv = bv, bg = bg, hum = hum, yaw = yaw }
		helpState.conn = RunService.Heartbeat:Connect(function()
			local r = myRoot()
			if not r or player.Character ~= char or hum.Health <= 0 then
				stopHelp() -- morri ou troquei de personagem
				return
			end
			if not selectedPlayer then
				stopHelp() -- o jogador saiu do servidor
				return
			end
			hum.PlatformStand = true

			-- vertical: os botões subir/descer (do Float) e as teclas E/Q
			local vy = 0
			if floatUp or UIS:IsKeyDown(Enum.KeyCode.E) then vy += FLOAT_SPEED end
			if floatDown or UIS:IsKeyDown(Enum.KeyCode.Q) then vy -= FLOAT_SPEED end

			-- horizontal: acompanho o jogador selecionado (fico sempre embaixo dos pés dele)
			local vx, vz = 0, 0
			local t = targetRoot()
			if helpFrearHeld then
				-- segurando "frear": paro de seguir; depois de 1 segundo vou (uma vez) para baixo do jogador
				if t and not helpFrearDone and os.clock() - helpFrearStart >= FREAR_DELAY then
					helpFrearDone = true
					local tpos = t.Position
					r.CFrame = CFrame.new(tpos.X, tpos.Y - FREAR_OFFSET, tpos.Z) * lieRot
					r.AssemblyLinearVelocity = Vector3.zero
				end
			elseif t then
				local pos, tpos = r.Position, t.Position
				local ex, ez = tpos.X - pos.X, tpos.Z - pos.Z
				if ex * ex + ez * ez > FOLLOW_SNAP * FOLLOW_SNAP then
					r.CFrame = CFrame.new(tpos.X, pos.Y, tpos.Z) * lieRot
				else
					vx, vz = ex * FOLLOW_GAIN, ez * FOLLOW_GAIN
					local mag = math.sqrt(vx * vx + vz * vz)
					if mag > FOLLOW_MAX then
						vx, vz = vx / mag * FOLLOW_MAX, vz / mag * FOLLOW_MAX
					end
				end
			end
			bv.Velocity = Vector3.new(vx, vy, vz)
		end)
	end

	helpBtn.face.Activated:Connect(function()
		if helpOn then stopHelp() else startHelp() end
	end)
	-- ao fechar o painel, o "fechar" também desliga o ajudar
	conns.help = { Disconnect = function() if helpOn then stopHelp() end end }

	-- ===== subir / descer e frear (botões para segurar) =====
	local downBtn, upBtn = rowBtns(page, "descer", "subir")
	bindHold(downBtn, function() floatDown = true end, function() floatDown = false end)
	bindHold(upBtn, function() floatUp = true end, function() floatUp = false end)

	local frearBtn = fullBtn(page, "frear", "Help")
	bindHold(frearBtn, function()
		if not helpOn then
			flashText(frearBtn.face, "ligue o ajudar", "bad")
			return
		end
		helpFrearHeld = true
		helpFrearStart = os.clock()
		helpFrearDone = false
	end, function()
		helpFrearHeld = false -- soltou: volta a seguir o jogador
	end)

	-- ===== PERFIL COMPLETO =====
	local perfilBtn = fullBtn(page, "ver perfil completo", "Net")
	perfilBtn.face.Activated:Connect(function()
		if not selectedPlayer then
			flashText(perfilBtn.face, "Selecione um jogador", "bad")
			return
		end
		openProfile(selectedPlayer.UserId, selectedPlayer)
	end)
end

