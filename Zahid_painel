	local function renderServers()
		for _, c in ipairs(cardsFrame:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end
		-- servidor atual sempre fixo no topo (as fotos só existem aqui: o Roblox esconde quem está nos outros)
		makeCard(0, #Players:GetPlayers(), Players.MaxPlayers, myPing(), "Servidor atual  " .. string.sub(game.JobId, 1, 8), nil)

		local minP, maxPing = MIN_OPTS[minIdx], PING_OPTS[pingIdx]
		local view = {}
		for _, sv in ipairs(svAll) do
			if sv.id ~= game.JobId and type(sv.playing) == "number" and sv.playing >= minP
				and (maxPing == 0 or (type(sv.ping) == "number" and sv.ping <= maxPing)) then
				table.insert(view, sv)
			end
		end
		table.sort(view, SORTS[sortIdx][2])
		local pagesN = math.max(1, math.ceil(#view / PER_PAGE))
		svPage = math.clamp(svPage, 1, pagesN)
		for i = (svPage - 1) * PER_PAGE + 1, math.min(#view, svPage * PER_PAGE) do
			local sv = view[i]
			makeCard(i, sv.playing, sv.maxPlayers or "?", type(sv.ping) == "number" and sv.ping or nil,
				"ID " .. string.sub(sv.id, 1, 8), sv.id)
		end
		svStatus.Text = #view .. " servidores  •  página " .. svPage .. "/" .. pagesN
	end

	local function fetchServers()
		if svBusy then return end
		svBusy = true
		svStatus.Text = "Buscando servidores..."
		task.spawn(function()
			local all, cursor, err = {}, nil, nil
			for _ = 1, 3 do -- até 300 servidores
				local url = "https://games.roblox.com/v1/games/" .. game.PlaceId
					.. "/servers/Public?sortOrder=Desc&excludeFullGames=true&limit=100"
				if cursor then url = url .. "&cursor=" .. cursor end
				local data = apiJson(url)
				if not data or type(data.data) ~= "table" then
					err = "sem resposta do Roblox (limite ou sem http)"
					break
				end
				for _, sv in ipairs(data.data) do all[#all + 1] = sv end
				if type(data.nextPageCursor) ~= "string" then break end
				cursor = data.nextPageCursor
				task.wait(0.4)
			end
			svBusy = false
			if not alive then return end
			if #all == 0 and err then
				svStatus.Text = "Falhou: " .. err
				return
			end
			svAll, svLoaded, svPage = all, true, 1
			renderServers()
		end)
	end

