	if bubble.AbsolutePosition.X + PANEL_W + 6 + LIST_W > screenW then
		list.Position = UDim2.fromOffset(-LIST_W - 6, selY)
	else
		list.Position = UDim2.fromOffset(PANEL_W + 6, selY)
	end
	list.Visible = not list.Visible
end)
