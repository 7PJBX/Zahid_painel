		l.TextSize = 13
		l.TextWrapped = true
		l.TextColor3 = T.textDim
		l.Text = text
		l.Parent = holder
	end

	-- uma linha por servidor: jogadores/ping, fotos e o botão entrar
	local function addServerRow(s)
		local isCurrent = (s.id == game.JobId)
		local row = Instance.new("Frame") -- (sem registrar no tema: a lista é refeita ao trocar de tema)
		row.BackgroundColor3 = T.card
		row.BorderSizePixel = 0
		row.Size = UDim2.new(1, 0, 0, 64)
		row.Parent = list
		Instance.new("UICorner", row).CornerRadius = UDim.new(0, 10)

		local info = Instance.new("TextLabel")
		info.BackgroundTransparency = 1
		info.Font = FONT
		info.TextSize = 12
		info.TextColor3 = T.text
		info.TextXAlignment = Enum.TextXAlignment.Left
		info.TextYAlignment = Enum.TextYAlignment.Top
		info.Position = UDim2.fromOffset(8, 6)
