-- ===== CHUTÃO (mini menu) =====
-- Interruptor "chutão" (aba Fun): abre um mini menu (arrastável, com botão de minimizar) para escolher a força.
-- "chutar" toca a animação do chute e, no momento do golpe, arremessa as partes soltas que estiverem até 4 studs à minha
-- frente (útil para resgatar quem ficou soterrado). Partes de jogadores não são arremessadas, para não machucar quem
-- está sendo resgatado.
local chutaoToggle
do
	local function build()
		local FMIN, FMAX = 10, 300         -- força (studs/s)
		local KICK_ANIM = "rbxassetid://133180711707319"
		local KICK_DELAY = 0.25            -- segundos entre começar a animação e o golpe acertar
		local REACH = 4                    -- studs à frente
		local force = 100
		local busy = false
		local connList = {}
		local kickAnim = Instance.new("Animation")
		kickAnim.AnimationId = KICK_ANIM

		local kickParams = OverlapParams.new()
		kickParams.FilterType = Enum.RaycastFilterType.Exclude
		kickParams.MaxParts = 300

		local CW = math.min(176, viewport.X - 16)
		local CH = 184
		local HEADER_H = 32
		local menu = mkWindowFrame(gui)
		menu.Name = "Chutao"
		menu.Size = UDim2.fromOffset(CW, CH)
		menu.Position = UDim2.fromOffset(10, math.max(10, math.min(130, viewport.Y - CH - 10)))
		menu.Visible = false
		local scale = Instance.new("UIScale")
		scale.Parent = menu

		local title = mkLabel(menu, "Chutão", 14, "text")
		title.Font = FONT_BOLD
		title.Position = UDim2.fromOffset(10, 8)
		title.Size = UDim2.new(1, -56, 0, 18)
		local minBtn = new3DButton(menu, "-", UDim2.new(1, -40, 0, 3), UDim2.fromOffset(32, 26), "Off")
		minBtn.face.TextSize = 16

		-- arrastar o mini menu pela barra do título
		local dragBar = Instance.new("Frame")
		dragBar.BackgroundTransparency = 1
		dragBar.Size = UDim2.new(1, -46, 0, HEADER_H)
		dragBar.Active = true
		dragBar.Parent = menu
		local drag, dragStart, dragPos = false, Vector2.zero, UDim2.new()
		dragBar.InputBegan:Connect(function(input)
			if isPress(input) then
				drag, dragStart, dragPos = true, input.Position, menu.Position
			end
		end)

		local body = Instance.new("Frame")
		body.BackgroundTransparency = 1
		body.Position = UDim2.fromOffset(0, HEADER_H)
		body.Size = UDim2.new(1, 0, 1, -HEADER_H)
		body.Parent = menu

		local minimized = false
		minBtn.face.Activated:Connect(function()
			minimized = not minimized
			body.Visible = not minimized
			minBtn.face.Text = minimized and "+" or "-"
			menu.Size = UDim2.fromOffset(CW, minimized and HEADER_H or CH)
		end)

		-- força: rótulo, barra e caixa de texto
		local label = mkLabel(body, "", 12, "textDim")
		label.Position = UDim2.fromOffset(10, 0)
		label.Size = UDim2.new(1, -20, 0, 16)

		local track = mkPanel(body, "field", 8)
		track.Position = UDim2.fromOffset(10, 20)
		track.Size = UDim2.new(1, -20, 0, 22)
		track.Active = true
		local bar = Instance.new("Frame")
		bar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		bar.BackgroundTransparency = 0.7
		bar.BorderSizePixel = 0
		bar.Size = UDim2.new(1, -6, 1, -6)
		bar.Position = UDim2.fromOffset(3, 3)
		bar.Parent = track
		Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)
		local knob = Instance.new("Frame")
		knob.AnchorPoint = Vector2.new(0.5, 0.5)
		knob.Size = UDim2.fromOffset(18, 18)
		knob.BackgroundColor3 = T.faceHelp
		knob.BorderSizePixel = 0
		knob.Active = true
		knob.Parent = track
		Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

		local box = Instance.new("TextBox")
		box.Position = UDim2.fromOffset(10, 50)
		box.Size = UDim2.new(1, -20, 0, 26)
		box.BorderSizePixel = 0
		box.Font = FONT
		box.TextSize = 13
		box.ClearTextOnFocus = true
		box.Parent = body
		Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)
		onTheme(function()
			box.BackgroundColor3 = T.field
			box.TextColor3 = T.text
		end)

		local function setForce(v)
			force = math.clamp(v, FMIN, FMAX)
			knob.Position = UDim2.new((force - FMIN) / (FMAX - FMIN), 0, 0.5, 0)
			label.Text = "Força: " .. math.floor(force + 0.5)
			if not box:IsFocused() then box.Text = tostring(math.floor(force + 0.5)) end
		end
		box.FocusLost:Connect(function()
			local s = string.gsub(box.Text, ",", ".")
			local n = tonumber(s)
			if n then setForce(n) else setForce(force) end
		end)

		local dragging = false
		local function moveTo(x)
			local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
			setForce(FMIN + a * (FMAX - FMIN))
		end
		local function dragForceStart(input)
			if isPress(input) then
				dragging = true
				moveTo(input.Position.X)
			end
		end
		track.InputBegan:Connect(dragForceStart)
		knob.InputBegan:Connect(dragForceStart)

		local kickBtn = new3DButton(body, "chutar", UDim2.fromOffset(10, 84), UDim2.new(1, -20, 0, 32), "Net")
		local status = mkLabel(body, "", 11, "textDim")
		status.Position = UDim2.fromOffset(10, 120)
		status.Size = UDim2.new(1, -20, 0, 28)

		-- animação do chute (se o Roblox não deixar tocar essa animação, o chute continua funcionando sem ela)
		local track0, trackHum = nil, nil
		local function playKickAnim(hum)
			pcall(function()
				if trackHum ~= hum or not track0 then
					local animator = hum:FindFirstChildOfClass("Animator") or hum
					track0 = animator:LoadAnimation(kickAnim)
					trackHum = hum
				end
				track0:Play()
			end)
		end

		local function kick()
			if busy then return end
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not (hum and hrp) then
				flashText(kickBtn.face, "sem personagem", "bad")
				return
			end
			busy = true
			pcall(function() if setsimulationradius then setsimulationradius(1000, 1000) end end)
			playKickAnim(hum)
			task.wait(KICK_DELAY)

			local count = 0
			if hrp.Parent then
				local ex = {}
				for _, p in ipairs(Players:GetPlayers()) do
					if p.Character then ex[#ex + 1] = p.Character end
				end
				kickParams.FilterDescendantsInstances = ex
				-- caixa até REACH studs à frente (do chão até um pouco acima da cintura)
				local cf = hrp.CFrame * CFrame.new(0, -0.5, -(0.5 + REACH / 2))
				local parts = workspace:GetPartBoundsInBox(cf, Vector3.new(5, 5, REACH), kickParams)
				local look = hrp.CFrame.LookVector
				local flat = Vector3.new(look.X, 0, look.Z)
				if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
				local dir = (flat.Unit + Vector3.new(0, 0.35, 0)).Unit
				local done = {}
				for _, part in ipairs(parts) do
					local root = part.AssemblyRootPart or part
					if not done[root] and not root.Anchored and not part.Anchored then
						done[root] = true
						root.AssemblyLinearVelocity = dir * force
						root.AssemblyAngularVelocity = Vector3.new(math.random(-6, 6), math.random(-6, 6), math.random(-6, 6))
						count += 1
					end
				end
			end
			status.Text = count == 1 and "1 parte arremessada" or (count .. " partes arremessadas")
			task.delay(0.6, function() busy = false end)
		end
		kickBtn.face.Activated:Connect(kick)

		table.insert(connList, UIS.InputChanged:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
			if drag then
				local d = input.Position - dragStart
				local screen = gui.AbsoluteSize
				local nx = math.clamp(dragPos.X.Offset + d.X, 0, math.max(0, screen.X - CW))
				local ny = math.clamp(dragPos.Y.Offset + d.Y, 0, math.max(0, screen.Y - (minimized and HEADER_H or CH)))
				menu.Position = UDim2.fromOffset(nx, ny)
			end
			if dragging then moveTo(input.Position.X) end
		end))
		table.insert(connList, UIS.InputEnded:Connect(function(input)
			if isPress(input) then
				drag = false
				dragging = false
			end
		end))

		setForce(force)
		chutaoToggle = function(enable)
			menu.Visible = enable
			if enable then
				scale.Scale = 0.85
				tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		end

		conns.chutaoCleanup = { Disconnect = function()
			for _, c in ipairs(connList) do c:Disconnect() end
			menu:Destroy()
		end }
	end
	build()
end

