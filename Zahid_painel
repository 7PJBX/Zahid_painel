			empty.BackgroundTransparency = 1
			empty.Size = UDim2.fromScale(1, 1)
			empty.Font = FONT
			empty.TextSize = 13
			empty.TextColor3 = T.textDim
			empty.Text = "Ninguém mais no servidor."
			empty.Parent = holder
			return
		end

		for _, e in ipairs(entries) do
			local p = e.p
			local item = new3DButton(pickList, p.DisplayName .. " (@" .. p.Name .. ")", UDim2.new(),
