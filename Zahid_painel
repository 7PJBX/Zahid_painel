	local function queryFriend(p)
		if friendCache[p.UserId] ~= nil or friendPending[p.UserId] then return end
		friendPending[p.UserId] = true
		task.spawn(function()
			local ok, res = pcall(function() return player:IsFriendsWith(p.UserId) end)
			friendPending[p.UserId] = nil
			friendCache[p.UserId] = (ok and res == true)
			if currentPage == "picker" and alive then refreshPicker() end
		end)
	end

	function refreshPicker()
		local pk = pages.picker
		for _, c in ipairs(pk:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end
		pk:SetAttribute("n", 0)
		local back = btnIn(pk, "← voltar", "Off")
		back.face.Activated:Connect(function() showPage("players") end)

		local entries = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then
				queryFriend(p)
				table.insert(entries, { p = p, friend = friendCache[p.UserId] == true,
					k1 = string.lower(p.DisplayName), k2 = string.lower(p.Name) })
			end
		end
		table.sort(entries, function(a, b)
			if a.friend ~= b.friend then return a.friend end
			if a.k1 ~= b.k1 then return a.k1 < b.k1 end
			return a.k2 < b.k2
		end)
		if #entries == 0 then labelIn(pk, "Ninguém além de você no servidor.", "muted") end
		for _, e in ipairs(entries) do
			local p = e.p
			local item = new3DButton(pk, p.DisplayName .. " (@" .. p.Name .. ")", UDim2.new(),
				UDim2.new(1, 0, 0, 32), e.friend and "Net" or "Off")
