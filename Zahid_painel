		local plus = new3DButton(body, "+", UDim2.fromOffset(x + w - 30, y), UDim2.fromOffset(30, 28), "Off")
		local function refreshText() txt.Text = getText() end
		minus.face.Activated:Connect(function() change(-1) refreshText() end)
		plus.face.Activated:Connect(function() change(1) refreshText() end)
		refreshText()
	end

	local halfW = math.floor((BR_W - 36) / 2)
	local function applyFilters()
		filtered = {}
		for _, s in ipairs(servers) do
			if s.playing >= minPlayers and (maxPing == 0 or (s.ping and s.ping <= maxPing)) then
				table.insert(filtered, s)
			end
		end
		table.sort(filtered, function(a, b)
			if a.playing ~= b.playing then return a.playing > b.playing end
			return (a.ping or math.huge) < (b.ping or math.huge)
		end)
		page = 1
	end
	stepper(12, 2, halfW, function() return minPlayers == 0 and "jogadores: todos" or ("mín. " .. minPlayers .. " jogadores") end,
		function(d)
