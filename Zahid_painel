	addGradient(telePanel)

	teleStatus = Instance.new("TextLabel")
	teleStatus.Size = UDim2.new(1, -16, 0, 34)
	teleStatus.Position = UDim2.fromOffset(8, 6)
	teleStatus.BackgroundTransparency = 1
	teleStatus.Font = T.font
	teleStatus.TextSize = 13
	teleStatus.TextWrapped = true
	teleStatus.TextColor3 = T.text
	teleStatus.Text = "Toque numa parte para selecionar."
	teleStatus.Parent = telePanel

	local rotBtn = new3DButton(telePanel, "Rotacionar", UDim2.fromOffset(8, 44), UDim2.new(1, -16, 0, ROW_H), T.faceOff, T.baseOff)
	rotBtn.face.Activated:Connect(teleRotate)

	teleSpinBtn = new3DButton(telePanel, "Girar", UDim2.fromOffset(8, 84), UDim2.new(1, -16, 0, ROW_H), T.faceOff, T.baseOff)
	teleSpinBtn.face.Activated:Connect(function()
		if not tele.part then
			teleSetStatus("Selecione uma parte primeiro.", RED)
			return
		end
		if tele.spinOn then
			teleStopSpin()
		else
			if tele.ctrlOn then teleStopControl() end
			tele.spinOn = true
			teleSpinBtn.setOn(true)
		end
	end)

	teleCtrlBtn = new3DButton(telePanel, "Controlar", UDim2.fromOffset(8, 124), UDim2.new(1, -16, 0, ROW_H), T.faceOff, T.baseOff)
	teleCtrlBtn.face.Activated:Connect(function()
		if tele.ctrlOn then
			teleStopControl()
		else
			teleStartControl()
		end
	end)

	teleSpeedLabel = Instance.new("TextLabel")
	teleSpeedLabel.Size = UDim2.new(1, -16, 0, 18)
	teleSpeedLabel.Position = UDim2.fromOffset(8, 164)
	teleSpeedLabel.BackgroundTransparency = 1
	teleSpeedLabel.Font = T.font
	teleSpeedLabel.TextSize = 13
	teleSpeedLabel.TextColor3 = T.text
	teleSpeedLabel.TextXAlignment = Enum.TextXAlignment.Left
	teleSpeedLabel.Parent = telePanel

	teleTrack = Instance.new("Frame")
	teleTrack.Size = UDim2.new(1, -16, 0, 24)
	teleTrack.Position = UDim2.fromOffset(8, 186)
	teleTrack.BackgroundTransparency = 1
	teleTrack.Active = true
	teleTrack.Parent = telePanel

	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, 0, 0, 6)
	bar.Position = UDim2.new(0, 0, 0.5, -3)
	bar.BackgroundColor3 = T.baseOff
	bar.BorderSizePixel = 0
	bar.Parent = teleTrack
	Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

	teleKnob = Instance.new("Frame")
	teleKnob.Size = UDim2.fromOffset(16, 16)
	teleKnob.BackgroundColor3 = T.faceHelp
	teleKnob.BorderSizePixel = 0
	teleKnob.Parent = teleTrack
	Instance.new("UICorner", teleKnob).CornerRadius = UDim.new(1, 0)

	local function speedDragStart(input)
		if isPress(input) then
			tele.dragging = true
			setSpeedFromX(input.Position.X)
		end
	end
	teleTrack.InputBegan:Connect(speedDragStart)
	teleKnob.InputBegan:Connect(speedDragStart)
	local a0 = (tele.speed - SPEED_MIN) / (SPEED_MAX - SPEED_MIN)
	teleKnob.Position = UDim2.new(a0, -8, 0.5, -8)
	teleSpeedLabel.Text = "Velocidade: " .. tele.speed

	UIS.InputChanged:Connect(function(input)
		if tele.dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setSpeedFromX(input.Position.X)
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if isPress(input) then tele.dragging = false end
	end)

	teleBtn = new3DButton(content, "telecinese", UDim2.fromOffset(8, rowY(ROW_TELE)), UDim2.new(1, -16, 0, ROW_H), T.faceOff, T.baseOff)
	teleBtn.face.TextTruncate = Enum.TextTruncate.AtEnd
	teleBtn.face.Activated:Connect(function()
		setTele(not teleOpen)
	end)

	-- seleção: toque/clique numa parte do mapa enquanto o menu está aberto
	UIS.InputBegan:Connect(function(input, gp)
		if gp or not teleOpen or not isPress(input) then return end
		local cam = workspace.CurrentCamera
		if not cam then return end
		local ray = cam:ViewportPointToRay(input.Position.X, input.Position.Y)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local ex = {}
		if player.Character then table.insert(ex, player.Character) end
		if floatPart then table.insert(ex, floatPart) end
		params.FilterDescendantsInstances = ex
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
		if not hit then return end
		local part = hit.Instance
		local m = part:FindFirstAncestorOfClass("Model")
		if m and m:FindFirstChildOfClass("Humanoid") then
			teleSetStatus("Não dá para mover personagens.", RED)
			return
		end
		teleSelect(part)
	end)

	-- girar e controlar (rodam a cada frame)
	RunService.Heartbeat:Connect(function(dt)
		local p = tele.part
		if not p then return end
		if not p.Parent then
			teleClear()
			teleSetStatus("A parte foi removida.", RED)
			return
		end
		if tele.ctrlOn and tele.bv and tele.bg then
			local cam = workspace.CurrentCamera
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			local rel = hum and cam.CFrame:VectorToObjectSpace(hum.MoveDirection) or Vector3.zero
			local dir = cam.CFrame.LookVector * (-rel.Z) + cam.CFrame.RightVector * rel.X
			if floatUp or UIS:IsKeyDown(Enum.KeyCode.E) or UIS:IsKeyDown(Enum.KeyCode.Space) then
				dir += Vector3.new(0, 1, 0)
			end
			if floatDown or UIS:IsKeyDown(Enum.KeyCode.Q) then
				dir -= Vector3.new(0, 1, 0)
			end
			tele.bv.Velocity = dir.Magnitude > 0.01 and dir.Unit * tele.speed or Vector3.zero
			tele.bg.CFrame = tele.rot
		elseif tele.spinOn then
			p.AssemblyAngularVelocity = Vector3.new(0, SPIN_RATE, 0)
		end
	end)
end

local panelOpen = false
