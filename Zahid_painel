-- ===== ANTIFLING =====
local antiFlingSaved = {} -- [part] = CanCollide original
local CORE_PARTS = { HumanoidRootPart = true, Head = true, Torso = true, UpperTorso = true, LowerTorso = true }

-- devolve a colisão dos outros jogadores
local function restoreCollisions()
	-- 1) valor original guardado
	for part, original in pairs(antiFlingSaved) do
		if part.Parent then
			part.CanCollide = original
		end
		antiFlingSaved[part] = nil
	end
	-- 2) garante as partes principais de todos os outros jogadores
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			for _, part in ipairs(p.Character:GetDescendants()) do
				if part:IsA("BasePart") and CORE_PARTS[part.Name] then
					part.CanCollide = true
				end
			end
		end
	end
end

local function antiFling(on)
	if conns.antifling then conns.antifling:Disconnect() conns.antifling = nil end
	if conns.antiflingRestore then conns.antiflingRestore:Disconnect() conns.antiflingRestore = nil end

	if not on then
		restoreCollisions()
		-- reaplica por 1 segundo, caso algo mexa nessas parts logo depois
		local t0 = os.clock()
		conns.antiflingRestore = RunService.Stepped:Connect(function()
			if os.clock() - t0 > 1 then
				if conns.antiflingRestore then
					conns.antiflingRestore:Disconnect()
					conns.antiflingRestore = nil
				end
				return
			end
			restoreCollisions()
		end)
		return
	end

	conns.antifling = RunService.Stepped:Connect(function()
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p.Character then
				for _, part in ipairs(p.Character:GetDescendants()) do
					if part:IsA("BasePart") then
						if antiFlingSaved[part] == nil then
							antiFlingSaved[part] = part.CanCollide -- guarda o valor original
						end
						part.CanCollide = false
					end
				end
			end
		end
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if hrp and (hrp.AssemblyLinearVelocity.Magnitude > 150
			or hrp.AssemblyAngularVelocity.Magnitude > 50) then
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end
	end)
end

-- ===== TPTOOL (clica no chão e teleporta) =====
local tpEnabled = false
local function giveTpTool()
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack or backpack:FindFirstChild("TPTool") then return end
	local tool = Instance.new("Tool")
	tool.Name = "TPTool"
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.Activated:Connect(function()
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local mouse = player:GetMouse()
		if hrp and mouse.Hit then
			hrp.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0))
		end
	end)
	tool.Parent = backpack
end

local function removeTpTool()
	local bp = player:FindFirstChildOfClass("Backpack")
	if bp and bp:FindFirstChild("TPTool") then bp.TPTool:Destroy() end
	if player.Character and player.Character:FindFirstChild("TPTool") then
		player.Character.TPTool:Destroy()
	end
end

local function tpTool(on)
	tpEnabled = on
	if on then giveTpTool() else removeTpTool() end
end

player.CharacterAdded:Connect(function()
	if tpEnabled then
		task.wait(0.5)
		giveTpTool()
	end
end)

-- ===== FLY / VFLY =====
local FLY_SPEED = 60

local function stopFlight(key)
	if conns[key] then conns[key]:Disconnect() conns[key] = nil end
	local s = flyState[key]
	if s then
		if s.bv then s.bv:Destroy() end
		if s.bg then s.bg:Destroy() end
		if s.hum and not s.needSeat then s.hum.PlatformStand = false end
		flyState[key] = nil
	end
end

local function startFlight(key, needSeat)
	stopFlight(key)
	flyState[key] = { needSeat = needSeat }
	conns[key] = RunService.Heartbeat:Connect(function()
		local s = flyState[key]
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not s or not hum then return end

		local part
		if needSeat then
			part = hum.SeatPart
		else
			part = char:FindFirstChild("HumanoidRootPart")
		end

		-- sem alvo (ex.: VFly fora do veículo): limpa e espera
		if not part then
			if s.bv then s.bv:Destroy() s.bv = nil end
			if s.bg then s.bg:Destroy() s.bg = nil end
			s.target = nil
			return
		end

		-- alvo novo: cria os controladores de voo
		if part ~= s.target then
			if s.bv then s.bv:Destroy() end
			if s.bg then s.bg:Destroy() end
			s.target, s.hum = part, hum
			s.bv = Instance.new("BodyVelocity")
			s.bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
			s.bv.Velocity = Vector3.zero
			s.bv.Parent = part
			s.bg = Instance.new("BodyGyro")
			s.bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
			s.bg.P = 9e4
			s.bg.Parent = part
			if not needSeat then hum.PlatformStand = true end
		end

		local cam = workspace.CurrentCamera
		local rel = cam.CFrame:VectorToObjectSpace(hum.MoveDirection)
		local dir = cam.CFrame.LookVector * (-rel.Z) + cam.CFrame.RightVector * rel.X
		if UIS:IsKeyDown(Enum.KeyCode.Space) or UIS:IsKeyDown(Enum.KeyCode.E) then
			dir += Vector3.new(0, 1, 0)
		end
		if UIS:IsKeyDown(Enum.KeyCode.Q) then
			dir -= Vector3.new(0, 1, 0)
		end

		s.bv.Velocity = dir * FLY_SPEED
		s.bg.CFrame = cam.CFrame
	end)
end

local function fly(on)
	if on then startFlight("fly", false) else stopFlight("fly") end
end

local function vfly(on)
	if on then startFlight("vfly", true) else stopFlight("vfly") end
end

-- ===== FLOAT (plataforma invisível sob os pés; Q desce / E sobe) =====
local FLOAT_SPEED = 4 -- velocidade de subir/descer (studs por segundo; o TP ajuda usa a mesma)
local floatPart, floatY
local floatUp, floatDown = false, false

local function floatToggle(on)
	if conns.float then conns.float:Disconnect() conns.float = nil end
	if floatPart then floatPart:Destroy() floatPart = nil end
	floatUp, floatDown = false, false
	if not on then return end

	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	floatPart = Instance.new("Part")
	floatPart.Name = "FloatPlatform"
	floatPart.Size = Vector3.new(6, 1, 6)
	floatPart.Anchored = true
	floatPart.CanCollide = true
	floatPart.CanQuery = false
	floatPart.Transparency = 1
	floatPart.Parent = workspace

	floatY = hrp.Position.Y - 3.5 -- topo da plataforma na altura dos pés

	conns.float = RunService.Heartbeat:Connect(function(dt)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root or not floatPart then return end

		local dy = 0
		if floatUp or UIS:IsKeyDown(Enum.KeyCode.E) then dy += 1 end
		if floatDown or UIS:IsKeyDown(Enum.KeyCode.Q) then dy -= 1 end
		floatY += dy * FLOAT_SPEED * dt

		floatPart.CFrame = CFrame.new(root.Position.X, floatY, root.Position.Z)
	end)
end

-- ===== NOCLIP (atravessa paredes e chão; usado pelo TP Ajuda) =====
local noclipSaved = {} -- [part] = CanCollide original

local function noclip(on)
	if conns.noclip then conns.noclip:Disconnect() conns.noclip = nil end

	if on then
		conns.noclip = RunService.Stepped:Connect(function()
			local char = player.Character
			if not char then return end
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					if noclipSaved[part] == nil then
						noclipSaved[part] = part.CanCollide -- guarda o valor original
					end
					part.CanCollide = false
				end
			end
		end)
		return
	end

	-- desligou: as colisões voltam
	for part, original in pairs(noclipSaved) do
		if part.Parent then
			part.CanCollide = original
		end
		noclipSaved[part] = nil
	end
	local char = player.Character
	if char then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and CORE_PARTS[part.Name] then
				part.CanCollide = true
			end
		end
	end
end

-- ===== RE (regenera o personagem e volta para o último lugar) =====
local reBusy = false
local function respawnHere(onDone)
	if reBusy then
		if onDone then onDone() end
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then
		if onDone then onDone() end
		return
	end

	reBusy = true
	local savedCF = hrp.CFrame
	local conn
	local function finish()
		if conn then conn:Disconnect() conn = nil end
		reBusy = false
		if onDone then onDone() end
	end

	conn = player.CharacterAdded:Connect(function(newChar)
		local newHrp = newChar:WaitForChild("HumanoidRootPart", 10)
		if newHrp then
			-- coloca duas vezes, para vencer o ponto de spawn do jogo
			task.wait()
			newHrp.CFrame = savedCF
			task.wait(0.15)
			newHrp.CFrame = savedCF
		end
		finish()
	end)

	hum.Health = 0 -- regenera o personagem

	-- segurança: se o personagem não voltar em 15s, libera o botão
	task.delay(15, function()
		if reBusy then finish() end
	end)
end

-- ===== FPS BOOST (sem mexer na distância de renderização) =====
-- Desliga sombras, efeitos pesados, partículas, reflexos e detalhes de malha,
-- simplifica materiais e destrava o limite de FPS (se o executor tiver setfpscap).
-- Não mexe no QualityLevel nem no alcance de renderização.
-- Tudo volta ao normal quando o botão é desligado.
local fpsSaved = {} -- [instância] = { [propriedade] = valor original }
local fpsToken = 0

local PART_FAST = { CastShadow = false, Reflectance = 0, Material = Enum.Material.SmoothPlastic }
local MESH_FAST = { RenderFidelity = Enum.RenderFidelity.Performance }
local EMIT_OFF = { Enabled = false }
local TERRAIN_FAST = { Decoration = false, WaterWaveSize = 0, WaterWaveSpeed = 0, WaterReflectance = 0 }
local LIGHT_FAST = { GlobalShadows = false }

local function getProp(inst, prop) return inst[prop] end
local function setProp(inst, prop, value) inst[prop] = value end

local function fpsApply(inst, props)
	local saved = fpsSaved[inst]
	if not saved then
		saved = {}
		fpsSaved[inst] = saved
	end
	for prop, value in pairs(props) do
		local ok, cur = pcall(getProp, inst, prop)
		if ok and cur ~= value then
			if saved[prop] == nil then saved[prop] = cur end -- guarda o original
			pcall(setProp, inst, prop, value)
		end
	end
end

local function fpsHandle(inst)
	if inst:IsA("Terrain") then
		fpsApply(inst, TERRAIN_FAST)
	elseif inst:IsA("BasePart") then
		-- não mexe nos personagens (jogadores e NPCs), para ninguém ficar com aparência estranha
		local model = inst:FindFirstAncestorOfClass("Model")
		if model and model:FindFirstChildOfClass("Humanoid") then return end
		fpsApply(inst, PART_FAST)
		if inst:IsA("MeshPart") then fpsApply(inst, MESH_FAST) end
	elseif inst:IsA("PostEffect") or inst:IsA("ParticleEmitter") or inst:IsA("Trail")
		or inst:IsA("Beam") or inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles") then
		fpsApply(inst, EMIT_OFF)
	end
end

local function fpsBoost(on)
	fpsToken += 1
	local token = fpsToken
	if conns.fpsWs then conns.fpsWs:Disconnect() conns.fpsWs = nil end
	if conns.fpsLt then conns.fpsLt:Disconnect() conns.fpsLt = nil end

	-- limite de FPS (só funciona em executores que têm setfpscap)
	pcall(function()
		if setfpscap then setfpscap(on and 999 or 60) end
	end)

	if not on then
		-- desligou: devolve tudo ao valor original, aos poucos para não travar
		local old = fpsSaved
		fpsSaved = {}
		task.spawn(function()
			local n = 0
			for inst, props in pairs(old) do
				if inst.Parent then
					for prop, value in pairs(props) do
						pcall(setProp, inst, prop, value)
					end
				end
				n += 1
				if n % 300 == 0 then task.wait() end
			end
		end)
		return
	end

	fpsApply(Lighting, LIGHT_FAST)

	-- o que aparecer depois (mapas com streaming, efeitos novos) também é otimizado
	conns.fpsWs = workspace.DescendantAdded:Connect(fpsHandle)
	conns.fpsLt = Lighting.DescendantAdded:Connect(fpsHandle)

	-- o que já existe é otimizado em lotes, sem congelar o jogo
	task.spawn(function()
		local n = 0
		for _, root in ipairs({ workspace, Lighting }) do
			for _, inst in ipairs(root:GetDescendants()) do
				if fpsToken ~= token then return end
				fpsHandle(inst)
				n += 1
				if n % 300 == 0 then task.wait() end
			end
		end
	end)
end

-- ===== REJOIN / SERVER HOP =====
local netBusy = false

-- volta para o mesmo servidor
local function rejoinServer()
	if #Players:GetPlayers() <= 1 then
		-- sozinho: o servidor fecha quando você sai, então entra em um novo
		player:Kick("\nReentrando no jogo...")
		task.wait()
		TeleportService:Teleport(game.PlaceId, player)
		return true
	end
	return (pcall(function()
		TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
	end))
end

-- faz a requisição HTTP (usa o que o executor oferecer)
local function httpGetBody(url)
	local reqFn = request or http_request or (syn and syn.request)
	if reqFn then
		local ok, res = pcall(reqFn, { Url = url, Method = "GET" })
		if ok and res and res.Body then return res.Body end
	end
	local ok, body = pcall(function() return game:HttpGet(url) end)
	if ok then return body end
	return nil
end

-- procura um servidor público diferente do atual e com vaga
local function findOtherServer()
	local candidates = {}
	local cursor = nil
	for _ = 1, 3 do -- até 3 páginas de 100 servidores
		local url = "https://games.roblox.com/v1/games/" .. game.PlaceId
			.. "/servers/Public?sortOrder=Asc&excludeFullGames=true&limit=100"
		if cursor then url = url .. "&cursor=" .. cursor end

		local body = httpGetBody(url)
		if not body then break end
		local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
		if not ok or type(data) ~= "table" or type(data.data) ~= "table" then break end

		for _, s in ipairs(data.data) do
			if s.id ~= game.JobId and s.playing and s.maxPlayers and s.playing < s.maxPlayers - 1 then
				table.insert(candidates, s.id)
			end
		end

		if type(data.nextPageCursor) ~= "string" then break end
		cursor = data.nextPageCursor
	end
	if #candidates == 0 then return nil end
	return candidates[math.random(#candidates)]
end

-- entra em outro servidor; devolve true se o teleporte foi iniciado, ou false e o motivo
local function serverHop()
	local id = findOtherServer()
	if not id then return false, "Sem servidor" end
	local ok = pcall(function()
		TeleportService:TeleportToPlaceInstance(game.PlaceId, id, player)
	end)
	if not ok then return false, "Falhou" end
	return true
end

-- ===== AUTO FARM: POSIÇÃO FIXA + USO CONTÍNUO + RECONEXÃO =====
-- "Definir posição" guarda onde você está. "Auto farm" (ligado):
--  * se o jogo te teleportar ou você morrer, volta para a posição definida;
--  * usa a ferramenta da mão a cada 5 segundos (se não houver, equipa a do slot 2);
--  * se a conexão cair (erro 277 etc.), tenta reconectar sozinho; ao voltar,
--    o estado é restaurado (posição, auto farm ligado e ferramenta do slot 2).
-- Para restaurar depois de reconectar, o script precisa rodar de novo no novo servidor:
--  * o link do script está em SCRIPT_URL (ele precisa conter esta versão do script), OU salve este
--    script com o nome de SCRIPT_FILE na pasta workspace do executor (deixando SCRIPT_URL vazio),
--    OU deixe-o na pasta autoexec (e use USE_QUEUE = false).
local GuiService = game:GetService("GuiService")

local FARM_FILE = "ZahidPainel_farm.json" -- onde a posição e o estado ficam salvos
local SCRIPT_FILE = "Zahid_painel.lua"    -- nome deste script na pasta workspace do executor
local SCRIPT_URL = "https://raw.githubusercontent.com/7PJBX/Zahid_painel/refs/heads/main/Zahid_painel" -- link (raw) do script
local USE_QUEUE = true                    -- false se o script já roda sozinho pela pasta autoexec
local TELEPORT_JUMP = 15                  -- deslocamento em 1 frame (studs) que conta como teleporte
local USE_INTERVAL = 5                    -- segundos entre cada uso da ferramenta
local FARM_ANTIFLING_ON_RELOG = true   -- depois de relogar (queda de internet), já deixa o AntiFling ligado

local farmOn = false
local farmCFrame = nil       -- posição definida
local farmToolName = nil     -- ferramenta que está sendo usada
local farmLastPos = nil
local farmLastReturn = 0
local farmLastUse = 0
local farmLastEquip = 0
local farmGoToken = 0
local farmQueued = false
local farmReconnecting = false

local function farmRoot()
	return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end

-- salva posição e estado em arquivo (se o executor tiver writefile)
local function farmSave()
	if not writefile then return end
	local data = { placeId = game.PlaceId, active = farmOn }
	if farmCFrame then data.cf = { farmCFrame:GetComponents() } end
	pcall(function()
		writefile(FARM_FILE, HttpService:JSONEncode(data))
	end)
end

local function farmLoad()
	if not (readfile and isfile) then return nil end
	local ok, data = pcall(function()
		if not isfile(FARM_FILE) then return nil end
		return HttpService:JSONDecode(readfile(FARM_FILE))
	end)
	if ok and type(data) == "table" and data.placeId == game.PlaceId then return data end
	return nil
end

-- pede ao executor para rodar este script de novo depois do teleporte de reconexão
local function farmQueueSelf()
	if farmQueued or not USE_QUEUE then return end
	local q = queue_on_teleport or (syn and syn.queue_on_teleport)
	if not q then return end
	local code
	if SCRIPT_URL ~= "" then
		code = 'loadstring(game:HttpGet("' .. SCRIPT_URL .. '"))()'
	else
		code = 'loadstring(readfile("' .. SCRIPT_FILE .. '"))()'
	end
	if pcall(q, code) then farmQueued = true end
end

-- vai para a posição definida (repete por uns segundos, pois o jogo também posiciona o personagem)
local function farmGoTo()
	farmGoToken += 1
	local token = farmGoToken
	task.spawn(function()
		local char = player.Character or player.CharacterAdded:Wait()
		local hrp = char:WaitForChild("HumanoidRootPart", 10)
		if not hrp then return end
		for _ = 1, 20 do
			if not farmOn or farmGoToken ~= token or not hrp.Parent then return end
			hrp.CFrame = farmCFrame
			hrp.AssemblyLinearVelocity = Vector3.zero
			farmLastPos = nil
			task.wait(0.15)
		end
	end)
end

-- equipa a ferramenta usada antes; se não achar, a do slot 2 (ordem da mochila)
local function farmEquip()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not hum or not backpack or hum.Health <= 0 then return end

	local tool = farmToolName and backpack:FindFirstChild(farmToolName)
	if not (tool and tool:IsA("Tool")) then
		local list = {}
		for _, c in ipairs(backpack:GetChildren()) do
			if c:IsA("Tool") then table.insert(list, c) end
		end
		tool = list[2] or list[1]
	end
	if tool then
		farmToolName = tool.Name
		hum:EquipTool(tool)
	end
end

-- tenta voltar ao jogo quando a conexão cai
local function farmReconnect()
	if farmReconnecting or not farmOn then return end
	farmReconnecting = true
	farmSave()
	farmQueueSelf()
	task.spawn(function()
		local attempt = 0
		while farmOn do
			attempt += 1
			pcall(function()
				if attempt <= 3 then
					-- primeiro tenta o mesmo servidor
					TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
				else
					-- se ele já fechou, entra em outro
					TeleportService:Teleport(game.PlaceId, player)
				end
			end)
			task.wait(8) -- sem internet o teleporte falha; tenta de novo
		end
		farmReconnecting = false
	end)
end

local function farmEnable(on)
	for _, k in ipairs({ "farmHB", "farmChar", "farmErr1", "farmErr2", "farmIdle" }) do
		if conns[k] then conns[k]:Disconnect() conns[k] = nil end
	end
	farmOn = on
	farmSave()
	if not on then return end
	if not farmCFrame then farmOn = false return end

	farmQueueSelf()
	farmGoTo()
	farmLastPos = nil

	-- loop principal: volta se for teleportado + usa a ferramenta sem parar
	conns.farmHB = RunService.Heartbeat:Connect(function()
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then farmLastPos = nil return end
		local now = os.clock()

		-- 1) o jogo me teleportou? volta para a posição definida
		if farmLastPos and (hrp.Position - farmLastPos).Magnitude > TELEPORT_JUMP then
			if now - farmLastReturn > 0.3 then
				hrp.CFrame = farmCFrame
				hrp.AssemblyLinearVelocity = Vector3.zero
				farmLastReturn = now
				farmLastPos = farmCFrame.Position
			end
		else
			farmLastPos = hrp.Position
		end

		-- 2) usa a ferramenta da mão a cada USE_INTERVAL segundos; sem ferramenta, equipa a do slot 2
		local tool = char:FindFirstChildOfClass("Tool")
		if tool then
			farmToolName = tool.Name
			if now - farmLastUse >= USE_INTERVAL then
				farmLastUse = now
				tool:Activate()
			end
		elseif now - farmLastEquip >= 0.5 then
			farmLastEquip = now
			farmEquip()
		end
	end)

	-- morreu: ao renascer volta para a posição definida
	conns.farmChar = player.CharacterAdded:Connect(function()
		farmLastPos = nil
		farmGoTo()
	end)

	-- queda de conexão (erro 277 etc.): reconecta sozinho
	conns.farmErr1 = GuiService.ErrorMessageChanged:Connect(function()
		local msg = string.lower(GuiService:GetErrorMessage() or "")
