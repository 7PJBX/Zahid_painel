	local function fmtDur(sec)
		sec = math.max(0, math.floor(sec))
		local h, m, s = math.floor(sec / 3600), math.floor((sec % 3600) / 60), sec % 60
		if h > 0 then return string.format("%dh %02dm %02ds", h, m, s) end
		return string.format("%dm %02ds", m, s)
	end

	local function fmtDate(isoText)
		local ok, dt = pcall(function() return DateTime.fromIsoDate(isoText) end)
		if ok and dt then
			local ok2, s = pcall(function() return dt:FormatLocalTime("DD/MM/YYYY", "pt-br") end)
			if ok2 then return s, math.floor((os.time() - dt.UnixTimestamp) / 86400) end
		end
		return isoText, nil
	end

	local function commas(n)
		local s = tostring(math.floor(n))
		local out = s:reverse():gsub("(%d%d%d)", "%1."):reverse()
		if out:sub(1, 1) == "." then out = out:sub(2) end
		return out
	end

