		end
	end)
end

-- botão que reage ao ficar SEGURADO: onDown ao apertar, onUp ao soltar (em qualquer lugar)
local function bindHold(btn, onDown, onUp)
	local down = false
	btn.face.InputBegan:Connect(function(input)
		if isPress(input) and not down then
			down = true
			onDown()
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if isPress(input) and down then
			down = false
			onUp()
		end
	end)
end

