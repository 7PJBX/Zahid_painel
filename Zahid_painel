	-- ===== ARRASTAR O BOTÃO (preso à tela, com mola) =====
	local dragging, moved, startPos, startInput = false, false, nil, nil
	local bubbleTween = nil

	local function bounds()
		local s = gui.AbsoluteSize
		local w, h = bubble.AbsoluteSize.X, bubble.AbsoluteSize.Y
		return 0, math.max(0, s.X - w), 0, math.max(0, s.Y - h)
	end
	local function rubber(v, lo, hi)
		-- fora da borda a resistência aumenta: o botão "estica", mas não sai
		if v < lo then return lo - math.min((lo - v) * 0.35, 60) end
		if v > hi then return hi + math.min((v - hi) * 0.35, 60) end
		return v
	end

	bubble.InputBegan:Connect(function(input)
		if isPress(input) then
			if bubbleTween then bubbleTween:Cancel() bubbleTween = nil end
			dragging, moved = true, false
			startPos, startInput = bubble.Position, input.Position
		end
	end)
	table.insert(uiConns, UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - startInput
			if d.Magnitude > 6 then moved = true end
			local minX, maxX, minY, maxY = bounds()
			bubble.Position = UDim2.fromOffset(
				rubber(startPos.X.Offset + d.X, minX, maxX),
				rubber(startPos.Y.Offset + d.Y, minY, maxY))
		end
	end))
	table.insert(uiConns, UIS.InputEnded:Connect(function(input)
		if dragging and isPress(input) then
			dragging = false
			if not moved then
				setPanel(not panelOpen)
				return
			end
			-- soltou fora da borda: volta em mola
			local minX, maxX, minY, maxY = bounds()
			local cx = math.clamp(bubble.Position.X.Offset, minX, maxX)
			local cy = math.clamp(bubble.Position.Y.Offset, minY, maxY)
			if cx ~= bubble.Position.X.Offset or cy ~= bubble.Position.Y.Offset then
				bubbleTween = tween(bubble, 0.7, { Position = UDim2.fromOffset(cx, cy) },
					Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
			end
		end
	end))

