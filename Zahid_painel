-- ===== LOCK IN AJUDA (botão on/off) =====
-- Ligado: vou para debaixo do jogador selecionado, com noclip e uma plataforma sob os pés (igual ao Float).
-- A plataforma sobe LOCK_RISE_STUDS gradualmente. Quando termina, o noclip desliga e eu controlo a
-- plataforma como o Float (Q desce / E sobe). Enquanto ligado, sou teleportado para baixo dele a cada
-- frame, acompanhando os movimentos, para ele não cair de mim.
do
	local LOCK_RISE_STUDS = 7      -- quanto a plataforma sobe no começo
	local LOCK_HEAD_OFFSET = 3     -- do centro do meu corpo até o topo da cabeça
	local FOLLOW_LEAD = 0.03       -- segundos fixos de antecipação ao seguir o jogador
	local FOLLOW_PING_FACTOR = 0.5 -- quanto do ping entra na antecipação
	local MAX_LEAD_STUDS = 3       -- distância máxima à frente dele

	local lockOn = false
	local lockConn = nil
	local lockChar, lockVictim
	local lockGroundY = 0          -- altura dos pés dele (o chão onde ele está)
	local lockRising = false
	local lockRisen = 0
	local lockYaw = 0
	local lockSaved = {}           -- [parte] = CanCollide original
	local lockFloatWasOn = false
	local lockApfPending = false

	local function myRoot()
		return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	end

	-- altura dos pés até o centro do HumanoidRootPart
	local function feetOffset(hum, root)
		return (hum.RigType == Enum.HumanoidRigType.R15) and (hum.HipHeight + root.Size.Y / 2) or 3
	end

	local function setBodyCollide(char, on)
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				if lockSaved[part] == nil then lockSaved[part] = part.CanCollide end
				part.CanCollide = on
			end
		end
	end

	local function restoreCollide()
		for part, cc in pairs(lockSaved) do
			if part.Parent then part.CanCollide = cc end
			lockSaved[part] = nil
		end
	end

	local function lockStop()
		if not lockOn then return end
		lockOn = false
		if lockConn then lockConn:Disconnect() lockConn = nil end

		-- se eu estiver abaixo do chão, subo para cima do chão antes de qualquer coisa
		local r = myRoot()
		if r and r.Position.Y < lockGroundY + 1 then
			r.CFrame = CFrame.new(r.Position.X, lockGroundY + 3, r.Position.Z) * CFrame.Angles(0, lockYaw, 0)
			r.AssemblyLinearVelocity = Vector3.zero
			if floatPart then floatY = lockGroundY - 0.5 end
		end
		restoreCollide()
		if not lockFloatWasOn then toggles.Float(false) end
		if lockApfPending then
			lockApfPending = false
			toggles["Anti Part Fling"](true)
		end
		helpBtn.setOn(false)
		helpBtn.face.Text = "lock in ajuda"
	end

	local function lockStart()
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local mine = myRoot()
		local victim = selectedPlayer
		local vch = victim and victim.Character
		local vhrp = vch and vch:FindFirstChild("HumanoidRootPart")
		local vhum = vch and vch:FindFirstChildOfClass("Humanoid")
		if not (hum and mine and vhrp and vhum) then
			helpBtn.face.Text = "Selecione um jogador"
			task.delay(1.5, function()
				if not lockOn then helpBtn.face.Text = "lock in ajuda" end
			end)
			return
		end

		lockOn = true
		lockChar, lockVictim = char, victim
		lockYaw = math.atan2(-mine.CFrame.LookVector.X, -mine.CFrame.LookVector.Z)
		lockGroundY = vhrp.Position.Y - feetOffset(vhum, vhrp)
		hum.PlatformStand = false -- em pé, nunca deitado (sem trip)
		helpBtn.setOn(true)
		helpBtn.face.Text = "Subindo..."

		-- o Anti Part Fling tira a colisão do corpo e me derrubaria: pausa e religa no fim
		if apfActive then
			lockApfPending = true
			toggles["Anti Part Fling"](false)
		end

		-- plataforma do Float: começa 7 studs abaixo de onde termina (cabeça no nível dos pés dele)
		lockFloatWasOn = floatPart ~= nil
		toggles.Float(true)
		local endFloatY = lockGroundY - LOCK_HEAD_OFFSET - 3.5
		floatY = endFloatY - LOCK_RISE_STUDS
		lockRising, lockRisen = true, 0

		-- teleporta para debaixo dele, sem colisão
		setBodyCollide(char, false)
		mine.AssemblyLinearVelocity = Vector3.zero
		mine.AssemblyAngularVelocity = Vector3.zero
		mine.CFrame = CFrame.new(vhrp.Position.X, floatY + 3.5, vhrp.Position.Z) * CFrame.Angles(0, lockYaw, 0)

		lockConn = RunService.Heartbeat:Connect(function(dt)
			local ch = player.Character
			local r = ch and ch:FindFirstChild("HumanoidRootPart")
			local h = ch and ch:FindFirstChildOfClass("Humanoid")
			local vc = victim.Character
			local vr = vc and vc:FindFirstChild("HumanoidRootPart")
			if ch ~= lockChar or not r or not h or h.Health <= 0 or not vr then
				lockStop()
				return
			end

			-- sobe a plataforma gradualmente (7 studs)
			if lockRising then
				local step = FLOAT_SPEED * dt
				floatY += step
				lockRisen += step
				if lockRisen >= LOCK_RISE_STUDS then
					lockRising = false
					setBodyCollide(ch, true) -- noclip desligado: agora eu controlo a plataforma como o Float
					helpBtn.face.Text = "lock in ajuda"
				end
			end

			-- constantemente debaixo do jogador, com a antecipação do atraso de rede
			local tv = vr.AssemblyLinearVelocity
			local lead = math.clamp(player:GetNetworkPing() * FOLLOW_PING_FACTOR + FOLLOW_LEAD, 0, 0.35)
			local ahead = Vector3.new(tv.X, 0, tv.Z) * lead
			if ahead.Magnitude > MAX_LEAD_STUDS then ahead = ahead.Unit * MAX_LEAD_STUDS end

			h.PlatformStand = false
			r.CFrame = CFrame.new(vr.Position.X + ahead.X, floatY + 3.5, vr.Position.Z + ahead.Z)
				* CFrame.Angles(0, lockYaw, 0)
			r.AssemblyLinearVelocity = Vector3.zero
			r.AssemblyAngularVelocity = Vector3.zero
		end)
	end

	helpBtn.face.Activated:Connect(function()
		if lockOn then lockStop() else lockStart() end
	end)
end

