-- ===== ARRASTAR A BOLINHA / CLICAR ABRE O MENU =====
local dragging, startPos, startInput, moved
bubble.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging, moved = true, false
		startPos, startInput = bubble.Position, input.Position
	end
end)
UIS.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		local d = input.Position - startInput
		if d.Magnitude > 6 then moved = true end
		bubble.Position = UDim2.fromOffset(startPos.X.Offset + d.X, startPos.Y.Offset + d.Y)
	end
end)
UIS.InputEnded:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch) then
		dragging = false
		if not moved then
			panel.Visible = not panel.Visible
			if not panel.Visible then list.Visible = false end
			bubble.Text = panel.Visible and "–" or "+"
		end
	end
end)
