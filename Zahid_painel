-- ===== ABRIR / FECHAR O PAINEL (com animação) =====
local closeTele
-- ===== TELECINESE (mini menu ao lado do menu principal) =====
-- Toque numa parte do mapa com o menu aberto para selecioná-la. Partes ancoradas são recusadas.
-- Rotacionar: gira 90° em torno do eixo vertical. Girar: gira a parte sem parar.
-- Controlar: move a parte com a câmera como referência (andar com o analógico/WASD, Q/E ou os botões
-- subir/descer do Float para cima e para baixo); a rotação que ela tem é mantida.
-- Velocidade: arraste a barra para escolher.
closeTele = function() end -- redefinido abaixo; o menu principal chama ao fechar
do
	local TELE_H = 226
	local SPEED_MIN, SPEED_MAX = 10, 200
	local SPIN_RATE = 3 -- rad/s do "girar"
	local RED = Color3.fromRGB(255, 110, 110)

	local teleOpen = false
	local tele = { part = nil, box = nil, spinOn = false, ctrlOn = false, bv = nil, bg = nil, rot = nil, speed = 60, dragging = false }
	local telePanel, teleStatus, teleBtn, teleSpinBtn, teleCtrlBtn, teleSpeedLabel, teleTrack, teleKnob

	local function teleSetStatus(text, color)
		teleStatus.Text = text
		teleStatus.TextColor3 = color or T.text
	end

	local function teleStopControl()
		tele.ctrlOn = false
		if tele.bv then tele.bv:Destroy() tele.bv = nil end
		if tele.bg then tele.bg:Destroy() tele.bg = nil end
		teleCtrlBtn.setOn(false)
	end

	local function teleStopSpin()
		tele.spinOn = false
		if tele.part and tele.part.Parent then tele.part.AssemblyAngularVelocity = Vector3.zero end
		teleSpinBtn.setOn(false)
	end

	local function teleClear()
		teleStopControl()
		teleStopSpin()
		if tele.box then tele.box:Destroy() tele.box = nil end
		tele.part = nil
	end

	local function teleSelect(part)
		-- ancorada = não dá para controlar (erro); não ancorada = seleciona
		if part.Anchored == true then
			teleSetStatus("Parte ancorada (" .. part.Name .. "). Não dá para controlar, escolha outra.", RED)
			return
		end
		teleClear()
		tele.part = part
		tele.box = Instance.new("SelectionBox")
		tele.box.Adornee = part
		tele.box.LineThickness = 0.05
		tele.box.Color3 = Color3.fromRGB(255, 80, 120)
		tele.box.Parent = workspace
		teleSetStatus("Selecionada: " .. part.Name .. " (não ancorada)")
	end

	local function teleRotate()
		local p = tele.part
		if not p then
			teleSetStatus("Selecione uma parte primeiro.", RED)
			return
		end
		p.CFrame = p.CFrame * CFrame.Angles(0, math.rad(90), 0)
		if tele.ctrlOn then tele.rot = p.CFrame.Rotation end
	end

	local function teleStartControl()
		local p = tele.part
		if not p then
			teleSetStatus("Selecione uma parte primeiro.", RED)
			return
		end
		teleStopSpin() -- girar e controlar não rodam juntos
		tele.rot = p.CFrame.Rotation -- a rotação que ela tem agora é a que eu controlo
		tele.bv = Instance.new("BodyVelocity")
		tele.bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		tele.bv.Velocity = Vector3.zero
		tele.bv.Parent = p
		tele.bg = Instance.new("BodyGyro")
		tele.bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
		tele.bg.P = 9e4
		tele.bg.CFrame = tele.rot
		tele.bg.Parent = p
		tele.ctrlOn = true
		teleCtrlBtn.setOn(true)
	end

	local function setSpeedFromX(x)
		local a = math.clamp((x - teleTrack.AbsolutePosition.X) / teleTrack.AbsoluteSize.X, 0, 1)
		tele.speed = math.floor(SPEED_MIN + a * (SPEED_MAX - SPEED_MIN) + 0.5)
		teleKnob.Position = UDim2.new(a, -8, 0.5, -8)
		teleSpeedLabel.Text = "Velocidade: " .. tele.speed
	end

