-- ===== ANTIFLING =====
local function antiFling(on)
	if conns.antifling then conns.antifling:Disconnect() conns.antifling = nil end
	if not on then return end
	conns.antifling = RunService.Stepped:Connect(function()
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p.Character then
				for _, part in ipairs(p.Character:GetDescendants()) do
					if part:IsA("BasePart") then part.CanCollide = false end
				end
			end
		end
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if hrp and (hrp.AssemblyLinearVelocity.Magnitude > 150
			or hrp.AssemblyAngularVelocity.Magnitude > 50) then
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end
	end)
end

-- ===== TPTOOL (clica no chão e teleporta) =====
local tpEnabled = false
local function giveTpTool()
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack or backpack:FindFirstChild("TPTool") then return end
	local tool = Instance.new("Tool")
	tool.Name = "TPTool"
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.Activated:Connect(function()
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local mouse = player:GetMouse()
		if hrp and mouse.Hit then
			hrp.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0))
		end
	end)
	tool.Parent = backpack
end

local function removeTpTool()
	local bp = player:FindFirstChildOfClass("Backpack")
	if bp and bp:FindFirstChild("TPTool") then bp.TPTool:Destroy() end
	if player.Character and player.Character:FindFirstChild("TPTool") then
		player.Character.TPTool:Destroy()
	end
end

local function tpTool(on)
	tpEnabled = on
	if on then giveTpTool() else removeTpTool() end
end

player.CharacterAdded:Connect(function()
	if tpEnabled then
		task.wait(0.5)
		giveTpTool()
	end
end)

-- ===== FLY / VFLY =====
local FLY_SPEED = 60

local function stopFlight(key)
	if conns[key] then conns[key]:Disconnect() conns[key] = nil end
	local s = flyState[key]
	if s then
		if s.bv then s.bv:Destroy() end
		if s.bg then s.bg:Destroy() end
		if s.hum and not s.needSeat then s.hum.PlatformStand = false end
		flyState[key] = nil
	end
end

local function startFlight(key, needSeat)
	stopFlight(key)
	flyState[key] = { needSeat = needSeat }
	conns[key] = RunService.Heartbeat:Connect(function()
		local s = flyState[key]
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not s or not hum then return end

		local part
		if needSeat then
			part = hum.SeatPart
		else
			part = char:FindFirstChild("HumanoidRootPart")
		end

		-- sem alvo (ex.: VFly fora do veículo): limpa e espera
		if not part then
			if s.bv then s.bv:Destroy() s.bv = nil end
			if s.bg then s.bg:Destroy() s.bg = nil end
			s.target = nil
			return
		end

		-- alvo novo: cria os controladores de voo
		if part ~= s.target then
			if s.bv then s.bv:Destroy() end
			if s.bg then s.bg:Destroy() end
			s.target, s.hum = part, hum
			s.bv = Instance.new("BodyVelocity")
			s.bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
			s.bv.Velocity = Vector3.zero
			s.bv.Parent = part
			s.bg = Instance.new("BodyGyro")
			s.bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
			s.bg.P = 9e4
			s.bg.Parent = part
			if not needSeat then hum.PlatformStand = true end
		end

		local cam = workspace.CurrentCamera
		local rel = cam.CFrame:VectorToObjectSpace(hum.MoveDirection)
		local dir = cam.CFrame.LookVector * (-rel.Z) + cam.CFrame.RightVector * rel.X
		if UIS:IsKeyDown(Enum.KeyCode.Space) or UIS:IsKeyDown(Enum.KeyCode.E) then
			dir += Vector3.new(0, 1, 0)
		end
		if UIS:IsKeyDown(Enum.KeyCode.Q) then
			dir -= Vector3.new(0, 1, 0)
		end

		s.bv.Velocity = dir * FLY_SPEED
		s.bg.CFrame = cam.CFrame
	end)
end

local function fly(on)
	if on then startFlight("fly", false) else stopFlight("fly") end
end

local function vfly(on)
	if on then startFlight("vfly", true) else stopFlight("vfly") end
end

-- ===== FLOAT (plataforma invisível sob os pés; Q desce / E sobe) =====
local FLOAT_SPEED = 20
local floatPart, floatY
local floatUp, floatDown = false, false

local function floatToggle(on)
	if conns.float then conns.float:Disconnect() conns.float = nil end
	if floatPart then floatPart:Destroy() floatPart = nil end
	floatUp, floatDown = false, false
	if not on then return end

	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	floatPart = Instance.new("Part")
	floatPart.Name = "FloatPlatform"
	floatPart.Size = Vector3.new(6, 1, 6)
	floatPart.Anchored = true
	floatPart.CanCollide = true
	floatPart.CanQuery = false
	floatPart.Transparency = 1
	floatPart.Parent = workspace

	floatY = hrp.Position.Y - 3.5 -- topo da plataforma na altura dos pés

	conns.float = RunService.Heartbeat:Connect(function(dt)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root or not floatPart then return end

		local dy = 0
		if floatUp or UIS:IsKeyDown(Enum.KeyCode.E) then dy += 1 end
		if floatDown or UIS:IsKeyDown(Enum.KeyCode.Q) then dy -= 1 end
		floatY += dy * FLOAT_SPEED * dt

		floatPart.CFrame = CFrame.new(root.Position.X, floatY, root.Position.Z)
	end)
end

