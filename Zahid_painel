		end
	end)
	UIS.InputChanged:Connect(function(input)
		if not viewDrag then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or (input.UserInputType == Enum.UserInputType.Touch and input == viewDrag) then
			local d = input.Position - viewLast
			viewLast = input.Position
			yaw -= d.X * 0.012
			pitch = math.clamp(pitch + d.Y * 0.008, -0.8, 0.8)
			updateCam()
		end
	end)
	UIS.InputEnded:Connect(function(input)
