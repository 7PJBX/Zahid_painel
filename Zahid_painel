-- animação (1,6 s): o coração treme e a tela escurece > racha (💔) com um anel de luz e
-- estilhaços > renasce preto (🖤) > vira a versão dark
local function playHeartToBlack(onSwitch)
	-- fecha o menu, se estiver aberto
	if panelOpen then setPanel(false) end

	-- centro do coração (mesmo espaço de coordenadas da interface do menu)
	local cx = bubble.Position.X.Offset + 24
	local cy = bubble.Position.Y.Offset + 24

	-- a tela escurece atrás do menu
	local fx = Instance.new("ScreenGui")
	fx.Name = "HeartSwitchFx"
	fx.IgnoreGuiInset = true
	fx.ResetOnSpawn = false
	fx.DisplayOrder = -1
	fx.Parent = player:WaitForChild("PlayerGui")

	local shade = Instance.new("Frame")
	shade.Size = UDim2.fromScale(1, 1)
	shade.BackgroundColor3 = Color3.new(0, 0, 0)
	shade.BackgroundTransparency = 1
	shade.BorderSizePixel = 0
	shade.Parent = fx

	local function newEmoji(emoji, size)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Text = emoji
		l.Font = Enum.Font.GothamMedium
		l.TextSize = size
		l.Size = UDim2.fromOffset(size + 10, size + 10)
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.Position = UDim2.fromOffset(cx, cy)
		l.ZIndex = 5
		l.Parent = gui
		return l
	end

	-- estilhaços: pequenos emojis que saem do coração, giram e somem
	local function burst(emoji, count, minDist, maxDist, size, time)
		for _ = 1, count do
			local l = newEmoji(emoji, size)
			local a = math.random() * math.pi * 2
			local d = math.random(minDist, maxDist)
			l.Rotation = math.random(-40, 40)
			tween(l, time, {
				Position = UDim2.fromOffset(cx + math.cos(a) * d, cy + math.sin(a) * d),
				Rotation = l.Rotation + math.random(-260, 260),
			}, Enum.EasingStyle.Quint)
			task.delay(time * 0.4, function()
				tween(l, time * 0.6, { TextTransparency = 1 }, Enum.EasingStyle.Linear)
			end)
			task.delay(time + 0.05, function() l:Destroy() end)
		end
	end

	-- anel de luz que se expande
	local function ring()
		local r = Instance.new("Frame")
		r.AnchorPoint = Vector2.new(0.5, 0.5)
		r.Position = UDim2.fromOffset(cx, cy)
		r.Size = UDim2.fromOffset(10, 10)
		r.BackgroundTransparency = 1
		r.ZIndex = 4
		r.Parent = gui
		Instance.new("UICorner", r).CornerRadius = UDim.new(1, 0)
		local s = Instance.new("UIStroke")
		s.Color = Color3.fromRGB(255, 255, 255)
		s.Thickness = 3
		s.Parent = r
		tween(r, 0.45, { Size = UDim2.fromOffset(260, 260) }, Enum.EasingStyle.Quint)
		tween(s, 0.45, { Transparency = 1 })
		task.delay(0.5, function() r:Destroy() end)
	end

	-- 1) o coração bate rápido e treme cada vez mais, enquanto a tela escurece (0,55 s)
	local SHAKE = 0.55
	tween(bubbleScale, SHAKE, { Scale = 1.4 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(shade, SHAKE, { BackgroundTransparency = 0.65 })
	local t0 = os.clock()
	while os.clock() - t0 < SHAKE do
		local k = (os.clock() - t0) / SHAKE
		local amp = 1 + k * 8
		bubble.Rotation = (math.random() * 2 - 1) * amp
		RunService.RenderStepped:Wait()
	end
	bubble.Rotation = 0

	-- 2) racha: vira 💔, com um anel de luz e estilhaços vermelhos (0,3 s)
	bubble.Text = "💔"
	ring()
	burst("❤️", 10, 60, 140, 22, 0.7)
	tween(bubbleScale, 0.12, { Scale = 0.85 })
	task.wait(0.3)

	-- 3) renasce preto: o 🖤 aparece com um pop (0,35 s)
	bubble.Text = "🖤"
	bubbleScale.Scale = 0.5
	tween(bubbleScale, 0.35, { Scale = 1.15 }, Enum.EasingStyle.Back)
	tween(shade, 0.25, { BackgroundTransparency = 0.4 })
	burst("🖤", 6, 50, 110, 20, 0.6)
	task.wait(0.35)

	-- 4) vira a versão dark: o coração vira o retângulo "Zahid painel" (0,4 s)
	onSwitch()
	bubbleScale.Scale = 0.6
	tween(bubbleScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	tween(shade, 0.4, { BackgroundTransparency = 1 })
	task.wait(0.4)
	fx:Destroy()
end

-- ===== ARRASTAR O BOTÃO / CLICAR ABRE O MENU =====
local dragging, startPos, startInput, moved
local holdToken = 0
bubble.InputBegan:Connect(function(input)
	if isPress(input) then
		dragging, moved = true, false
		startPos, startInput = bubble.Position, input.Position

		-- segurar o coração vermelho por 1 segundo: ele vira preto e abre a versão dark
		holdToken += 1
		local token = holdToken
		if IS_ROMANTIC then
			task.delay(HOLD_TIME, function()
				if token == holdToken and dragging and not moved and IS_ROMANTIC and not themeSwitching then
					dragging = false -- ao soltar, não abre nem fecha o menu
					themeSwitching = true
					playHeartToBlack(applyDarkTheme)
					themeSwitching = false
				end
			end)
		end
	end
end)
UIS.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		local d = input.Position - startInput
		if d.Magnitude > 6 then moved = true end
		bubble.Position = UDim2.fromOffset(startPos.X.Offset + d.X, startPos.Y.Offset + d.Y)
	end
end)
UIS.InputEnded:Connect(function(input)
	if dragging and isPress(input) then
		dragging = false
		if not moved then
			setPanel(not panelOpen)
		end
	end
end)

-- ===== BOTÃO INICIAR (coração com a frase) =====
local function showStartButton()
	local startGui = Instance.new("ScreenGui")
	startGui.Name = "StartGui"
	startGui.IgnoreGuiInset = true
	startGui.ResetOnSpawn = false
	startGui.DisplayOrder = 100
	startGui.Parent = player:WaitForChild("PlayerGui")

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.fromOffset(110, 110)
	btn.AnchorPoint = Vector2.new(0.5, 0.5)
	btn.Position = UDim2.fromScale(0.5, 0.5)
	btn.BackgroundTransparency = 1
	btn.Text = ""
	btn.Parent = startGui

	local sc = Instance.new("UIScale")
	sc.Scale = 0.02
	sc.Parent = btn

	-- o coração
	local heart = Instance.new("TextLabel")
	heart.Size = UDim2.fromScale(1, 1)
	heart.BackgroundTransparency = 1
	heart.Text = "❤️"
	heart.Font = Enum.Font.GothamMedium
	heart.TextSize = 100
	heart.Parent = btn

	-- a frase por cima do coração (texto separado, por isso aceita outra fonte)
	local phrase = Instance.new("TextLabel")
	phrase.Size = UDim2.fromScale(0.7, 0.4)
	phrase.AnchorPoint = Vector2.new(0.5, 0.5)
	phrase.Position = UDim2.fromScale(0.5, 0.43) -- 0.5 = centro; menor = mais para cima
	phrase.BackgroundTransparency = 1
	phrase.Text = "te amo\nmi amore"
	phrase.Font = ROMANTIC_FONT
	phrase.TextScaled = true
	phrase.TextColor3 = Color3.new(1, 1, 1)
	phrase.TextStrokeColor3 = Color3.fromRGB(120, 0, 40)
	phrase.TextStrokeTransparency = 0.4
	phrase.Parent = btn

	-- aparece com um pop e fica "batendo" como um coração
	tween(sc, 0.5, { Scale = 1 }, Enum.EasingStyle.Back).Completed:Wait()
	local pulse = TweenService:Create(
		sc,
		TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Scale = 1.1 }
	)
	pulse:Play()

	-- espera o clique
	btn.Activated:Wait()
	pulse:Cancel()

	-- pop: cresce um pouco, fica minúsculo e some
	tween(sc, 0.15, { Scale = 1.3 }).Completed:Wait()
	tween(sc, 0.35, { Scale = 0.02 }, Enum.EasingStyle.Back, Enum.EasingDirection.In).Completed:Wait()
	startGui:Destroy()
end

-- ===== INICIA =====
-- dark: o botão aparece direto, com uma animação.
-- romântica: botão do coração, depois a intro do beijo, depois o coração do menu.
local function showBubble()
	bubble.Visible = true
	bubbleScale.Scale = 0.01
	tween(bubbleScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
end

if IS_ROMANTIC then
	task.spawn(function()
		showStartButton() -- espera o clique no coração
		playIntro(showBubble)
	end)
else
	showBubble()
end
