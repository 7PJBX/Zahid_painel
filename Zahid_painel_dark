local COLOR_OFF = Color3.fromRGB(34, 34, 40)           -- botão desligado
local COLOR_ON = Color3.fromRGB(40, 150, 85)           -- botão ligado
local COLOR_TP = Color3.fromRGB(42, 58, 100)           -- botão de teleporte
local COLOR_PANEL_TOP = Color3.fromRGB(12, 12, 15)     -- fundo do painel (topo)
local COLOR_PANEL_BOTTOM = Color3.fromRGB(24, 24, 29)  -- fundo do painel (base)
local COLOR_TEXT = Color3.fromRGB(225, 225, 232)       -- texto claro
local COLOR_STROKE = Color3.fromRGB(75, 75, 88)        -- contornos cinza
local COLOR_BUBBLE = Color3.fromRGB(18, 18, 22)        -- bolinha com o menu fechado
local COLOR_BUBBLE_OPEN = Color3.fromRGB(44, 44, 52)   -- bolinha com o menu aberto
local FONT = Enum.Font.GothamMedium                    -- fonte limpa

local function styleText(obj, size)
	obj.Font = FONT
	obj.TextColor3 = COLOR_TEXT
	obj.TextSize = size
end

local function addStroke(obj, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Color = COLOR_STROKE
	s.Thickness = thickness
	s.Transparency = transparency
	s.Parent = obj
end

local function addGradient(obj)
	obj.BackgroundColor3 = Color3.new(1, 1, 1)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(COLOR_PANEL_TOP, COLOR_PANEL_BOTTOM)
	g.Rotation = 90
	g.Parent = obj
end

-- ===== ANIMAÇÃO: FUNÇÕES AUXILIARES =====
local function tween(obj, time, props, style, dir)
	local t = TweenService:Create(
		obj,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

-- efeito de "apertar" o botão
local function addPress(btn)
	local sc = Instance.new("UIScale")
	sc.Parent = btn
	btn.InputBegan:Connect(function(input)
		if isPress(input) then tween(sc, 0.08, { Scale = 0.92 }) end
	end)
	btn.InputEnded:Connect(function(input)
		if isPress(input) then tween(sc, 0.2, { Scale = 1 }, Enum.EasingStyle.Back) end
	end)
end

