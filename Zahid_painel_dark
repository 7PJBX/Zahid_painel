	b.Size = UDim2.fromOffset(halfW, ROW_H)
	b.Position = UDim2.fromOffset(x, rowY(ROW_QE))
	b.BackgroundColor3 = COLOR_OFF
	styleText(b, 16)
	b.TextScaled = true -- o texto se ajusta ao botão mais estreito
	local limit = Instance.new("UITextSizeConstraint")
	limit.MaxTextSize = 16
	limit.Parent = b
	b.Text = text
	b.Parent = content
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)
	addStroke(b, 1.5, 0.5)
	addPress(b)

	b.InputBegan:Connect(function(input)
		if isPress(input) then
			setter(true)
			tween(b, 0.1, { BackgroundColor3 = COLOR_ON })
		end
	end)
	b.InputEnded:Connect(function(input)
		if isPress(input) then
			setter(false)
			tween(b, 0.2, { BackgroundColor3 = COLOR_OFF })
		end
	end)
