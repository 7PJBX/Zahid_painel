local function refreshList()
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("TextButton") then c:Destroy() end
	end
	local found, n = false, 0
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			if p == selectedPlayer then found = true end
			n += 1
			local b = Instance.new("TextButton")
			b.Size = UDim2.new(1, 0, 0, 28)
			b.BackgroundColor3 = COLOR_OFF
			styleText(b, 14)
			b.TextTruncate = Enum.TextTruncate.AtEnd
			b.Text = p.DisplayName .. " (@" .. p.Name .. ")"
			b.BackgroundTransparency = 1
			b.TextTransparency = 1
			b.Parent = list
			Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
			addPress(b)

			-- cada item aparece com um pequeno atraso
			task.delay((n - 1) * 0.04, function()
				if b.Parent then
					tween(b, 0.25, { BackgroundTransparency = 0, TextTransparency = 0 })
				end
			end)

			b.Activated:Connect(function()
				selectedPlayer = p
				selectBtn.Text = p.DisplayName
				updateTpText()
				setList(false)
			end)
		end
	end
	if selectedPlayer and not found then
		selectedPlayer = nil
		selectBtn.Text = "Selecionar jogador"
		updateTpText()
	end
end

setList = function(open)
	listOpen = open
	if open then
		refreshList()
		-- abre à direita; se não couber na tela, abre à esquerda
		local screenW = gui.AbsoluteSize.X
		if bubble.AbsolutePosition.X + PANEL_W + 6 + LIST_W > screenW then
			list.Position = UDim2.fromOffset(-LIST_W - 6, LIST_Y)
		else
			list.Position = UDim2.fromOffset(PANEL_W + 6, LIST_Y)
		end
		list.Visible = true
		listScale.Scale = 0.7
		tween(listScale, 0.28, { Scale = 1 }, Enum.EasingStyle.Back)
	else
		local t = tween(listScale, 0.12, { Scale = 0.7 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		t.Completed:Connect(function()
			if not listOpen then list.Visible = false end
		end)
	end
end

