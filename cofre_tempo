-- ===== FUNÇÕES AUXILIARES =====
local function tween(obj, time, props, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function nowTs()
	return DateTime.now().UnixTimestamp
end

-- data e hora no horário do aparelho: 18/10/2026 14:32:07
local function fmtDate(ts)
	local ok, s = pcall(function()
		return DateTime.fromUnixTimestamp(ts):FormatLocalTime("DD/MM/YYYY HH:mm:ss", "pt-br")
	end)
	if ok then return s end
	return os.date("!%d/%m/%Y %H:%M:%S", ts) .. " UTC"
end

-- contagem regressiva: 07:59:12 ou 6d 23:59:59
local function fmtRemaining(sec)
	local d = math.floor(sec / 86400)
	local h = math.floor((sec % 86400) / 3600)
	local m = math.floor((sec % 3600) / 60)
	local s = math.floor(sec % 60)
	if d > 0 then return string.format("%dd %02d:%02d:%02d", d, h, m, s) end
	return string.format("%02d:%02d:%02d", h, m, s)
end

local function trim(s)
	return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

-- copia para a área de transferência (só se o executor tiver a função)
local function copyText(s)
	local fn = setclipboard or toclipboard or writeclipboard
	if fn then
		return (pcall(fn, s))
	end
	return false
end

-- troca o texto de um botão por um instante e depois devolve o original
local function flashText(face, text, color)
	local old, oldColor = face.Text, face.TextColor3
	face.Text = text
	face.TextColor3 = color or T.text
	task.delay(1.3, function()
		if face.Parent and face.Text == text then
			face.Text = old
			face.TextColor3 = oldColor
		end
	end)
end

-- ===== BOTÃO 3D (igual ao do menu Zahid) =====
-- dois retângulos arredondados: o corpo (escuro) fica parado e a face (clara) desce por cima dele ao apertar
local DEPTH = 4
local pressedFaces = {}

-- ao soltar o dedo/mouse em qualquer lugar, todas as faces apertadas voltam para cima
UIS.InputEnded:Connect(function(input)
	if not isPress(input) then return end
	for face in pairs(pressedFaces) do
		pressedFaces[face] = nil
		tween(face, 0.14, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
	end
end)

local function new3DButton(parent, text, position, size, faceColor, baseColor)
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Position = position
	holder.Size = size
	holder.Parent = parent

	local faceH = size.Y.Offset - DEPTH

	local base = Instance.new("Frame")
	base.Size = UDim2.new(1, 0, 0, faceH)
	base.Position = UDim2.fromOffset(0, DEPTH)
	base.BackgroundColor3 = baseColor
	base.BorderSizePixel = 0
	base.Parent = holder
	Instance.new("UICorner", base).CornerRadius = UDim.new(0, 10)

	local face = Instance.new("TextButton")
	face.Size = UDim2.new(1, 0, 0, faceH)
	face.Position = UDim2.fromOffset(0, 0)
	face.BackgroundColor3 = faceColor
	face.BorderSizePixel = 0
	face.AutoButtonColor = false
	face.Font = T.font
	face.TextColor3 = T.text
	face.TextSize = 15
	face.TextTruncate = Enum.TextTruncate.AtEnd
	face.Text = text
	face.Parent = holder
	Instance.new("UICorner", face).CornerRadius = UDim.new(0, 10)

	face.InputBegan:Connect(function(input)
		if isPress(input) then
			pressedFaces[face] = true
			tween(face, 0.06, { Position = UDim2.fromOffset(0, DEPTH) })
		end
	end)

	local obj = { holder = holder, base = base, face = face }

	function obj.setColors(faceCol, baseCol, textCol)
		tween(face, 0.2, { BackgroundColor3 = faceCol, TextColor3 = textCol })
		tween(base, 0.2, { BackgroundColor3 = baseCol })
	end

	return obj
end

-- ===== DADOS (guardados em arquivo para sobreviver ao fechar o jogo) =====
local FILE = "CofreDoTempo_" .. player.UserId .. ".json"
local canFile = (writefile and readfile and isfile) and true or false
local entries = {}
local nextId = 1

local function persist()
	if not canFile then return end
	pcall(function() writefile(FILE, HttpService:JSONEncode(entries)) end)
end

if canFile then
	local ok, data = pcall(function()
		if not isfile(FILE) then return nil end
		return HttpService:JSONDecode(readfile(FILE))
	end)
	if ok and type(data) == "table" then
		for _, e in ipairs(data) do
			if type(e) == "table" and type(e.title) == "string" and type(e.info) == "string"
				and type(e.savedAt) == "number" and type(e.seconds) == "number" then
				e.id = type(e.id) == "number" and e.id or nextId
				e.label = type(e.label) == "string" and e.label or ""
				e.redeemed = e.redeemed == true
				table.insert(entries, e)
				nextId = math.max(nextId, e.id + 1)
			end
		end
	end
end

