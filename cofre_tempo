local function label(parent, text, size, color, order, height, alignX)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, 0, 0, height)
	l.BackgroundTransparency = 1
	l.Font = T.font
	l.TextSize = size
	l.TextColor3 = color
	l.TextXAlignment = alignX or Enum.TextXAlignment.Left
	l.TextTruncate = Enum.TextTruncate.AtEnd
	l.Text = text
	l.LayoutOrder = order
	l.Parent = parent
	return l
end

local function addCard(entry)
	local card = Instance.new("Frame")
	card.Size = UDim2.new(1, 0, 0, 0)
	card.AutomaticSize = Enum.AutomaticSize.Y
	card.BackgroundColor3 = T.card
	card.BorderSizePixel = 0
	card.LayoutOrder = -entry.id -- o mais novo fica no topo
	card.Parent = listFrame
	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 12)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.PaddingTop = UDim.new(0, 8)
	pad.PaddingBottom = UDim.new(0, 8)
	pad.Parent = card
	local lay = Instance.new("UIListLayout")
	lay.Padding = UDim.new(0, 5)
	lay.SortOrder = Enum.SortOrder.LayoutOrder
	lay.Parent = card

	-- linha 1: título (esquerda) + contagem regressiva (direita)
	local top = Instance.new("Frame")
	top.Size = UDim2.new(1, 0, 0, 22)
	top.BackgroundTransparency = 1
	top.LayoutOrder = 1
	top.Parent = card
	local titleLabel = label(top, entry.title, 16, T.text, 1, 22)
	titleLabel.Size = UDim2.new(1, -100, 1, 0)
	local countdown = label(top, "", 14, T.textDim, 2, 22, Enum.TextXAlignment.Right)
	countdown.Size = UDim2.new(0, 96, 1, 0)
	countdown.Position = UDim2.new(1, -96, 0, 0)

	-- linha 2: asteriscos (trancado) ou a informação (depois de resgatar)
	local locked = label(card, "************", 20, T.text, 2, 22)
	local reveal = newBox(90, "", true)
	reveal.LayoutOrder = 3
	reveal.Visible = false
	reveal.Parent = card
	reveal.FocusLost:Connect(function() reveal.Text = entry.info end) -- só para selecionar/copiar, não editar

	-- linha 3: data e hora do salvamento + tempo escolhido
	label(card, "Salvo em " .. fmtDate(entry.savedAt) .. "  |  " .. entry.label, 12, T.textDim, 4, 16)

	-- linha 4: botões
	local btnRow = Instance.new("Frame")
	btnRow.Size = UDim2.new(1, 0, 0, 36)
	btnRow.BackgroundTransparency = 1
	btnRow.LayoutOrder = 5
	btnRow.Parent = card
	local redeemBtn = new3DButton(btnRow, "resgatar", UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, 36), T.faceLock, T.baseLock)
	local copyBtn = new3DButton(btnRow, "copiar", UDim2.fromOffset(0, 0), UDim2.new(0.5, -4, 0, 36), T.faceNet, T.baseNet)
	local deleteBtn = new3DButton(btnRow, "apagar", UDim2.new(0.5, 4, 0, 0), UDim2.new(0.5, -4, 0, 36), T.faceOff, T.baseOff)
	copyBtn.holder.Visible = false
	deleteBtn.holder.Visible = false

	local rec = { entry = entry }
	local ready = nil -- true quando o tempo acabou (para só trocar a cor quando mudar)

	local function showRevealed()
		locked.Visible = false
		reveal.Text = entry.info
		reveal.Visible = true
		redeemBtn.holder.Visible = false
		copyBtn.holder.Visible = true
		deleteBtn.holder.Visible = true
		countdown.Text = "Resgatado"
		countdown.TextColor3 = T.green
	end

	function rec.update()
		if entry.redeemed then return end
		local remaining = entry.savedAt + entry.seconds - nowTs()
		if remaining > 0 then
			countdown.Text = fmtRemaining(remaining)
			if ready ~= false then
				ready = false
				redeemBtn.setColors(T.faceLock, T.baseLock, T.textDim)
			end
		else
			countdown.Text = "Liberado!"
			countdown.TextColor3 = T.green
			if ready ~= true then
				ready = true
				redeemBtn.setColors(T.faceNet, T.baseNet, T.text)
			end
		end
	end

	function rec.destroy()
		card:Destroy()
	end

	redeemBtn.face.Activated:Connect(function()
		if entry.redeemed then return end
		if nowTs() < entry.savedAt + entry.seconds then
			flashText(redeemBtn.face, "ainda trancado", T.red) -- só resgata quando o tempo acabar
			return
		end
		entry.redeemed = true
		persist()
		showRevealed()
		if copyText(entry.info) then flashText(copyBtn.face, "copiado!", T.green) end
	end)

	copyBtn.face.Activated:Connect(function()
		if copyText(entry.info) then
			flashText(copyBtn.face, "copiado!", T.green)
		else
			flashText(copyBtn.face, "sem copiar", T.red) -- selecione o texto acima para copiar
		end
	end)

	deleteBtn.face.Activated:Connect(function()
		for i, e in ipairs(entries) do
			if e == entry then
				table.remove(entries, i)
				break
			end
		end
		for i, c in ipairs(cards) do
			if c == rec then
				table.remove(cards, i)
				break
			end
		end
		persist()
		rec.destroy()
		refreshHeader()
	end)

	if entry.redeemed then showRevealed() else rec.update() end
	table.insert(cards, rec)
end

for _, e in ipairs(entries) do addCard(e) end
refreshHeader()

-- ===== SALVAR =====
saveBtn.face.Activated:Connect(function()
	local title = trim(titleBox.Text)
	local info = infoBox.Text
	if title == "" then
		flashText(saveBtn.face, "falta o título", T.red)
		return
	end
	if trim(info) == "" then
		flashText(saveBtn.face, "falta a informação", T.red)
		return
	end

	local d = DURATIONS[durIndex]
	local entry = {
		id = nextId,
		title = title,
		info = info,
		savedAt = nowTs(), -- data, hora, minutos e segundos exatos do clique
		seconds = d.seconds,
		label = d.label,
		redeemed = false,
	}
	nextId += 1
	table.insert(entries, entry)
	persist()
	addCard(entry)
	refreshHeader()

	titleBox.Text = ""
	infoBox.Text = ""
	flashText(saveBtn.face, "salvo!", T.green)
end)

-- ===== CONTAGEM REGRESSIVA (atualiza todos os cartões a cada segundo) =====
task.spawn(function()
	while gui.Parent do
		for _, rec in ipairs(cards) do rec.update() end
		task.wait(1)
	end
end)
